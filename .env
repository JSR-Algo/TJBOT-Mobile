# Leave TBOT_API_URL/TBOT_AI_URL empty to auto-derive the dev backend host
# from the Metro bundle URL on physical devices (covers LAN/hotspot/cafe-WiFi
# without per-network edits). Set explicitly to override (e.g. staging URL).
# See src/config.ts::getApiBaseUrl resolution order.
TBOT_API_URL=http://localhost:3000
TBOT_AI_URL=https://tbot-backend-8wmh.onrender.com/api/ai
EXPO_PUBLIC_VOICE_FORCE_NATIVE_IOS=true
EXPO_PUBLIC_VOICE_TEST_HARNESS=false
EXPO_PUBLIC_FEATURE_ZERO_CODE_CLAIM=true