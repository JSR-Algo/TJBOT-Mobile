# TBOT Mobile — Local Development Environment
#
# Default behavior (recommended): leave TBOT_API_URL and TBOT_AI_URL empty.
# On a real device in __DEV__, src/config.ts auto-derives the dev backend
# host from the Metro bundle URL — no manual IP needed when your LAN IP
# changes (DHCP, hotspot, café WiFi).
#
# Set these only when overriding the default (e.g. testing against staging,
# or when your dev backend runs on a non-default host/port).
#
#   TBOT_API_URL=https://staging.tbot.app
#   TBOT_AI_URL=https://staging.tbot.app/api/ai
#
# A literal http://localhost:3000 here is treated as "user forgot to override"
# and is replaced by the auto-derive path on real devices.

TBOT_API_URL=
TBOT_AI_URL=

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Voice debug — set to 'true' to force iOS to use the native VoiceMicModule
# instead of the RNLAS fallback. Used for diagnosing the on-device "mic
# auto-turns-off" issue. Default off. See
# docs/qa/ad-hoc/2026-04-23-ios-mic-auto-off-diagnostics.md.
EXPO_PUBLIC_VOICE_FORCE_NATIVE_IOS=

# Legacy (kept for compatibility)
API_URL=http://192.168.x.x:3000/v1
WS_URL=ws://192.168.x.x:3000
