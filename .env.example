# TBOT Mobile — Local Development Environment
#
# Default behavior: EXPO_PUBLIC_* values are embedded in the JS bundle by
# Metro. Local development uses localhost defaults; src/config.ts treats a
# literal http://localhost:3000 as "use the auto-derived LAN host" on real
# devices in __DEV__, and falls back to simulator/emulator loopbacks otherwise.

# REST API root (should end in /v1)
EXPO_PUBLIC_TBOT_API_URL=http://localhost:3000

# AI proxy root (local AI service default)
EXPO_PUBLIC_TBOT_AI_URL=http://localhost:3001/api/ai

# Realtime observer WebSocket root
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Voice debug — set to 'true' to force iOS to use the native VoiceMicModule
# instead of the RNLAS fallback. Default off. See
# docs/qa/ad-hoc/2026-04-23-ios-mic-auto-off-diagnostics.md.
EXPO_PUBLIC_VOICE_FORCE_NATIVE_IOS=

# QA/test harness — only set to 'true' when running explicit QA tooling.
# Enables the voice-telemetry POST to /v1/qa/voice-events and native PCM
# recording paths. Must stay off in production and child-facing builds.
EXPO_PUBLIC_VOICE_TEST_HARNESS=false

# Tap-to-interrupt budget (ms). If the user taps to interrupt but does not
# speak within this window, the hook closes the WS to cancel server generation.
EXPO_PUBLIC_VOICE_BARGE_IN_BUDGET_MS=

# Retry an unacknowledged barge-in after this timeout.
EXPO_PUBLIC_VOICE_CANCEL_UNACK_RECOVERY=

# Gemini Live model override (optional)
EXPO_PUBLIC_GEMINI_LIVE_MODEL=

# COPPA consent bypass token (dev-only). Leave empty in production builds.
# When set in __DEV__, sent as stripe_token to /auth/consent for staging backends.
EXPO_PUBLIC_COPPA_BYPASS_TOKEN=

# ESP-IDF BLE provisioning (device pairing)
# EXPO_PUBLIC_ESP_DEVICE_PREFIX=PROV_
# EXPO_PUBLIC_ESP_SECURITY=secure2
# Do NOT set a global EXPO_PUBLIC_ESP_POP here. Proof-of-possession must come
# from the per-device pairing code only.
