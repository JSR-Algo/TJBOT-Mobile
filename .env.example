# TBOT Mobile — Local Development Environment
#
# Default behavior: EXPO_PUBLIC_* values are embedded in the JS bundle by
# Metro. Simulator, emulator, and physical-device builds share the hosted Linux
# backend. To run against a local service, explicitly replace these URLs.

# REST API root (should end in /v1)
EXPO_PUBLIC_TBOT_API_URL=https://report.tjbot.vn/v1

# Remote Metro dev (physical iPad over the internet via Cloudflare tunnel)
# Mac publisher + owned backend registry — iPad reads GET /v1/dev/metro-session
# and caches the last bundler host in SecureStore for the next cold launch.
# Hosted owned backend: https://report.tjbot.vn/v1
# Local override: http://localhost:3000/v1 (run `backend/` on the Mac)
# TBOT_DEV_REGISTRY_URL=http://localhost:3000/v1
# TBOT_DEV_SESSION_TOKEN=choose-a-dev-only-secret
# Dev-only: skip onboarding and open Home Hub for investor demo rehearsals.
EXPO_PUBLIC_INVESTOR_DEMO=false

# AI proxy root
EXPO_PUBLIC_TBOT_AI_URL=https://report.tjbot.vn/v1/ai

# Realtime observer WebSocket root
EXPO_PUBLIC_WS_URL=wss://report.tjbot.vn

# Observability (optional)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Voice debug — set to 'true' to force iOS to use the native VoiceMicModule
# instead of the RNLAS fallback. Default off. See
# docs/qa/ad-hoc/2026-04-23-ios-mic-auto-off-diagnostics.md.
EXPO_PUBLIC_VOICE_FORCE_NATIVE_IOS=

# QA/test harness — only set to 'true' when running explicit QA tooling.
# Enables the voice-telemetry POST to /v1/qa/voice-events and native PCM
# recording paths. Must stay off in production and child-facing builds.
EXPO_PUBLIC_VOICE_TEST_HARNESS=false

# Tap-to-interrupt budget (ms). If the user taps to interrupt but does not
# speak within this window, the hook closes the WS to cancel server generation.
EXPO_PUBLIC_VOICE_BARGE_IN_BUDGET_MS=

# Retry an unacknowledged barge-in after this timeout.
EXPO_PUBLIC_VOICE_CANCEL_UNACK_RECOVERY=

# Gemini Live model override (optional)
EXPO_PUBLIC_GEMINI_LIVE_MODEL=

# Demo / iPad investor build — local Gemini key (gitignored via .env).
# When set, Robot voice lessons use this key directly and skip the hosted proxy.
# Create a NEW key in Google AI Studio; never commit it. Demo builds only.
EXPO_PUBLIC_GEMINI_DEMO_API_KEY=

# COPPA consent bypass token (dev-only). Leave empty in production builds.
# When set in __DEV__, sent as stripe_token to /auth/consent for staging backends.
EXPO_PUBLIC_COPPA_BYPASS_TOKEN=

# ESP-IDF BLE provisioning (device pairing)
# EXPO_PUBLIC_ESP_DEVICE_PREFIX=PROV_
# EXPO_PUBLIC_ESP_SECURITY=secure2
# Do NOT set a global EXPO_PUBLIC_ESP_POP here. Proof-of-possession must come
# from the per-device pairing code only.

# ───────────────────────────────────────────────────────────────────────────
# TEMPORARY diagnostics → direct-to-Telegram (REMOVE BEFORE PRODUCTION).
# Mirrors every warn+error diagnostic entry DIRECTLY to a Telegram chat,
# bypassing the app backend, so failures the backend relay can't report
# (backend unreachable, request timeout, DNS/TLS, offline) still surface the
# exact cause on-device. No-op unless the flag is '1' AND token + chat id set.
# This is a debugging aid only — delete before shipping. Full removal checklist:
# docs/TEMP-DIAGNOSTICS-REMOVAL.md
EXPO_PUBLIC_DIAG_DIRECT_TO_TELEGRAM=0
EXPO_PUBLIC_DIAG_TELEGRAM_BOT_TOKEN=
EXPO_PUBLIC_DIAG_TELEGRAM_CHAT_ID=
