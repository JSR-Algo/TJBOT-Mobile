# Copy to keystore.properties (gitignored) before producing release builds.
# Generate the upload keystore once per release identity:
#   keytool -genkeypair -v -keystore TJBot-upload.keystore -alias TJBot-upload \
#           -keyalg RSA -keysize 2048 -validity 36500
# Then fill in the values below.

MYAPP_UPLOAD_STORE_FILE=TJBot-upload.keystore
MYAPP_UPLOAD_KEY_ALIAS=TJBot-upload
MYAPP_UPLOAD_STORE_PASSWORD=
MYAPP_UPLOAD_KEY_PASSWORD=
