{
  "name": "TJBotMobile",
  "displayName": "TJBot",
  "expo": {
    "name": "TJBotMobile",
    "slug": "TJBot-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "tjbots",
    "plugins": [
      "expo-notifications",
      "expo-video"
    ],
    "ios": {
      "bundleIdentifier": "net.jasonle.tjbot",
      "buildNumber": "26",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TJBot uses the microphone to listen to your child's voice and provide AI-powered responses.",
        "NSCameraUsageDescription": "TJBot uses the camera to scan setup codes when pairing your child's device.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.TJBot.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E4AAA"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ca5f22ec-28d9-4f18-80eb-a357a6d03070"
      }
    },
    "owner": "hellojason2",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/ca5f22ec-28d9-4f18-80eb-a357a6d03070",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
