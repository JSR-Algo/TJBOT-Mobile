{
  "name": "TJBotMobile",
  "displayName": "TJBot",
  "expo": {
    "name": "TJBotMobile",
    "slug": "TJBot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tjbots",
    "plugins": [
      "expo-notifications",
      "expo-video"
    ],
    "ios": {
      "bundleIdentifier": "net.jasonle.tjbot",
      "buildNumber": "7",
      "infoPlist": {
        "NSCameraUsageDescription": "TJBot uses the camera to scan setup codes when pairing your child's device.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.TJBot.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    }
  }
}
