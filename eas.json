{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    // REQUIRES: HTTPS cert on backend, App Store certs — see docs/qa/ad-hoc/2026-04-17-mobile-release-hardening.md §Follow-ups
    "production": {
      "distribution": "store",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_TBOT_API_URL": "https://tbot-backend-8wmh.onrender.com/v1",
        "EXPO_PUBLIC_TBOT_AI_URL": "https://tbot-backend-8wmh.onrender.com/v1/ai",
        "EXPO_PUBLIC_WS_URL": "wss://tbot-backend-8wmh.onrender.com"
      }
    },
    "staging-device": {
      "developmentClient": false,
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_TBOT_API_URL": "https://tbot-backend-8wmh.onrender.com/v1",
        "EXPO_PUBLIC_TBOT_AI_URL": "https://tbot-backend-8wmh.onrender.com/v1/ai",
        "EXPO_PUBLIC_WS_URL": "wss://tbot-backend-8wmh.onrender.com"
      },
      "ios": {},
      "android": {
        "buildType": "apk"
      }
    }
  }
}
