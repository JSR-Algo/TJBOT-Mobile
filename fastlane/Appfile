# TJBot-mobile Fastlane Appfile
#
# Real values are injected via GitHub Actions secrets at CI time.
# Locally, export the matching env vars before running `bundle exec fastlane ...`.
#
# Required env vars:
#   FASTLANE_APPLE_ID            Apple ID for App Store Connect upload (e.g. ci@TJBot.com)
#   FASTLANE_TEAM_ID             Apple Developer Team ID (10-char alphanumeric)
#   FASTLANE_ITC_TEAM_ID         App Store Connect team ID (optional, if account belongs to >1 team)

app_identifier "com.TJBot.mobile"

apple_id ENV["FASTLANE_APPLE_ID"]
team_id ENV["FASTLANE_TEAM_ID"]
itc_team_id ENV["FASTLANE_ITC_TEAM_ID"] if ENV["FASTLANE_ITC_TEAM_ID"]
