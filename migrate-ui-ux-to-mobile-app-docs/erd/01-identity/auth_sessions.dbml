// auth_sessions — refresh-session tracking and revocation for parent app + admin console.
// Source: docs/site/software/systems/01-identity-household-access.md §3.1 auth_sessions.

enum auth_session_status {
  active
  revoked
  expired
}

enum auth_session_client {
  parent_app
  admin_console
  support_tool
}

Table auth_sessions {
  id                  uuid                   [pk]
  user_id             uuid                   [not null, note: 'spec field name parent_account_id']
  client_type         auth_session_client    [not null]
  device_name         varchar(120)
  platform            varchar(32)
  ip_address          varchar(45)            [note: 'string repr of INET; v6-capable']
  user_agent          varchar(512)
  issued_at           timestamptz            [not null, default: `now()`]
  last_used_at        timestamptz
  expires_at          timestamptz            [not null]
  status              auth_session_status    [not null, default: 'active']
  revoked_at          timestamptz
  revoke_reason       varchar(80)
  created_at          timestamptz            [not null, default: `now()`]
  updated_at          timestamptz            [not null, default: `now()`]

  Indexes {
    (user_id, status) [name: 'idx_auth_sessions_user_status', note: 'hot query: docs/sequences/01-identity/token-refresh.sequence.mmd — list active sessions for /logout-all']
    (expires_at) [name: 'idx_auth_sessions_expires_at', note: 'hot query: docs/sequences/01-identity/token-refresh.sequence.mmd — auth.maintenance.expire_sessions cron']
  }
}

Ref: auth_sessions.user_id > users.id
