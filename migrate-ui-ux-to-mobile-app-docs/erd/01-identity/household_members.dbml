// household_members — role-scoped access between adult users and households.
// Source: docs/site/software/systems/01-identity-household-access.md §3.1 household_memberships.

enum household_member_role {
  owner
  manager
  viewer
}

enum household_member_status {
  active
  pending_invite
  revoked
}

Table household_members {
  id                       uuid                      [pk]
  household_id             uuid                      [not null]
  user_id                  uuid                      [not null, note: 'spec field name parent_account_id']
  role                     household_member_role     [not null, default: 'manager']
  status                   household_member_status   [not null, default: 'active']
  invited_by_user_id       uuid                      [note: 'self-ref into users for invite chain']
  accepted_at              timestamptz
  revoked_at               timestamptz
  created_at               timestamptz               [not null, default: `now()`]
  updated_at               timestamptz               [not null, default: `now()`]

  Indexes {
    (household_id, user_id) [unique, name: 'idx_household_members_household_user_unique']
    (user_id, status) [name: 'idx_household_members_user_status', note: 'hot query: docs/sequences/01-identity/login.sequence.mmd — resolve accessible households for /v1/me']
    (household_id, role, status) [name: 'idx_household_members_household_role_status', note: 'hot query: docs/sequences/01-identity/child-profile-create.sequence.mmd — authz check (owner+manager only)']
  }
}

Ref: household_members.household_id > households.id
Ref: household_members.user_id > users.id
Ref: household_members.invited_by_user_id > users.id
