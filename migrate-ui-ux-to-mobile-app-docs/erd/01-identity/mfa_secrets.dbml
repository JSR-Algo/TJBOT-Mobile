// mfa_secrets — TOTP / WebAuthn second-factor secrets bound to a user.
// Plan §3 lists mfa_secrets under sys-01; current sys-01 sequences do not exercise MFA
// (admin MFA lives in sys-12), so this entity is forward-looking. Annotated @no-sequence.

enum mfa_method {
  totp
  webauthn
  recovery_code
}

enum mfa_secret_status {
  active
  disabled
  revoked
}

Table mfa_secrets {
  id              uuid                  [pk]
  user_id         uuid                  [not null]
  method          mfa_method            [not null]
  status          mfa_secret_status     [not null, default: 'active']
  secret_hash     varchar(256)          [not null, note: 'encrypted at rest via sys-13 KMS envelope; never plaintext']
  label           varchar(80)           [note: 'user-supplied nickname for the factor (e.g. "Yubikey-blue")']
  enrolled_at     timestamptz           [not null]
  last_used_at    timestamptz
  disabled_at     timestamptz
  created_at      timestamptz           [not null, default: `now()`]
  updated_at      timestamptz           [not null, default: `now()`]

  Indexes {
    (user_id, status) [name: 'idx_mfa_secrets_user_status', note: 'hot query: docs/sequences/01-identity/login.sequence.mmd — list active second factors at login challenge']
  }
}

Ref: mfa_secrets.user_id > users.id
