// password_reset_tokens — single-use password-reset nonces.
// Source: docs/site/software/systems/01-identity-household-access.md §3.1 password_reset_tokens.

enum password_reset_token_status {
  pending
  consumed
  expired
  invalidated
}

Table password_reset_tokens {
  id              uuid                          [pk]
  user_id         uuid                          [not null]
  token_hash      varchar(128)                  [not null]
  status          password_reset_token_status   [not null, default: 'pending']
  expires_at      timestamptz                   [not null]
  used_at         timestamptz
  requested_ip    varchar(45)
  created_at      timestamptz                   [not null, default: `now()`]
  updated_at      timestamptz                   [not null, default: `now()`]

  Indexes {
    (token_hash) [unique, name: 'idx_password_reset_tokens_token_hash_unique']
    (user_id, status) [name: 'idx_password_reset_tokens_user_status', note: 'hot query: docs/sequences/01-identity/password-reset.sequence.mmd — find pending reset for user']
  }
}

Ref: password_reset_tokens.user_id > users.id
