Table device_decommissions {
  id                  uuid        [pk, note: 'service-generated; never serial']
  device_id           uuid        [not null, note: 'ref → devices.id']
  household_id        uuid        [not null, note: 'cross-domain ref → IdentityService; household at time of decommission']
  initiated_by_user_id uuid       [not null, note: 'cross-domain ref → IdentityService; owner who triggered decommission']
  reason              varchar(128) [note: 'optional operator-supplied reason or system reason code']
  decommissioned_at   timestamptz [not null, note: 'set by DecommissionWorker on finalization']
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]

  Indexes {
    (device_id) [name: 'idx_device_decommissions_device_id']
    (household_id) [name: 'idx_device_decommissions_household_id']
    (decommissioned_at) [name: 'idx_device_decommissions_decommissioned_at', note: 'hot query: docs/sequences/02-device/decommission.sequence.mmd — audit and support lookup']
  }
}

Ref: device_decommissions.device_id > devices.id
// Ref: device_decommissions.household_id > households.id          // cross-domain ref → IdentityService
// Ref: device_decommissions.initiated_by_user_id > users.id       // cross-domain ref → IdentityService
