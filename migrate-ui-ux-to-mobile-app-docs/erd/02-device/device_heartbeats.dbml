Table device_heartbeats {
  id                   uuid        [pk, note: 'service-generated; never serial']
  device_id            uuid        [not null, note: 'ref → devices.id']
  firmware_version     varchar(32) [not null]
  battery_level        integer     [note: 'percent 0-100']
  connectivity_metrics jsonb       [note: 'snapshot: rssi, packet_loss, latency_ms']
  runtime_state        varchar(64) [note: 'device state at heartbeat time: IDLE_READY, SAFE_MODE, OFFLINE_LIMITED, etc.']
  fault_code           varchar(64) [note: 'last fault code if runtime_state=SAFE_MODE']
  created_at           timestamptz [not null, default: `now()`]
  updated_at           timestamptz [not null, default: `now()`]

  Note: '@timescaledb-hypertable column=created_at interval=1d'

  Indexes {
    (device_id, created_at) [name: 'idx_device_heartbeats_device_id_created_at', note: 'hot query: docs/sequences/02-device/heartbeat.sequence.mmd — time-series lookup per device']
    (created_at) [name: 'idx_device_heartbeats_created_at', note: 'TimescaleDB chunk dimension index']
  }
}

Ref: device_heartbeats.device_id > devices.id
