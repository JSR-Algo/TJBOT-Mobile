enum device_pairing_status {
  started
  ble_paired
  device_authenticated
  completed
  failed
  expired
}

Table device_pairings {
  id                    uuid                  [pk, note: 'service-generated; never serial']
  device_id             uuid                  [not null, note: 'ref → devices.id']
  household_id          uuid                  [not null, note: 'cross-domain ref → IdentityService']
  initiated_by_user_id  uuid                  [not null, note: 'cross-domain ref → IdentityService']
  assigned_child_id     uuid                  [note: 'cross-domain ref → IdentityService; set on provision/complete']
  status                device_pairing_status [not null, default: 'started']
  app_version           varchar(32)
  phone_platform        varchar(32)
  display_name          varchar(128)
  failure_code          varchar(64)
  completed_at          timestamptz
  expires_at            timestamptz           [not null, note: 'pairing attempt TTL; service sets ~10min from started']
  created_at            timestamptz           [not null, default: `now()`]
  updated_at            timestamptz           [not null, default: `now()`]

  Indexes {
    (device_id, status) [name: 'idx_device_pairings_device_id_status', note: 'hot query: docs/sequences/02-device/consumer-provisioning.sequence.mmd — attempt-status guard']
    (household_id) [name: 'idx_device_pairings_household_id']
    (expires_at) [name: 'idx_device_pairings_expires_at', note: 'hot query: docs/sequences/02-device/consumer-provisioning.sequence.mmd — sweep expired attempts']
  }
}

Ref: device_pairings.device_id > devices.id
// Ref: device_pairings.household_id > households.id          // cross-domain ref → IdentityService
// Ref: device_pairings.initiated_by_user_id > users.id       // cross-domain ref → IdentityService
// Ref: device_pairings.assigned_child_id > children.id       // cross-domain ref → IdentityService
