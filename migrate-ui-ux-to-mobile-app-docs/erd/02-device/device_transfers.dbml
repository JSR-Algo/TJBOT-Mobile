enum device_transfer_status {
  initiated
  awaiting_factory_reset
  awaiting_target_claim
  completed
  failed
  expired
  cancelled
}

Table device_transfers {
  id                        uuid                    [pk, note: 'service-generated; never serial']
  device_id                 uuid                    [not null, note: 'ref → devices.id']
  source_household_id       uuid                    [not null, note: 'cross-domain ref → IdentityService']
  source_user_id            uuid                    [not null, note: 'cross-domain ref → IdentityService; initiating owner']
  target_household_id       uuid                    [note: 'cross-domain ref → IdentityService; set when target claims device']
  status                    device_transfer_status  [not null, default: 'initiated']
  failure_code              varchar(64)
  initiated_at              timestamptz             [not null, default: `now()`]
  factory_reset_confirmed_at timestamptz
  target_claimed_at         timestamptz
  completed_at              timestamptz
  expires_at                timestamptz             [not null, note: 'transfer TTL; service sets per spec §7.4']
  created_at                timestamptz             [not null, default: `now()`]
  updated_at                timestamptz             [not null, default: `now()`]

  Indexes {
    (device_id, status) [name: 'idx_device_transfers_device_id_status', note: 'hot query: docs/sequences/02-device/transfer.sequence.mmd — one active transfer per device guard']
    (source_household_id) [name: 'idx_device_transfers_source_household_id']
    (status, expires_at) [name: 'idx_device_transfers_status_expires_at', note: 'hot query: docs/sequences/02-device/transfer.sequence.mmd — integrity job detects broken transfers']
  }
}

Ref: device_transfers.device_id > devices.id
// Ref: device_transfers.source_household_id > households.id  // cross-domain ref → IdentityService
// Ref: device_transfers.source_user_id > users.id            // cross-domain ref → IdentityService
// Ref: device_transfers.target_household_id > households.id  // cross-domain ref → IdentityService
