// safety_topics — topic classifier output catalog used by TopicClassifier.
// DISTINCT from sys-06 content topics (taxonomy of curriculum tags) — these are unsafe-evasion topics:
// e.g. "violence_evasion", "self_harm_evasion". Cross-system collision pre-empted by name + folder.
// Source: sys-05 §13 topic classifier (4 example categories + cumulative-weight scoring).

enum safety_topic_severity {
  cautious
  sensitive
  blocked
  emergency
}

Table safety_topics {
  id                       uuid                    [pk]
  slug                     varchar(64)             [not null, note: 'machine identifier — e.g. violence_evasion']
  display_name             varchar(120)            [not null]
  description              text                    [not null]
  severity                 safety_topic_severity   [not null]
  classifier_threshold_pct integer                 [not null, note: 'cumulative weight ÷ 100 to trigger block (default 80 = 0.80) — avoids float per CONVENTIONS.md']
  required_keyword_count   integer                 [not null, default: 2, note: 'min keyword matches in input — sys-05 §13']
  keywords                 jsonb                   [not null, note: 'array of {token, weight}; document shape in sys-05 §13 — e.g. [{"token":"hurt","weight":40},{"token":"pain","weight":50}]']
  parent_alert_threshold   safety_topic_severity   [not null, default: 'blocked', note: 'min severity that triggers parent notification — emergency always alerts']
  fallback_trigger_code    varchar(64)             [not null, note: 'links to fallback_templates lookup — e.g. violence_blocked']
  retired_at               timestamptz
  created_at               timestamptz             [not null, default: `now()`]
  updated_at               timestamptz             [not null, default: `now()`]

  Indexes {
    (slug) [unique, name: 'idx_safety_topics_slug_unique']
    (severity, retired_at) [name: 'idx_safety_topics_severity_retired_at', note: 'hot query: docs/sequences/05-safety/input-filter.sequence.mmd — TopicClassifier loads all non-retired active rows at boot']
  }
}
