// usage_caps — per-child per-day runtime enforcement records.
// Tracks consumed minutes against parent_controls limits for real-time enforcement.
// COPPA: links to children → retention required.
// Source: docs/sequences/07-parent/controls-update.sequence.mmd

Table usage_caps {
  id                uuid        [pk]
  device_id         uuid        [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id  uuid        [not null, note: 'cross-domain ref → IdentityService (children.id)']
  cap_date          date        [not null, note: 'local calendar date of enforcement; UTC stored']
  consumed_minutes  integer     [not null, default: 0, note: 'minutes consumed so far this day']
  capped_at         timestamptz [note: 'set when daily limit reached; NULL while under cap']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  deleted_at        timestamptz [note: 'soft-delete; COPPA retention']

  Indexes {
    (device_id, child_profile_id, cap_date) [unique, name: 'idx_usage_caps_device_child_date_unique']
    (child_profile_id, cap_date) [name: 'idx_usage_caps_child_date', note: 'hot query: docs/sequences/07-parent/controls-update.sequence.mmd — check cap status at session start']
  }
}

// Ref: usage_caps.device_id > devices.id           // cross-domain ref → DeviceService
// Ref: usage_caps.child_profile_id > children.id   // cross-domain ref → IdentityService
