// weekly_summaries — derived weekly engagement aggregate per (device, child).
// Derived from daily_summaries; rebuilt by SummaryWorker (sys-07 Monday cron).
// Upsert key: (device_id, child_profile_id, iso_week).
// COPPA: links to children → retention required.
// Source: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd

enum engagement_trend {
  increasing
  stable
  declining
}

Table weekly_summaries {
  id                  uuid             [pk]
  device_id           uuid             [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id    uuid             [not null, note: 'cross-domain ref → IdentityService (children.id)']
  iso_week            varchar(8)       [not null, note: 'ISO 8601 week; format YYYY-Www e.g. 2026-W20']
  total_minutes       integer          [not null, default: 0, note: 'sum of daily_summaries.total_minutes for the week']
  activities_count    integer          [not null, default: 0]
  words_introduced    integer          [not null, default: 0]
  engagement_trend    engagement_trend [not null, default: 'stable', note: 'increasing if Δ ≥ +15%; declining if Δ ≤ -15%']
  topics_covered      jsonb            [note: 'array of topic slugs covered during the week']
  created_at          timestamptz      [not null, default: `now()`]
  updated_at          timestamptz      [not null, default: `now()`]
  deleted_at          timestamptz      [note: 'soft-delete; COPPA retention']

  Indexes {
    (device_id, child_profile_id, iso_week) [unique, name: 'idx_weekly_summaries_device_child_week_unique']
    (child_profile_id, iso_week) [name: 'idx_weekly_summaries_child_week', note: 'hot query: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd — SELECT prev-week for trend delta']
  }
}

// Ref: weekly_summaries.device_id > devices.id           // cross-domain ref → DeviceService
// Ref: weekly_summaries.child_profile_id > children.id   // cross-domain ref → IdentityService
