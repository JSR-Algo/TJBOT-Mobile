// audit_events — append-only compliance audit log.
// Spec calls this `audit_log`. ERD-level name `audit_events` per plan §3.
// Polymorphic target reference: target_table varchar + target_id uuid — NO FK by
// design because audit_events points at rows in every lane, and a single FK can
// only target one table. Use case validates this: parent-deletion audit row needs
// to point at users (sys-01) on Monday and at children (sys-01) on Tuesday.
// Source: docs/site/software/systems/11-telemetry-audit-cost.md §Audit Log.

enum audit_actor_kind {
  parent
  admin
  system
  device
}

Table audit_events {
  id                uuid                 [pk]
  actor_kind        audit_actor_kind     [not null]
  actor_id          varchar(254)         [not null, note: 'free-form — user_id, admin_user_id, service-slug, device_id; not FK-constrained because polymorphic']
  action            varchar(120)         [not null, note: 'verb_noun — create_child_profile, update_controls, force_disconnect, etc.']
  target_table      varchar(64)          [not null, note: 'polymorphic — no FK by design; this column names the row''s domain entity']
  target_id         uuid                 [not null, note: 'polymorphic — no FK by design; pairs with target_table']
  details           jsonb                [not null, default: `'{}'::jsonb`, note: 'before/after diff, reason, request_id, etc.']
  ip_address        varchar(45)          [note: 'IPv4/IPv6 textual (varchar — not inet — for DBML portability)']
  user_agent        text
  request_id        varchar(64)          [note: 'gateway-issued request id for end-to-end tracing']
  created_at        timestamptz          [not null, default: `now()`]
  updated_at        timestamptz          [not null, default: `now()`]

  Indexes {
    (actor_kind, actor_id, created_at) [name: 'idx_audit_events_actor_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — per-actor audit drill-down']
    (target_table, target_id, created_at) [name: 'idx_audit_events_target_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — per-resource audit timeline']
    (action, created_at) [name: 'idx_audit_events_action_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — admin investigation by action verb']
  }
}
