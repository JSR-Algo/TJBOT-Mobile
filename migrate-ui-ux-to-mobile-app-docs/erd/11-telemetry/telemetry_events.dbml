// telemetry_events — hot device telemetry pipeline.
// Hypertable: time-series store partitioned by created_at. Spec routes raw events
// through Firehose → S3 + Athena, but Postgres also carries a hypertable of the
// same shape for low-latency ops queries (health dashboards, support drill-down,
// alert evaluation). Source: spec §Telemetry Event Types + §Ingestion Pipeline.
// Hypertable: declared in Note — TimescaleDB extension materializes the partition
// scheme; retention frontmatter is 90d to match spec §Data Retention.

Table telemetry_events {
  id                  uuid          [pk, note: 'event_id from device payload — UUIDv4']
  device_id           uuid          [not null, note: 'cross-domain ref → DeviceService']
  child_id            uuid          [note: 'cross-domain ref → IdentityService — set only for child-scoped events (session.start/end/turn.latency); null for device.boot/health/error']
  session_id          uuid          [note: 'cross-domain ref → RealtimeService (sys-04 sessions) — set only for session-scoped events']
  event_type          varchar(64)   [not null, note: 'device.boot|device.wake|device.session.start|device.session.end|device.turn.latency|device.error|device.ota.result|device.health']
  payload             jsonb         [not null, default: `'{}'::jsonb`, note: 'event-type-specific keys — see spec §Telemetry Event Types']
  batch_id            uuid          [not null, note: 'idempotency key from POST /v1/telemetry/batch — Redis 24h SET NX dedupes across redelivery']
  client_timestamp_ms bigint        [not null, note: 'device-supplied epoch ms; server uses created_at for analytics to bypass clock skew']
  server_received_at  timestamptz   [not null, default: `now()`, note: 'server stamp at ingest — primary time partition column']
  sampling_rate       integer       [not null, default: 100, note: 'percentage — 10 for verbose turn.latency, 100 for everything else']
  pii_scan_passed     boolean       [not null, default: true, note: 'false rows never reach this table — kept as defensive marker']
  created_at          timestamptz   [not null, default: `now()`, note: '@timescaledb-hypertable column=created_at interval=1d']
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (device_id, created_at) [name: 'idx_telemetry_events_device_created', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — device health drill-down by support']
    (event_type, created_at) [name: 'idx_telemetry_events_type_created', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — error-rate dashboard']
    (session_id, created_at) [name: 'idx_telemetry_events_session_created', note: 'hot query: docs/sequences/11-telemetry/session-cost-attribution.sequence.mmd — per-session turn timing']
    (batch_id) [name: 'idx_telemetry_events_batch_id', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — idempotency replay verification']
  }

  Note: '@timescaledb-hypertable column=created_at interval=1d'
}
