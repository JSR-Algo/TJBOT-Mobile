// admin_sessions — admin session-token tracking (MFA-bound).
// Source: docs/site/software/systems/12-support-admin-operations.md §3.1 admin_sessions.

enum admin_session_status {
  active
  revoked
  expired
}

Table admin_sessions {
  id              uuid                    [pk]
  admin_user_id   uuid                    [not null]
  token_hash      varchar(128)            [not null]
  status          admin_session_status    [not null, default: 'active']
  ip_address      varchar(45)             [not null]
  user_agent      varchar(512)
  expires_at      timestamptz             [not null, note: 'admin sessions cap at 12h per spec §3 Session Rules']
  revoked_at      timestamptz
  revoke_reason   varchar(80)
  created_at      timestamptz             [not null, default: `now()`]
  updated_at      timestamptz             [not null, default: `now()`]

  Indexes {
    (token_hash) [unique, name: 'idx_admin_sessions_token_hash_unique']
    (admin_user_id, status) [name: 'idx_admin_sessions_admin_user_status', note: 'hot query: docs/sequences/12-admin/login-and-mfa.sequence.mmd — list active sessions for forced logout']
    (expires_at) [name: 'idx_admin_sessions_expires_at']
  }
}

Ref: admin_sessions.admin_user_id > admin_users.id
