// secret_versions — version history for application-layer secrets (DB creds, API keys, webhook signing secrets, etc.).
// Distinct from kms_keys: kms_keys is hardware-managed material; secret_versions are
// envelope-encrypted blobs we store + cache for application bootstrap.

enum secret_version_status {
  pending
  active
  retired
  compromised
}

Table secret_versions {
  id              uuid                    [pk]
  secret_name     varchar(120)            [not null, note: 'logical name, e.g. "stripe.webhook.signing", "db.realtime.password"']
  version         integer                 [not null, note: 'monotonic per secret_name']
  status          secret_version_status   [not null, default: 'pending']
  envelope_kms_key_id uuid                [not null, note: 'kms_keys.id used to envelope-encrypt the ciphertext blob']
  ciphertext      text                    [not null, note: 'envelope-encrypted base64 blob; cleartext never persists']
  activated_at    timestamptz
  retired_at      timestamptz
  created_at      timestamptz             [not null, default: `now()`]
  updated_at      timestamptz             [not null, default: `now()`]

  Indexes {
    (secret_name, version) [unique, name: 'idx_secret_versions_name_version_unique']
    (secret_name, status) [name: 'idx_secret_versions_name_status', note: 'hot query: docs/sequences/13-security/secrets-cache-fetch.sequence.mmd — fetch active version on cache miss']
  }
}

Ref: secret_versions.envelope_kms_key_id > kms_keys.id
