// deletion_jobs — per-household execution tracker for an active deletion request.
// One deletion_request may produce many deletion_jobs (one per owned household).
// Captures the explicit per-row execution log spec §Account Deletion Pipeline calls
// `execution_log JSONB` — promoted here to its own table for queryability.
// COPPA P0: legal record of HOW deletion executed. Status enum: requested →
// grace_period → executing → completed | failed.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Account Deletion Pipeline §Deletion Execution.

enum deletion_job_status {
  requested
  grace_period
  executing
  completed
  failed
}

Table deletion_jobs {
  id                  uuid                    [pk]
  deletion_request_id uuid                    [not null]
  household_id        uuid                    [note: 'cross-domain ref → IdentityService (sys-01 households) — set when scope_kind=parent_account; null for child_profile-scoped jobs']
  child_id            uuid                    [note: 'cross-domain ref → IdentityService (sys-01 children) — set when this job is the child-profile cascade']
  status              deletion_job_status     [not null, default: 'requested']
  execution_log       jsonb                   [not null, default: `'[]'::jsonb`, note: 'append-only array of {step, table, rows_affected, completed_at} per spec §Deletion Execution table']
  started_at          timestamptz
  completed_at        timestamptz
  error_message       text                    [note: 'set when status=failed; cleared on retry']
  retry_count         integer                 [not null, default: 0]
  created_at          timestamptz             [not null, default: `now()`]
  updated_at          timestamptz             [not null, default: `now()`]

  Indexes {
    (deletion_request_id, status) [name: 'idx_deletion_jobs_request_status', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — track per-household progress']
    (status, started_at) [name: 'idx_deletion_jobs_status_started', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — executor picks pending jobs']
  }
}

Ref: deletion_jobs.deletion_request_id > deletion_requests.id
