// deletion_requests — parent-initiated account-deletion lifecycle row.
// Spec calls this `account_deletion_requests`; ERD-level name `deletion_requests`
// per plan §3. COPPA P0: retains the legal proof that the right of deletion was
// exercised — MUST NEVER be hard-deleted (spec §"Never Delete Deletion Requests").
// Scope-anchor: a single deletion request may target a parent (user) OR an
// individual child profile. The scope is recorded in `scope_kind` + foreign refs.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Account Deletion Pipeline.

enum deletion_request_status {
  pending
  grace_period
  cancelled
  executing
  completed
  failed
}

enum deletion_request_scope {
  parent_account
  child_profile
}

Table deletion_requests {
  id                          uuid                       [pk]
  parent_account_id           uuid                       [not null, note: 'cross-domain ref → IdentityService (sys-01 users) — the requesting parent']
  child_id                    uuid                       [note: 'cross-domain ref → IdentityService (sys-01 children) — set only when scope_kind=child_profile']
  scope_kind                  deletion_request_scope     [not null, default: 'parent_account']
  requested_at                timestamptz                [not null]
  grace_period_ends_at        timestamptz                [not null, note: 'requested_at + 30 days per COPPA §312.10 "verifiable parental consent" tracked + GDPR §17 erasure window']
  cancelled_at                timestamptz
  executed_at                 timestamptz
  status                      deletion_request_status    [not null, default: 'pending']
  cancel_token_hash           varchar(120)               [note: 'sha256 of one-time cancel link signed token']
  original_email              varchar(254)               [note: 'preserved at request time for sending the completion confirmation post-anonymisation']
  request_ip                  varchar(45)
  request_user_agent          text
  created_at                  timestamptz                [not null, default: `now()`]
  updated_at                  timestamptz                [not null, default: `now()`]

  Indexes {
    (parent_account_id, status) [name: 'idx_deletion_requests_parent_status', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — check for existing active request per parent']
    (status, grace_period_ends_at) [name: 'idx_deletion_requests_status_grace', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — executor finds eligible requests']
  }
}
