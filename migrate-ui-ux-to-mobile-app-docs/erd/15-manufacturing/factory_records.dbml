enum factory_record_result {
  pass
  fail
  quarantine
}

Table factory_records {
  id                uuid                  [pk, note: 'service-generated; never serial']
  device_id         uuid                  [note: 'ref → devices.id; null if backend registration failed (device still recorded)']
  serial_number     varchar(64)           [not null, note: 'format: TBT-YYYY-{6digits}; set from AT+SERIAL before backend registration']
  factory_batch_id  varchar(64)           [not null, note: 'batch identifier from tbot-provision CLI (e.g. B2026-042)']
  operator_id       varchar(64)           [not null, note: 'operator login or workstation credential used by FactoryCLI']
  workstation_id    varchar(64)           [not null, note: 'physical workstation or test jig identifier']
  hardware_revision varchar(32)           [not null]
  firmware_version  varchar(32)           [not null]
  overall_result    factory_record_result [not null]
  test_duration_ms  integer               [not null, note: 'total time for all test phases in ms']
  notes             text                  [note: 'operator free-text note on failure or quarantine; null on pass']
  created_at        timestamptz           [not null, default: `now()`]
  updated_at        timestamptz           [not null, default: `now()`]

  Indexes {
    (serial_number) [unique, name: 'uq_factory_records_serial_number', note: 'one factory record per serial; re-runs replace this record']
    (factory_batch_id) [name: 'idx_factory_records_factory_batch_id', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — batch summary report']
    (overall_result, created_at) [name: 'idx_factory_records_result_created_at', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — yield / failure rate']
    (device_id) [name: 'idx_factory_records_device_id']
  }
}

// device_id is nullable (backend register may fail post-test); ref only declared when non-null in practice
// Ref: factory_records.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision
