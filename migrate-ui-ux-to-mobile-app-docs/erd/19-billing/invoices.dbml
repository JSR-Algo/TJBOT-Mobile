// invoices.dbml — immutable billing record per billing period

enum invoice_status {
  draft
  open
  paid
  void
  uncollectible
}

Table invoices {
  id                  uuid            [pk, note: 'service-generated; never serial']
  stripe_invoice_id   varchar(255)    [not null, unique, note: 'Stripe Invoice object ID (in_...)']
  stripe_customer_id  uuid            [not null, note: 'FK → stripe_customers.id']
  subscription_id     uuid            [not null, note: 'FK → subscriptions.id']
  amount_due_cents    bigint          [not null, note: 'money: bigint cents only']
  amount_paid_cents   bigint          [not null, default: 0, note: 'money: bigint cents only']
  currency            varchar(3)      [not null, default: 'usd']
  status              invoice_status  [not null, default: 'draft']
  period_start        timestamptz     [not null]
  period_end          timestamptz     [not null]
  paid_at             timestamptz
  created_at          timestamptz     [not null, default: `now()`]
  updated_at          timestamptz     [not null, default: `now()`]

  Indexes {
    (stripe_invoice_id) [unique, name: 'idx_invoices_stripe_invoice_id_unique']
    (stripe_customer_id, status) [name: 'idx_invoices_stripe_customer_id_status', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd']
    (subscription_id) [name: 'idx_invoices_subscription_id']
  }
}

Ref: invoices.stripe_customer_id > stripe_customers.id
Ref: invoices.subscription_id > subscriptions.id
