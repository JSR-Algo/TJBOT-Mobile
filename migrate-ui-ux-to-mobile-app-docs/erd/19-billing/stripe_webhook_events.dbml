// stripe_webhook_events.dbml — idempotency log for Stripe webhook ingestion

enum stripe_webhook_event_status {
  received
  processed
  failed
}

Table stripe_webhook_events {
  id                  uuid                          [pk, note: 'service-generated; never serial']
  stripe_event_id     varchar(255)                  [not null, unique, note: 'Stripe Event ID (evt_...) — idempotency key per Stripe spec']
  event_type          varchar(128)                  [not null, note: 'e.g. customer.subscription.updated, invoice.payment_failed']
  processing_status   stripe_webhook_event_status   [not null, default: 'received']
  payload_hash        varchar(64)                   [note: 'SHA-256 of raw payload — for integrity audit']
  attempts            int                           [not null, default: 0]
  processed_at        timestamptz
  failed_reason       text
  created_at          timestamptz                   [not null, default: `now()`]
  updated_at          timestamptz                   [not null, default: `now()`]

  Indexes {
    (stripe_event_id) [unique, name: 'idx_stripe_webhook_events_stripe_event_id_unique']
    (processing_status, created_at) [name: 'idx_stripe_webhook_events_status_created_at', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd']
  }

  Note: 'retention: 1 year minimum for financial audit. Stripe retries events up to 3x — stripe_event_id PK conflict signals duplicate; return 200 without reprocessing.'
}
