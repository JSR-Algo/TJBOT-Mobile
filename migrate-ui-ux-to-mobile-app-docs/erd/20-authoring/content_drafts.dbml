// content_drafts — working draft for a content template in the authoring workflow.
// Append-only versioning via content_revisions. Draft is the parent record.
// Source: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd

enum content_draft_status {
  draft
  safety_screening
  in_review
  changes_requested
  approved
  published
  archived
}

Table content_drafts {
  id              uuid                [pk]
  author_id       uuid                [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id)']
  title           varchar(254)        [not null]
  template_text   text                [not null, note: 'main template text; 10-500 chars enforced in app']
  variation_instruction text          [note: 'optional LLM variation hint; 10-300 chars enforced in app']
  age_bands       jsonb               [not null, note: 'array of age band identifiers; ≥1 required']
  category        varchar(64)         [not null]
  locale          varchar(16)         [not null, note: 'BCP-47']
  tags            jsonb               [note: 'array of topic slugs; ≤10 tags enforced in app']
  status          content_draft_status [not null, default: 'draft']
  current_version smallint            [not null, default: 1, note: 'points to latest content_revisions.version_no']
  created_at      timestamptz         [not null, default: `now()`]
  updated_at      timestamptz         [not null, default: `now()`]

  Indexes {
    (author_id, status) [name: 'idx_content_drafts_author_status', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — author dashboard listing']
    (status, created_at) [name: 'idx_content_drafts_status_created', note: 'hot query: docs/sequences/20-authoring/publish-to-system06.sequence.mmd — SELECT WHERE status=approved for pack assembly']
  }
}

// Ref: content_drafts.author_id > admin_users.id  // cross-domain ref → AdminAuthService
