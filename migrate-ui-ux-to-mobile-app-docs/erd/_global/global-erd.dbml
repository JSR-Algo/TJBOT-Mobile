// --- docs/erd/01-identity/users.dbml ---
// users — canonical adult identity (parent account holder).
// Spec calls this `parent_accounts`; ERD-level name is `users` per plan §3 manifest.
// Source: docs/site/software/systems/01-identity-household-access.md §3.1 parent_accounts.

enum user_status {
  active
  disabled
  scheduled_for_deletion
  deleted
}

Table users {
  id                     uuid             [pk]
  email                  varchar(254)     [not null, note: 'RFC 5321 max; case-insensitive at app layer']
  password_hash          text             [not null, note: 'argon2id / bcrypt; never plaintext']
  display_name           varchar(120)
  status                 user_status      [not null, default: 'active']
  default_household_id   uuid             [note: 'set after household creation; resolved on /v1/me']
  last_login_at          timestamptz
  disabled_reason        varchar(120)
  created_at             timestamptz      [not null, default: `now()`]
  updated_at             timestamptz      [not null, default: `now()`]
  deleted_at             timestamptz      [note: 'soft-delete; sys-14 retention sweep hard-deletes after policy window']

  Indexes {
    (email) [unique, name: 'idx_users_email_unique']
    (status, created_at) [name: 'idx_users_status_created_at', note: 'hot query: docs/sequences/01-identity/login.sequence.mmd — list active accounts; admin lookup']
    (default_household_id) [name: 'idx_users_default_household_id']
  }
}

// FK to households is declared in households.dbml (owning side keeps FK).
// default_household_id is intentionally not FK-constrained at table level because users
