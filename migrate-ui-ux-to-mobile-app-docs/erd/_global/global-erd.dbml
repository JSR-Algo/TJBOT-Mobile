// --- docs/erd/01-identity/coppa_consents.dbml ---
// coppa_consents — parent consent records required by COPPA for each child-data processing policy version.
// Per ADR-0005 (docs/decisions/0005-parent-gate-security-model.md) D2 and SM plan §8.1.
// One row per user×version — a new consent is created when the policy text changes (version bump).
// Superseded consents are NOT deleted; they are status=superseded for audit trail.

enum coppa_consent_status {
  active
  revoked
  superseded
}

Table coppa_consents {
  id                  uuid                  [pk, note: 'service-generated; never serial']
  user_id             uuid                  [not null, note: 'ref → users.id — consent given by the parent account holder']
  version             varchar(16)           [not null, note: 'policy version string — e.g. "2024-01-01"; bumped on any material text change']
  status              coppa_consent_status  [not null, default: 'active']
  ip                  inet                  [not null, note: 'IPv4 or IPv6 of the requesting client at consent time']
  policy_text_url     varchar(2048)         [not null, note: 'URL to the immutable consent text for this version (S3 or CDN)']
  accepted_locale     varchar(8)            [not null, note: 'BCP-47 locale — e.g. "en-US" — the UI language the parent saw the consent in']
  user_agent          text                  [note: 'raw User-Agent header at consent time']
  revoked_at          timestamptz           [note: 'NULL while active; set when parent revokes consent or account deletion begins']
  created_at          timestamptz           [not null, default: `now()`]
  updated_at          timestamptz           [not null, default: `now()`]

  Indexes {
    (user_id, status) [name: 'idx_coppa_consents_user_id_active', note: 'hot query: docs/sequences/01-identity/coppa-consent-record.sequence.mmd — check active consent before child-data write']
    (user_id, version) [unique, name: 'idx_coppa_consents_user_version_unique']
  }
}

Ref: coppa_consents.user_id > users.id    // cross-domain ref → IdentityService

