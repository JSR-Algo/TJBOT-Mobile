// --- docs/erd/02-device/pairing_attempts.dbml ---
// pairing_attempts — tracks each device pairing token lifecycle.
// Per SM plan §8.3 (DevicePairing state machine).
// One row per pairing attempt; short-lived (TTL 10 minutes default).
// Failed / expired rows retained 30d for audit then swept by RetentionWorker.

enum pairing_state {
  TOKEN_ISSUED
  PROVISIONING
  CLAIM_PENDING
  CLAIMED
  PAIRING_FAILED
  EXPIRED
}

Table pairing_attempts {
  id              uuid          [pk, note: 'service-generated; never serial']
  user_id         uuid          [not null, note: 'ref → users.id — parent initiating the pairing']
  device_serial   text          [not null, note: 'factory-burned serial number from device certificate; not a FK — device row may not exist yet at token-issuance time']
  token           text          [not null, unique, note: 'cryptographically random short-lived token; used as BLE advertisement payload']
  state           pairing_state [not null, default: 'TOKEN_ISSUED']
  state_version   int           [not null, default: 0, note: 'incremented on every state transition for optimistic concurrency']
  error_code      text          [note: 'NULL on success; set on PAIRING_FAILED with machine-readable code e.g. CERT_MISMATCH, CLAIM_TIMEOUT']
  expires_at      timestamptz   [not null, default: `now() + interval '10 minutes'`, note: 'DeviceService sweeper sets state=EXPIRED after this timestamp']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  Indexes {
    (user_id, created_at) [name: 'idx_pairing_attempts_user_created', note: 'hot query: docs/sequences/02-device/consumer-provisioning.sequence.mmd — list active pairing attempts for user']
    (expires_at) [name: 'idx_pairing_attempts_expiry', note: 'hot query: docs/sequences/02-device/consumer-provisioning.sequence.mmd — sweep expired attempts WHERE state IN (TOKEN_ISSUED, PROVISIONING, CLAIM_PENDING); partial index enforced via migration, DBML cannot express partial predicate natively']
    (token) [unique, name: 'idx_pairing_attempts_token_unique']
  }
}

Ref: pairing_attempts.user_id > users.id    // cross-domain ref → IdentityService

// === 03-device-runtime ===
// --- docs/erd/03-device-runtime/runtime_boot_reports.dbml ---
enum boot_result {
  success
  safe_mode_entered
  firmware_signature_invalid
  config_apply_failed
  wifi_unavailable
  repeated_crash
}

Table runtime_boot_reports {
  id                    uuid        [pk, note: 'service-generated; never serial']
  device_id             uuid        [not null, note: 'ref → devices.id']
  boot_count            integer     [not null, note: 'monotonic NVS counter at time of boot']
  firmware_version      varchar(32) [not null]
  result                boot_result [not null]
  boot_fail_window      integer     [not null, default: 0, note: 'number of failures in 15min window at boot time']
  last_boot_reason      varchar(64) [note: 'e.g. power_on, watchdog_reset, software_reset, panic']
  config_etag           varchar(128) [note: 'etag of config applied on this boot; null if config not fetched']
  duration_ms           integer     [note: 'ms from power-on to IDLE_READY or SAFE_MODE']
  uploaded_at           timestamptz [not null, note: 'when device uploaded this batch to backend']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  Indexes {
    (device_id, created_at) [name: 'idx_runtime_boot_reports_device_id_created_at', note: 'hot query: docs/sequences/03-device-runtime/boot.sequence.mmd — support lookup by device']
    (result, created_at) [name: 'idx_runtime_boot_reports_result_created_at', note: 'hot query: docs/sequences/03-device-runtime/boot.sequence.mmd — fleet safe-mode rate monitoring']
  }
}

// Ref: runtime_boot_reports.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// --- docs/erd/03-device-runtime/runtime_local_event_log.dbml ---
Table runtime_local_event_log {
  id              uuid        [pk, note: 'service-generated; never serial']
  device_id       uuid        [not null, note: 'ref → devices.id']
  event_type      varchar(64) [not null, note: 'e.g. CONFIG_APPLIED, WAKE_WORD_DETECTED, AUDIO_OVERRUN, WS_DISCONNECT']
  severity        varchar(16) [not null, note: 'info | warning | critical']
  fault_code      varchar(64) [note: 'e.g. E-AUD-102, E-RT-301; null for non-fault events']
  payload         jsonb       [note: 'event-specific metadata; shape varies by event_type']
  device_ts       timestamptz [not null, note: 'timestamp as recorded on device (NVS); may lag backend upload']
  uploaded_at     timestamptz [not null, note: 'when device uploaded this batch to backend']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  Indexes {
    (device_id, device_ts) [name: 'idx_runtime_local_event_log_device_id_ts', note: 'hot query: docs/sequences/03-device-runtime/offline-fallback.sequence.mmd — support: event timeline per device']
    (event_type, device_ts) [name: 'idx_runtime_local_event_log_event_type_ts', note: 'hot query: docs/sequences/03-device-runtime/safe-mode-entry.sequence.mmd — fleet fault-code aggregation']
  }
}

// Ref: runtime_local_event_log.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// --- docs/erd/03-device-runtime/safe_mode_entries.dbml ---
enum safe_mode_trigger {
  reboot_storm
  thermal_critical
  heap_below_floor
  audio_overrun_repeated
  watchdog_near_miss_persistent
  remote_command
}

enum safe_mode_resolution {
  remote_recovery
  reboot_cleared
  still_active
  unknown
}

Table safe_mode_entries {
  id                    uuid                  [pk, note: 'service-generated; never serial']
  device_id             uuid                  [not null, note: 'ref → devices.id']
  trigger               safe_mode_trigger     [not null]
  fault_code            varchar(64)           [not null, note: 'e.g. E-BOT-801, E-THM-601, E-MEM-701, E-AUD-102']
  entered_at_device_ts  timestamptz           [not null, note: 'timestamp as recorded on device (NVS safe_mode_until marker)']
  exited_at_device_ts   timestamptz           [note: 'null if still active when uploaded; set when device clears safe_mode_until']
  resolution            safe_mode_resolution  [not null, default: 'unknown']
  support_token         varchar(32)           [note: 'short code displayed to user on device support scene']
  uploaded_at           timestamptz           [not null, note: 'when device uploaded this record to backend']
  created_at            timestamptz           [not null, default: `now()`]
  updated_at            timestamptz           [not null, default: `now()`]

  Indexes {
    (device_id, entered_at_device_ts) [name: 'idx_safe_mode_entries_device_id_entered_at', note: 'hot query: docs/sequences/03-device-runtime/safe-mode-entry.sequence.mmd — support: safe-mode history per device']
    (trigger, entered_at_device_ts) [name: 'idx_safe_mode_entries_trigger_entered_at', note: 'hot query: docs/sequences/03-device-runtime/safe-mode-entry.sequence.mmd — fleet safe-mode rate monitoring by trigger']
    (resolution) [name: 'idx_safe_mode_entries_resolution', note: 'still_active entries for open-incident monitoring']
  }
}

// Ref: safe_mode_entries.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// === 04-realtime ===
// --- docs/erd/04-realtime/phrase_cache_entries.dbml ---
// phrase_cache_entries — pre-rendered TTS audio for fast-path / failover playback.
// Source: sys-04 §8 TTS Failover ("Pre-cached phrase audio ~50 MB in-memory"), §9 retry matrix S3 fetch.
// Distinct from sys-05 fallback_templates: phrase cache is the audio asset registry;
// fallback_templates is the text-content store. Phrase cache is text-keyed lookup.

enum phrase_cache_status {
  active
  retired
  rebuilding
}

Table phrase_cache_entries {
  id                       uuid                 [pk]
  phrase_text              text                 [not null, note: 'canonical text used for lookup; lowercased + NFKD-normalized at write time']
  phrase_text_sha256       varchar(64)          [not null, note: 'hash of normalized phrase_text — primary lookup key']
  locale                   varchar(16)          [not null, note: 'BCP-47']
  age_band                 varchar(8)           [not null, note: '4_5 | 6_8 — narration calibrated per sys-05 age bands']
  voice_profile            varchar(64)          [not null, note: 'TTS voice ID — pinned for cache hit consistency']
  audio_codec              varchar(16)          [not null, note: 'opus | pcm16le']
  sample_rate              integer              [not null, default: 16000]
  audio_s3_uri             varchar(2048)        [not null, note: 'S3 object URI; pre-loaded into orchestrator in-memory cache at boot']
  audio_size_bytes         integer              [not null]
  duration_ms              integer              [not null]
  expression_sync_s3_uri   varchar(2048)        [note: 'optional pre-computed lip-sync frames; absent → orchestrator generates on the fly']
  intent                   varchar(64)          [note: 'sys-05 intent taxonomy — narrows lookup when text-match ambiguous']
  status                   phrase_cache_status  [not null, default: 'active']
  version_no               integer              [not null, default: 1, note: 'append-only — increments on TTS regeneration']
  origin                   varchar(32)          [not null, note: 'curated | auto-promoted-from-llm | failover-canned']
  hit_count                bigint               [not null, default: 0, note: 'monotonic counter — telemetry-driven LRU eviction signal']
  last_hit_at              timestamptz
  created_by_admin_user_id uuid                 [note: 'cross-domain ref → AdminAuthService — Phase 3 reconciles']
  created_at               timestamptz          [not null, default: `now()`]
  updated_at               timestamptz          [not null, default: `now()`]
  retired_at               timestamptz

  Indexes {
    (phrase_text_sha256, locale, age_band, voice_profile) [unique, name: 'idx_phrase_cache_entries_text_locale_age_voice_unique']
    (status, locale) [name: 'idx_phrase_cache_entries_status_locale', note: 'hot query: docs/sequences/04-realtime/provider-failover.sequence.mmd — orchestrator preloads all active rows for locale at boot']
    (intent, locale, age_band) [name: 'idx_phrase_cache_entries_intent_locale_age', note: 'hot query: docs/sequences/05-safety/fallback-selection.sequence.mmd — intent-routed cache lookup']
    (hit_count) [name: 'idx_phrase_cache_entries_hit_count']
  }
}

// Origin field is the only state-machine surrogate beyond `status`; admin promotes auto-promoted-from-llm
// rows to curated via PATCH on phrase_cache_entries (no separate table).

// --- docs/erd/04-realtime/provider_failover_records.dbml ---
// provider_failover_records — audit ledger of provider failover events within a turn.
// Source: sys-04 §8 Provider Failover, §13 metrics rt_circuit_breaker_transition_total, queue tbot-circuit-breaker-event.
// One row per failover edge (primary → fallback OR fallback → canned) — enables forensic reconstruction
// of which provider served which segment of a turn.

enum provider_role {
  stt
  llm
  tts
}

enum failover_trigger {
  timeout
  circuit_open
  http_5xx
  stream_reset
  parse_failure
  manual_admin
}

enum failover_outcome {
  primary_succeeded
  secondary_succeeded
  cache_served
  canned_served
  all_failed
}

Table provider_failover_records {
  id                       uuid               [pk]
  session_id               uuid               [not null, note: 'FK → sessions.id']
  session_turn_id          uuid               [note: 'FK → session_turns.id; nullable for circuit-only transitions outside a turn']
  role                     provider_role      [not null]
  primary_provider         varchar(64)        [not null, note: 'provider attempted first — e.g. google_live_flash, google_stt']
  fallback_provider        varchar(64)        [note: 'provider that served — may equal primary if primary recovered; NULL if all-failed']
  trigger                  failover_trigger   [not null]
  outcome                  failover_outcome   [not null]
  primary_attempt_ms       integer            [not null]
  fallback_attempt_ms      integer
  primary_error_code       varchar(64)        [note: 'provider-native error code or E-RT-2xx']
  primary_http_code        integer            [note: 'HTTP status code from primary attempt; named *_code to avoid validator *_status false positive']
  circuit_state_before     varchar(16)        [note: 'closed | half_open | open — snapshot at decision time']
  circuit_state_after      varchar(16)
  recovery_attempt_no      integer            [not null, default: 1, note: 'monotonic within (session_id, role)']
  instance_id              varchar(64)        [not null]
  created_at               timestamptz        [not null, default: `now()`]
  updated_at               timestamptz        [not null, default: `now()`]

  Indexes {
    (session_id, created_at) [name: 'idx_provider_failover_records_session_id_created_at', note: 'hot query: docs/sequences/04-realtime/provider-failover.sequence.mmd — per-session failover replay for support']
    (role, primary_provider, created_at) [name: 'idx_provider_failover_records_role_provider_created_at', note: 'hot query: docs/sequences/11-telemetry/provider-health-roll-up.sequence.mmd — provider health roll-up']
    (outcome, created_at) [name: 'idx_provider_failover_records_outcome_created_at', note: 'hot query: docs/sequences/04-realtime/provider-failover.sequence.mmd — all-failed incident triage']
  }
}

Ref: provider_failover_records.session_id > sessions.id  // intra-domain
Ref: provider_failover_records.session_turn_id > session_turns.id  // intra-domain

// --- docs/erd/04-realtime/realtime_sessions.dbml ---
// realtime_sessions — authoritative record of a child voice session on a TBot device.
// Business term "ChildSession" maps to this table (per ADR-0006).
// Per SM plan §8.2 (LessonSession state machine) + ADR-0006 (child_sessions ownership, device-anchored).
// Partial unique index on (user_id, device_id) WHERE state is active prevents concurrent active sessions
// per device — DBML does not natively express partial indexes; constraint documented in Notes below and
// enforced via CHECK + application layer; represented here as a regular unique index with a DBML Note.

enum realtime_session_state {
  idle
  connecting
  handshaking
  open
  turn_active
  turn_complete
  barge_in
  reconnecting
  closing
  closed
  error
  paused
  timed_out
}

enum realtime_session_end_reason {
  complete
  timeout
  error
  parent_stop
  barge_limit
  cost_limit
  device_disconnect
  safety_block
}

Table realtime_sessions {
  id                uuid                        [pk, note: 'service-generated; never serial']
  user_id           uuid                        [not null, note: 'cross-domain ref → IdentityService — parent account owning this session']
  device_id         uuid                        [not null, note: 'cross-domain ref → DeviceService — device that originated the session']
  child_id          uuid                        [not null, note: 'cross-domain ref → IdentityService — child profile active at session start']
  state             realtime_session_state      [not null, default: 'idle']
  state_version     int                         [not null, default: 0, note: 'monotonic version counter; incremented on every state transition for optimistic concurrency']
  start_at          timestamptz                 [not null, note: 'wall clock when SESSION_OPEN received from device']
  end_at            timestamptz                 [note: 'NULL while session is open; set on any terminal transition']
  end_reason        realtime_session_end_reason [note: 'NULL while open; set alongside end_at']
  turns_count       int                         [not null, default: 0]
  bargein_count     int                         [not null, default: 0]
  cost_cents        bigint                      [not null, default: 0, note: 'money: bigint cents; cumulative LLM + TTS cost for this session']
  device_session_id uuid                        [not null, note: 'opaque idempotency token minted by device in SESSION_OPEN payload; guards against duplicate opens']
  created_at        timestamptz                 [not null, default: `now()`]
  updated_at        timestamptz                 [not null, default: `now()`]

  Indexes {
    (user_id, device_id) [name: 'idx_realtime_sessions_active', note: 'hot query: docs/sequences/04-realtime/session-start-mobile.sequence.mmd — partial unique enforced at app layer WHERE state NOT IN (closed,error,timed_out); DBML cannot express partial unique natively; see entity .md Notes']
    (device_session_id) [unique, name: 'idx_realtime_sessions_device_session_id_unique']
    (user_id, start_at) [name: 'idx_realtime_sessions_user_start_at', note: 'hot query: docs/sequences/04-realtime/observer-attach.sequence.mmd — session history for parent observer attach']
    (device_id, state) [name: 'idx_realtime_sessions_device_state', note: 'hot query: docs/sequences/04-realtime/ws-handshake.sequence.mmd — look up open session for device']
    (state, updated_at) [name: 'idx_realtime_sessions_state_updated_at', note: 'hot query: docs/sequences/04-realtime/session-close.sequence.mmd — idle-timeout sweep']
  }
}

Ref: realtime_sessions.user_id > users.id
Ref: realtime_sessions.device_id > devices.id
// Ref: realtime_sessions.child_id > children.id    // cross-domain ref → IdentityService

// --- docs/erd/04-realtime/session_transcripts.dbml ---
// session_transcripts — transcript + response text per turn, isolated to satisfy COPPA TTL clearing.
// MANDATORY separate table per .omc/plans §13 anti-pattern: transcripts MUST NOT live as JSONB on sessions.
// Source: sys-04 §4.1 session_turns DDL (transcript_text + response_text columns) + §4.2 retention rule.
// COPPA §312.10 — child PII must be deleted "within reasonable time after no longer needed".
//   Production TTL: text fields NULLed at 24h, row hard-deleted at 30d (mirrors session_turns).

Table session_transcripts {
  id                 uuid         [pk]
  session_turn_id    uuid         [not null, unique, note: 'FK → session_turns.id; one transcript row per turn']
  session_id         uuid         [not null, note: 'FK → sessions.id; denormalized for direct retention scans']
  child_profile_id   uuid         [not null, note: 'cross-domain ref → IdentityService.children — denormalized for COPPA on-deletion sweep']
  transcript_text    text         [note: 'verbatim STT output; NULLed at 24h by RetentionScheduler per sys-04 §4.2']
  response_text      text         [note: 'LLM-generated response; NULLed at 24h']
  transcript_sha256  varchar(64)  [note: 'SHA-256 of transcript at write time — preserved after NULL clear for safety event correlation; never reversible']
  response_sha256    varchar(64)  [note: 'SHA-256 of response at write time']
  language_detected  varchar(16)  [note: 'BCP-47 — STT may return language hint independent of session locale']
  cleared_at         timestamptz  [note: 'set when text columns NULLed by 24h sweep — non-NULL means text fields are empty']
  created_at         timestamptz  [not null, default: `now()`]
  updated_at         timestamptz  [not null, default: `now()`]

  Indexes {
    (session_id) [name: 'idx_session_transcripts_session_id']
    (created_at, cleared_at) [name: 'idx_session_transcripts_created_at_cleared_at', note: 'hot query: docs/sequences/04-realtime/coppa-retention.sequence.mmd — sweep selects created_at < now()-24h AND cleared_at IS NULL']
    (transcript_sha256) [name: 'idx_session_transcripts_transcript_sha256', note: 'hot query: docs/sequences/05-safety/safety-event-fanout.sequence.mmd — correlate safety_events.transcript_hash → original turn']
  }
}

Ref: session_transcripts.session_turn_id > session_turns.id  // intra-domain
Ref: session_transcripts.session_id > sessions.id  // intra-domain

// --- docs/erd/04-realtime/session_turns.dbml ---
// session_turns — one row per child utterance + assistant response within a session.
// Source: docs/site/software/systems/04-realtime-session-orchestrator.md §4.1 session_turns table, §7 turn pipeline.
// Sequences: turn-pipeline, barge-in, provider-failover, coppa-retention.
// Note: high-cardinality (max 60 per session, 200 sessions/instance, ECS fleet) — hypertable candidate.
// @timescaledb-hypertable(column=created_at, interval='1d')

enum session_turn_status {
  audio_capture
  stt_processing
  intent_classification
  input_safety_check
  llm_generation
  output_safety_check
  tts_synthesis
  streaming
  complete
  failed
  safety_blocked
  cancelled
}

enum session_turn_safety_action {
  none
  input_blocked
  output_blocked
}

Table session_turns {
  id                       uuid                       [pk]
  session_id               uuid                       [not null, note: 'FK → sessions.id; declared Ref: below — same-folder']
  turn_index               integer                    [not null, note: 'monotonic per session starting at 0; capped at 60']
  status                   session_turn_status        [not null, default: 'audio_capture']
  intent                   varchar(64)                [note: 'sys-05 intent classification taxonomy — 14 intents']
  safety_action            session_turn_safety_action [not null, default: 'none']
  stt_ms                   integer                    [note: 'end-of-speech → final transcript ms']
  intent_classify_ms       integer
  input_safety_ms          integer
  llm_first_token_ms       integer
  llm_complete_ms          integer
  output_safety_ms         integer
  tts_first_byte_ms        integer
  total_turn_ms            integer                    [note: 'end-of-speech → first TTS audio; sys-04 §7 p95 budget 1400ms']
  cost_stt_micros          bigint                     [not null, default: 0, note: 'money: bigint micros']
  cost_llm_micros          bigint                     [not null, default: 0, note: 'money: bigint micros']
  cost_tts_micros          bigint                     [not null, default: 0, note: 'money: bigint micros']
  cost_total_micros        bigint                     [not null, default: 0, note: 'money: bigint micros — sum of components for fast aggregation']
  stt_provider             varchar(64)                [not null]
  llm_provider             varchar(64)                [not null]
  tts_provider             varchar(64)                [not null]
  stt_confidence           integer                    [note: 'confidence × 1000 (0-1000); avoids float per CONVENTIONS.md']
  llm_input_tokens         integer
  llm_output_tokens        integer
  prompt_version_id        uuid                       [note: 'cross-domain ref → SafetyService.prompt_template_versions — Phase 3 reconciles']
  safety_policy_version_id uuid                       [note: 'cross-domain ref → SafetyService.safety_policy_versions — Phase 3 reconciles']
  blocklist_version_id     uuid                       [note: 'cross-domain ref → SafetyService.blocklist_versions — Phase 3 reconciles']
  cancelled_at             timestamptz                [note: 'barge-in / SESSION_CLOSE during streaming']
  failed_error_code        varchar(32)                [note: 'E-RT-21x / E-RT-25x — see sys-04 §5.1']
  created_at               timestamptz                [not null, default: `now()`]
  updated_at               timestamptz                [not null, default: `now()`]

  Indexes {
    (session_id, turn_index) [unique, name: 'idx_session_turns_session_id_turn_index_unique']
    (session_id) [name: 'idx_session_turns_session_id']
    (created_at) [name: 'idx_session_turns_created_at', note: 'hot query: docs/sequences/04-realtime/coppa-retention.sequence.mmd — retention sweep range scan']
    (status, created_at) [name: 'idx_session_turns_status_created_at', note: 'hot query: docs/sequences/11-telemetry/turn-telemetry-roll-up.sequence.mmd — telemetry aggregation by status']
    (safety_action) [name: 'idx_session_turns_safety_action']
  }
}

Ref: session_turns.session_id > sessions.id  // intra-domain — same lane (04-realtime)

// --- docs/erd/04-realtime/sessions.dbml ---
// sessions — one continuous voice conversation between a child and TBot, bound to a device + child profile.
// Source: docs/site/software/systems/04-realtime-session-orchestrator.md §3 domain model, §4.1 sessions table.
// Sequences: ws-handshake, turn-pipeline, session-close, barge-in, provider-failover, coppa-retention.

enum session_status {
  connecting
  open
  turn_active
  turn_complete
  reconnecting
  closing
  closed
}

enum session_end_reason {
  complete
  timeout
  error
  parent_stop
  barge_limit
  cost_limit
}

enum session_interaction_mode {
  conversation
  story
  quiz
}

Table sessions {
  id                       uuid                     [pk, note: 'service-generated UUID; never serial']
  device_session_id        varchar(64)              [not null, note: 'opaque token minted by device — SESSION_OPEN payload; idempotency key for SETNX device_session:{deviceId}']
  device_id                uuid                     [not null, note: 'cross-domain ref → DeviceService — FK declared in 02-device/devices.dbml']
  household_id             uuid                     [not null, note: 'cross-domain ref → IdentityService — FK declared in 01-identity/households.dbml']
  child_profile_id         uuid                     [not null, note: 'cross-domain ref → IdentityService.children — FK declared in 01-identity/children.dbml']
  interaction_mode         session_interaction_mode [not null]
  status                   session_status           [not null, default: 'connecting']
  turn_count               integer                  [not null, default: 0]
  total_duration_ms        integer                  [not null, default: 0]
  total_cost_micros        bigint                   [not null, default: 0, note: 'money: bigint micros (1e-6 USD); $0.12 ceiling = 120_000 micros']
  end_reason               session_end_reason       [note: 'NULL while open; set on close']
  stt_provider_used        varchar(64)              [not null, default: 'google_live_flash']
  llm_provider_used        varchar(64)              [not null, default: 'google_live_flash']
  tts_provider_used        varchar(64)              [not null, default: 'google_live_flash']
  safety_blocks_count      integer                  [not null, default: 0]
  barge_in_count           integer                  [not null, default: 0]
  locale                   varchar(16)              [not null, note: 'BCP-47 — snapshot at SESSION_OPEN, decouples from household']
  audio_codec              varchar(16)              [not null, default: 'opus']
  sample_rate              integer                  [not null, default: 16000]
  fw_version               varchar(32)              [not null]
  instance_id              varchar(64)              [not null, note: 'orchestrator pod hosting this session — useful for support timeline']
  started_at               timestamptz              [not null]
  ended_at                 timestamptz              [note: 'NULL while open']
  last_activity_at         timestamptz              [not null]
  created_at               timestamptz              [not null, default: `now()`]
  updated_at               timestamptz              [not null, default: `now()`]
  deleted_at               timestamptz              [note: 'soft-delete; RetentionScheduler hard-deletes after 90 days per sys-04 §4.2']

  Indexes {
    (device_id, started_at) [name: 'idx_sessions_device_id_started_at', note: 'hot query: docs/sequences/04-realtime/ws-handshake.sequence.mmd — recent session lookup per device']
    (household_id, started_at) [name: 'idx_sessions_household_id_started_at', note: 'hot query: docs/sequences/07-parent/parent-summary.sequence.mmd — household session aggregation']
    (child_profile_id, started_at) [name: 'idx_sessions_child_profile_id_started_at', note: 'hot query: docs/sequences/04-realtime/turn-pipeline.sequence.mmd — child session history for personalization']
    (status, last_activity_at) [name: 'idx_sessions_status_last_activity_at', note: 'hot query: docs/sequences/04-realtime/session-close.sequence.mmd — idle-timeout sweep selects open/turn_active sessions']
    (end_reason) [name: 'idx_sessions_end_reason']
    (created_at) [name: 'idx_sessions_created_at']
  }
}

// No Ref: lines here — cross-domain FKs (device_id, household_id, child_profile_id) are declared in
// the owning lane files (01-identity, 02-device). Phase 3 reconciles direction.

// === 05-safety ===
// --- docs/erd/05-safety/fallback_templates.dbml ---
// fallback_templates — deterministic safe replies for every blocked or degraded scenario.
// Source: sys-05 §4 fallback_response_templates DDL, §17 fallback selection cascade (19 trigger codes).
// Locale + age-band indexed; selection cascade lives in code, not DB triggers.
// Distinct from sys-04 phrase_cache_entries: this is TEXT template (locale-aware copy);
// phrase_cache is the RENDERED AUDIO. Both layers exist by design (plan §13 separation rationale).

enum fallback_template_status {
  draft
  published
  retired
}

Table fallback_templates {
  id                       uuid                       [pk]
  template_set             varchar(64)                [not null, note: 'groups templates referenced by safety_policy_versions.fallback_template_set']
  trigger_code             varchar(64)                [not null, note: 'one of the 19 trigger codes in sys-05 §17 — violence_blocked, self_harm_blocked, …, generic_safe']
  locale                   varchar(16)                [not null, note: 'BCP-47']
  age_band                 varchar(8)                 [not null, note: '4_5 | 6_8']
  status                   fallback_template_status   [not null, default: 'draft']
  version_no               integer                    [not null, default: 1]
  text_segment             text                       [not null, note: 'verbatim assistant response copy; sys-05 §4 calibrated to age band']
  render_plan              jsonb                      [note: 'optional renderPlan (baseScene + emotion) per sys-05 §11 output contract']
  motion_plan              jsonb                      [note: 'optional motionPlan (style + maxAmplitudePct)']
  expression_sync_hint     jsonb                      [note: 'optional pre-computed expression frames; orchestrator falls back to generated when absent']
  notes                    text
  created_by_admin_user_id uuid                       [note: 'cross-domain ref → AdminAuthService — Phase 3 reconciles']
  published_at             timestamptz                [note: 'set when status flips to published']
  retired_at               timestamptz
  created_at               timestamptz                [not null, default: `now()`]
  updated_at               timestamptz                [not null, default: `now()`]

  Indexes {
    (template_set, trigger_code, locale, age_band, status) [name: 'idx_fallback_templates_set_code_locale_age_status', note: 'hot query: docs/sequences/05-safety/fallback-selection.sequence.mmd — cascade lookup: exact match → broader age → generic_safe']
    (trigger_code, locale) [name: 'idx_fallback_templates_trigger_code_locale', note: 'hot query: docs/sequences/05-safety/fallback-selection.sequence.mmd — locale-scoped trigger code lookup when template_set unknown']
    (status, updated_at) [name: 'idx_fallback_templates_status_updated_at', note: 'hot query: docs/sequences/05-safety/policy-publish.sequence.mmd — admin diff between versions']
  }
}

// --- docs/erd/05-safety/safety_blocklist_entries.dbml ---
// safety_blocklist_entries — append-only catalog of blocklist patterns, grouped by version.
// Source: sys-05 §4 blocklist_versions DDL (per-version JSON), §8 blocklist categories + severity actions.
// The `blocklist_versions` row groups many entries; we expand the JSON blob into a relational table
// for queryability (which patterns matched? what category? which version published?). Append-only.

enum blocklist_severity {
  hard_block
  soft_block
  block_with_redirect
  family_configurable
}

enum blocklist_entry_origin {
  curated
  auto_promoted_from_event
  vendor_seed
}

Table safety_blocklist_entries {
  id                       uuid                    [pk]
  version_no               integer                 [not null, note: 'monotonic — increments on every publish; matches blocklist_versions.version']
  locale                   varchar(16)             [not null]
  category                 varchar(64)             [not null, note: 'violence | adult_content | self_harm | substance_use | horror_scary | bullying | dating_romance | profanity | medical_advice | politics | financial | religion_proselytizing']
  pattern                  text                    [not null, note: 'regex source — validated for catastrophic backtracking at publish time']
  pattern_sha256           varchar(64)             [not null, note: 'hash of (pattern, locale) — uniqueness primitive']
  severity                 blocklist_severity      [not null]
  redirect_category        varchar(64)             [note: 'when severity=block_with_redirect — names the redirect topic (e.g. medical → "ask a grown-up")']
  family_configurable_key  varchar(64)             [note: 'when severity=family_configurable — names the parent toggle (e.g. religion_proselytizing → families.controls.allow_religion)']
  max_pattern_steps        integer                 [not null, note: 'NFA worst-case steps against 10k-char adversarial input — sys-05 §4 publish gate']
  origin                   blocklist_entry_origin  [not null]
  notes                    text
  created_by_admin_user_id uuid                    [note: 'cross-domain ref → AdminAuthService — Phase 3 reconciles']
  published_at             timestamptz             [note: 'NULL until the parent blocklist_versions row is published']
  retired_at               timestamptz             [note: 'set when superseded by next version']
  created_at               timestamptz             [not null, default: `now()`]
  updated_at               timestamptz             [not null, default: `now()`]

  Indexes {
    (pattern_sha256, locale, version_no) [unique, name: 'idx_safety_blocklist_entries_pattern_locale_version_unique']
    (version_no, locale, category) [name: 'idx_safety_blocklist_entries_version_locale_category', note: 'hot query: docs/sequences/05-safety/input-filter.sequence.mmd — BlocklistCache loads all patterns for active version+locale at boot']
    (category, severity) [name: 'idx_safety_blocklist_entries_category_severity', note: 'hot query: docs/sequences/05-safety/input-filter.sequence.mmd — per-category severity stats + admin diff between versions']
    (retired_at) [name: 'idx_safety_blocklist_entries_retired_at']
  }
}

// No cross-domain FK on this side — created_by_admin_user_id is a cross-domain ref declared in
// 12-admin/admin_users.dbml (owning side) at Phase 3.

// --- docs/erd/05-safety/safety_events.dbml ---
// safety_events — append-only ledger of every input-blocked / output-blocked / PII-detected / severe-counter event.
// Source: sys-05 §4 schema (conversation_request_events conceptual table), §17 trigger codes, §20 alerts.
// Cross-system: feeds sys-12 SafetyInvestigationService, sys-11 telemetry, sys-10 parent notifications.

enum safety_event_type {
  input_blocklist_hit
  input_topic_classified
  input_pii_detected
  output_blocklist_hit
  output_pii_emitted
  output_fear_amplification
  output_age_inappropriate_vocabulary
  output_prompt_leakage
  output_response_too_long
  output_rewrite_attempted
  output_rewrite_failed
  final_gate_invalid_schema
  model_timeout
  model_malformed
  budget_exceeded
  severe_counter_increment
  red_team_regression_detected
}

enum safety_event_stage {
  input
  output
  final_gate
  governance
}

enum safety_event_severity {
  low
  medium
  high
  critical
}

Table safety_events {
  id                          uuid                   [pk]
  session_id                  uuid                   [note: 'cross-domain ref → RealtimeService.sessions — nullable for non-turn events (red-team, publish gates)']
  session_turn_id             uuid                   [note: 'cross-domain ref → RealtimeService.session_turns — nullable for non-turn events']
  child_profile_id            uuid                   [note: 'cross-domain ref → IdentityService.children — nullable but always present for live-turn events']
  household_id                uuid                   [note: 'cross-domain ref → IdentityService.households — denormalized for parent-summary lookups + severe counter']
  event_type                  safety_event_type      [not null]
  stage                       safety_event_stage     [not null]
  severity                    safety_event_severity  [not null]
  category                    varchar(64)            [note: 'e.g. violence | self_harm | pii_phone_us — see sys-05 §8 blocklist categories']
  confidence_pct              integer                [note: 'classifier confidence × 100 (0-100); avoids float per CONVENTIONS.md']
  trigger_code                varchar(64)            [note: 'sys-05 §17 fallback trigger code — links to fallback_templates lookup']
  transcript_hash             varchar(64)            [note: 'SHA-256 of transcript at event time — never raw text; correlates with session_transcripts.transcript_sha256']
  blocklist_version_id        uuid                   [note: 'cross-domain self-ref → safety_blocklist_entries version snapshot']
  safety_policy_version_id    uuid                   [note: 'snapshot of the safety_policy_versions row in effect; ref declared in safety_policy_versions when added in Phase 3']
  topic_id                    uuid                   [note: 'FK → safety_topics.id; nullable when not classifier-driven']
  fallback_template_id        uuid                   [note: 'FK → fallback_templates.id; nullable when no fallback emitted']
  detection_latency_ms        integer
  parent_alerted              boolean                [not null, default: false, note: 'true → sys-10 dispatched a parent notification']
  parent_alerted_at           timestamptz
  session_terminated          boolean                [not null, default: false, note: 'sys-04 force-close due to this event']
  instance_id                 varchar(64)
  created_at                  timestamptz            [not null, default: `now()`]
  updated_at                  timestamptz            [not null, default: `now()`]

  Indexes {
    (household_id, created_at) [name: 'idx_safety_events_household_id_created_at', note: 'hot query: docs/sequences/05-safety/safety-event-fanout.sequence.mmd — severe-counter 1h sliding window + parent-summary join']
    (child_profile_id, created_at) [name: 'idx_safety_events_child_profile_id_created_at', note: 'hot query: docs/sequences/12-admin/safety-investigation.sequence.mmd — per-child support timeline']
    (event_type, created_at) [name: 'idx_safety_events_event_type_created_at', note: 'hot query: docs/sequences/05-safety/safety-event-fanout.sequence.mmd — fanout subscribers filter by type']
    (severity, parent_alerted, created_at) [name: 'idx_safety_events_severity_parent_alerted_created_at', note: 'hot query: docs/sequences/10-notifications/safety-alert-dispatch.sequence.mmd — alert dispatcher selects high+critical un-alerted rows']
    (session_id) [name: 'idx_safety_events_session_id']
    (transcript_hash) [name: 'idx_safety_events_transcript_hash']
  }
}

Ref: safety_events.topic_id > safety_topics.id  // intra-domain
Ref: safety_events.fallback_template_id > fallback_templates.id  // intra-domain

// --- docs/erd/05-safety/safety_pii_redactions.dbml ---
// safety_pii_redactions — ledger of PII detection events: WHAT type + WHERE found, never the raw value.
// Source: sys-05 §9 PII Detection (10 types), §17 fallback codes (pii_blocked).
// COPPA P0 — child PII detection MUST log type+location but NEVER the raw matched substring.
// The matched substring exists only in session_transcripts (cleared at 24h by sys-04 retention sweep).

enum pii_type {
  phone_us
  phone_spelled
  email
  street_address
  zip_code
  school_name
  full_name_disclosure
  social_security
  ip_address
  credit_card
}

enum pii_disposition {
  blocked
  redacted_and_logged
  allowed_after_review
}

Table safety_pii_redactions {
  id                  uuid             [pk]
  safety_event_id     uuid             [not null, note: 'FK → safety_events.id — every detection produces both a safety_events row AND a redaction ledger row']
  session_id          uuid             [note: 'cross-domain ref → RealtimeService.sessions — denormalized for COPPA on-deletion sweep']
  session_turn_id     uuid             [note: 'cross-domain ref → RealtimeService.session_turns — denormalized for retention']
  child_profile_id    uuid             [note: 'cross-domain ref → IdentityService.children — denormalized for COPPA on-deletion sweep']
  household_id        uuid             [note: 'cross-domain ref → IdentityService.households']
  pii_type            pii_type         [not null]
  stage               varchar(16)      [not null, note: 'input | output — where PII was detected']
  disposition         pii_disposition  [not null]
  match_position      integer          [note: 'character offset into the transcript at detection time — useful for tooling but NEVER the matched text itself']
  match_length        integer          [note: 'length of the matched substring; combined with hash this lets investigation prove detection without ever surfacing PII']
  detection_pattern   varchar(64)      [note: 'opaque identifier of the regex/heuristic that matched — e.g. phone_us_v3 — NOT the regex itself']
  transcript_hash     varchar(64)      [not null, note: 'SHA-256 of transcript at detection time; correlates with session_transcripts.transcript_sha256']
  detection_latency_ms integer
  created_at          timestamptz      [not null, default: `now()`]
  updated_at          timestamptz      [not null, default: `now()`]
  purged_at           timestamptz      [note: 'set by RetentionWorker when row hard-cleared at 180d — soft marker for post-mortem aggregate reports']

  Indexes {
    (safety_event_id) [unique, name: 'idx_safety_pii_redactions_safety_event_id_unique']
    (household_id, created_at) [name: 'idx_safety_pii_redactions_household_id_created_at', note: 'hot query: docs/sequences/07-parent/parent-summary.sequence.mmd — weekly summary PII counter per household']
    (pii_type, created_at) [name: 'idx_safety_pii_redactions_pii_type_created_at', note: 'hot query: docs/sequences/05-safety/safety-event-fanout.sequence.mmd — type-rate dashboards']
    (child_profile_id, created_at) [name: 'idx_safety_pii_redactions_child_profile_id_created_at', note: 'hot query: docs/sequences/14-retention/account-deletion.sequence.mmd — COPPA on-deletion sweep filters by child']
  }
}

Ref: safety_pii_redactions.safety_event_id > safety_events.id  // intra-domain

// --- docs/erd/05-safety/safety_topics.dbml ---
// safety_topics — topic classifier output catalog used by TopicClassifier.
// DISTINCT from sys-06 content topics (taxonomy of curriculum tags) — these are unsafe-evasion topics:
// e.g. "violence_evasion", "self_harm_evasion". Cross-system collision pre-empted by name + folder.
// Source: sys-05 §13 topic classifier (4 example categories + cumulative-weight scoring).

enum safety_topic_severity {
  cautious
  sensitive
  blocked
  emergency
}

Table safety_topics {
  id                       uuid                    [pk]
  slug                     varchar(64)             [not null, note: 'machine identifier — e.g. violence_evasion']
  display_name             varchar(120)            [not null]
  description              text                    [not null]
  severity                 safety_topic_severity   [not null]
  classifier_threshold_pct integer                 [not null, note: 'cumulative weight ÷ 100 to trigger block (default 80 = 0.80) — avoids float per CONVENTIONS.md']
  required_keyword_count   integer                 [not null, default: 2, note: 'min keyword matches in input — sys-05 §13']
  keywords                 jsonb                   [not null, note: 'array of {token, weight}; document shape in sys-05 §13 — e.g. [{"token":"hurt","weight":40},{"token":"pain","weight":50}]']
  parent_alert_threshold   safety_topic_severity   [not null, default: 'blocked', note: 'min severity that triggers parent notification — emergency always alerts']
  fallback_trigger_code    varchar(64)             [not null, note: 'links to fallback_templates lookup — e.g. violence_blocked']
  retired_at               timestamptz
  created_at               timestamptz             [not null, default: `now()`]
  updated_at               timestamptz             [not null, default: `now()`]

  Indexes {
    (slug) [unique, name: 'idx_safety_topics_slug_unique']
    (severity, retired_at) [name: 'idx_safety_topics_severity_retired_at', note: 'hot query: docs/sequences/05-safety/input-filter.sequence.mmd — TopicClassifier loads all non-retired active rows at boot']
  }
}

// === 06-content ===
// --- docs/erd/06-content/activities.dbml ---
// activities — atomic activity inside a lesson. FK to lessons.
// Hierarchy: courses → levels → units → lessons → activities.
// Activities are the leaf delivery units resolved by the selection pipeline.

enum activity_status {
  draft
  active
  archived
}

enum activity_type {
  vocabulary
  comprehension
  pronunciation
  storytelling
  game
}

Table activities {
  id            uuid          [pk]
  lesson_id     uuid          [not null, note: 'FK → lessons.id']
  slug          varchar(64)   [not null]
  title         varchar(254)  [not null]
  activity_type activity_type [not null]
  position      smallint      [not null, note: 'display order within lesson; 1-based']
  payload       jsonb         [note: 'activity-type-specific config; shape documented per activity_type']
  status        activity_status [not null, default: 'draft']
  created_at    timestamptz   [not null, default: `now()`]
  updated_at    timestamptz   [not null, default: `now()`]

  Indexes {
    (lesson_id, position) [name: 'idx_activities_lesson_id_position', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — ordered activity listing within lesson']
    (lesson_id, slug) [unique, name: 'idx_activities_lesson_id_slug_unique']
    (activity_type, status) [name: 'idx_activities_type_status', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — filter by type + active']
  }
}

Ref: activities.lesson_id > lessons.id

// --- docs/erd/06-content/content_personalization_snapshots.dbml ---
// content_personalization_snapshots — per-child curated content retrieval snapshot.
// Versioned (snapshot_at); append-only. FK to children (cross-domain).
// COPPA: links to children → retention required.
// Source: docs/sequences/06-content/retrieval.sequence.mmd

Table content_personalization_snapshots {
  id                    uuid        [pk]
  child_id              uuid        [not null, note: 'cross-domain ref → IdentityService (children.id)']
  conversation_request_id uuid      [not null, note: 'dedup key per retrieval.sequence.mmd — ON CONFLICT DO NOTHING']
  snapshot_at           timestamptz [not null, note: 'moment this snapshot was assembled']
  traits_payload        jsonb       [note: 'up to 5 traits; blocked_realtime classification excluded']
  preferences_payload   jsonb       [note: 'up to 5 preferences']
  memories_payload      jsonb       [note: 'up to 3 approved+eligible child_memory_summaries']
  templates_payload     jsonb       [note: 'up to 5 content templates']
  retrieval_policy      varchar(64) [not null]
  trimmed               boolean     [not null, default: false, note: 'true when payload > 1800 chars was trimmed']
  degraded              boolean     [not null, default: false, note: 'true when Redis cooldown unavailable']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]
  deleted_at            timestamptz [note: 'soft-delete; COPPA retention']

  Indexes {
    (conversation_request_id) [unique, name: 'idx_content_personalization_snapshots_conv_req_unique']
    (child_id, snapshot_at) [name: 'idx_content_personalization_snapshots_child_snapshot', note: 'hot query: docs/sequences/06-content/retrieval.sequence.mmd — recent snapshot lookup by child']
  }
}

// Ref: content_personalization_snapshots.child_id > children.id  // cross-domain ref → IdentityService

// --- docs/erd/06-content/courses.dbml ---
// courses — top-level course in the TBOT content curriculum.
// Hierarchy root: courses → levels → units → lessons → activities.
// Source: docs/sequences/06-content/content-pack-publish.sequence.mmd

enum course_status {
  draft
  active
  archived
}

Table courses {
  id           uuid         [pk]
  slug         varchar(64)  [not null, note: 'machine-readable identifier; immutable after publish']
  title        varchar(254) [not null]
  locale       varchar(16)  [not null, note: 'BCP-47; e.g. en-US']
  age_band_min smallint     [not null, note: 'inclusive minimum age in months']
  age_band_max smallint     [not null, note: 'inclusive maximum age in months']
  status       course_status [not null, default: 'draft']
  description  text
  created_at   timestamptz  [not null, default: `now()`]
  updated_at   timestamptz  [not null, default: `now()`]

  Indexes {
    (slug) [unique, name: 'idx_courses_slug_unique']
    (locale, status) [name: 'idx_courses_locale_status', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — SELECT active courses by locale']
  }
}

// --- docs/erd/06-content/daily_summaries.dbml ---
// daily_summaries — derived daily engagement aggregate per (device, child).
// Derived from session_transcripts; rebuilt by SummaryWorker (sys-07 cron).
// COPPA: links to children → retention required.
// Upsert key: (device_id, child_profile_id, summary_date).
// Source: docs/sequences/07-parent/daily-summary-generation.sequence.mmd

Table daily_summaries {
  id                uuid    [pk]
  device_id         uuid    [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id  uuid    [not null, note: 'cross-domain ref → IdentityService (children.id)']
  summary_date      date    [not null, note: 'local date of the activity day; UTC stored']
  total_minutes     integer [not null, default: 0, note: 'session minutes summed for this day']
  activities_count  integer [not null, default: 0]
  words_introduced  integer [not null, default: 0]
  topics_covered    jsonb   [note: 'array of topic slugs covered during sessions this day']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  deleted_at        timestamptz [note: 'soft-delete; COPPA retention']

  Indexes {
    (device_id, child_profile_id, summary_date) [unique, name: 'idx_daily_summaries_device_child_date_unique']
    (child_profile_id, summary_date) [name: 'idx_daily_summaries_child_date', note: 'hot query: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd — SELECT daily_summaries WHERE summary_date IN week']
  }
}

// Ref: daily_summaries.device_id > devices.id        // cross-domain ref → DeviceService
// Ref: daily_summaries.child_profile_id > children.id // cross-domain ref → IdentityService

// --- docs/erd/06-content/lessons.dbml ---
// lessons — lesson inside a unit. FK to units.
// Hierarchy: courses → levels → units → lessons → activities.

enum lesson_status {
  draft
  active
  archived
}

Table lessons {
  id          uuid         [pk]
  unit_id     uuid         [not null, note: 'FK → units.id']
  slug        varchar(64)  [not null]
  title       varchar(254) [not null]
  position    smallint     [not null, note: 'display order within unit; 1-based']
  status      lesson_status [not null, default: 'draft']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Indexes {
    (unit_id, position) [name: 'idx_lessons_unit_id_position', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — ordered lesson listing within unit']
    (unit_id, slug) [unique, name: 'idx_lessons_unit_id_slug_unique']
  }
}

Ref: lessons.unit_id > units.id

// --- docs/erd/06-content/levels.dbml ---
// levels — level inside a course. FK to courses.
// Hierarchy: courses → levels → units → lessons → activities.

enum level_status {
  draft
  active
  archived
}

Table levels {
  id          uuid         [pk]
  course_id   uuid         [not null, note: 'FK → courses.id']
  slug        varchar(64)  [not null]
  title       varchar(254) [not null]
  position    smallint     [not null, note: 'display order within course; 1-based']
  status      level_status [not null, default: 'draft']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Indexes {
    (course_id, position) [name: 'idx_levels_course_id_position', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — ordered level listing within course']
    (course_id, slug) [unique, name: 'idx_levels_course_id_slug_unique']
  }
}

Ref: levels.course_id > courses.id

// --- docs/erd/06-content/topic_decay_state.dbml ---
// topic_decay_state — per-child topic engagement timer.
// DecayScheduler halves interaction_count weekly; deletes when < 1.
// COPPA: links to children → retention required.
// Source: docs/sequences/06-content/topic-decay.sequence.mmd

Table topic_decay_state {
  id                  uuid        [pk]
  child_id            uuid        [not null, note: 'cross-domain ref → IdentityService (children.id)']
  topic_id            uuid        [not null, note: 'FK → topics.id']
  interaction_count   integer     [not null, default: 0, note: 'halved weekly by DecayScheduler; row deleted when < 1']
  last_seen_at        timestamptz [not null, note: 'last interaction timestamp; used to gate decay (< now-30d)']
  created_at          timestamptz [not null, default: `now()`]
  updated_at          timestamptz [not null, default: `now()`]
  deleted_at          timestamptz [note: 'soft-delete; COPPA retention window']

  Indexes {
    (child_id, topic_id) [unique, name: 'idx_topic_decay_state_child_topic_unique']
    (child_id, last_seen_at) [name: 'idx_topic_decay_state_child_last_seen', note: 'hot query: docs/sequences/06-content/topic-decay.sequence.mmd — decay sweep WHERE last_interaction < now-30d']
  }
}

Ref: topic_decay_state.topic_id > topics.id
// Ref: topic_decay_state.child_id > children.id  // cross-domain ref → IdentityService

// --- docs/erd/06-content/topics.dbml ---
// topics — content topic taxonomy (sys-06).
// DISTINCT from safety_topics (sys-05, Lane D) — content topics are tagging/personalization labels,
// not classifier outputs. Do not merge.
// Source: docs/sequences/06-content/topic-decay.sequence.mmd

Table topics {
  id          uuid         [pk]
  slug        varchar(64)  [not null, note: 'machine-readable; e.g. animals, colors, numbers']
  label       varchar(254) [not null, note: 'human-readable display label']
  locale      varchar(16)  [not null, note: 'BCP-47']
  parent_id   uuid         [note: 'FK → topics.id; nullable for root-level topics (topic hierarchy)']
  created_at  timestamptz  [not null, default: `now()`]
  updated_at  timestamptz  [not null, default: `now()`]

  Indexes {
    (slug, locale) [unique, name: 'idx_topics_slug_locale_unique']
    (parent_id) [name: 'idx_topics_parent_id']
  }
}

Ref: topics.parent_id > topics.id

// --- docs/erd/06-content/units.dbml ---
// units — unit inside a level. FK to levels.
// Hierarchy: courses → levels → units → lessons → activities.

enum unit_status {
  draft
  active
  archived
}

Table units {
  id         uuid        [pk]
  level_id   uuid        [not null, note: 'FK → levels.id']
  slug       varchar(64) [not null]
  title      varchar(254) [not null]
  position   smallint    [not null, note: 'display order within level; 1-based']
  status     unit_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (level_id, position) [name: 'idx_units_level_id_position', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — ordered unit listing within level']
    (level_id, slug) [unique, name: 'idx_units_level_id_slug_unique']
  }
}

Ref: units.level_id > levels.id

// --- docs/erd/06-content/words.dbml ---
// words — vocabulary word taxonomy.
// Words may be associated with activities or lessons per delivery config.
// Source: docs/sequences/06-content/content-selection.sequence.mmd

Table words {
  id           uuid         [pk]
  activity_id  uuid         [note: 'FK → activities.id; nullable — word may be lesson-level']
  lesson_id    uuid         [note: 'FK → lessons.id; set when activity_id is null']
  word         varchar(254) [not null]
  locale       varchar(16)  [not null, note: 'BCP-47']
  phonetic     varchar(254) [note: 'IPA or phonetic spelling for TTS guidance']
  definition   text
  media_url    varchar(2048) [note: 'S3 URI for audio/image; not FK — resolved via media_assets in _shared']
  age_band_min smallint     [note: 'optional override; inherits from activity if null']
  created_at   timestamptz  [not null, default: `now()`]
  updated_at   timestamptz  [not null, default: `now()`]

  Indexes {
    (activity_id) [name: 'idx_words_activity_id']
    (lesson_id) [name: 'idx_words_lesson_id']
    (locale, word) [name: 'idx_words_locale_word', note: 'hot query: docs/sequences/06-content/content-selection.sequence.mmd — word lookup by locale']
  }
}

Ref: words.activity_id > activities.id
Ref: words.lesson_id > lessons.id

// === 07-parent ===
// --- docs/erd/07-parent/parent_controls.dbml ---
// parent_controls — per-device parental control settings with optimistic concurrency.
// Versioned via `version` for ETag/If-Match conflict detection.
// Source: docs/sequences/07-parent/controls-update.sequence.mmd
// Source: docs/sequences/07-parent/dst-rebuild.sequence.mmd

Table parent_controls {
  id                    uuid        [pk]
  device_id             uuid        [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  household_id          uuid        [not null, note: 'cross-domain ref → IdentityService (households.id)']
  daily_limit_minutes   smallint    [note: 'NULL = no limit; enforced by ConfigService']
  per_session_limit_min smallint    [note: 'NULL = no limit']
  quiet_hours_enabled   boolean     [not null, default: false]
  quiet_hours_start     time        [note: 'local time; NULL when quiet_hours_enabled=false']
  quiet_hours_end       time        [note: 'local time; NULL when quiet_hours_enabled=false']
  timezone              varchar(64) [not null, note: 'IANA timezone; used for DST rebuild in dst-rebuild.sequence.mmd']
  content_toggles       jsonb       [note: 'map of topic_slug → enabled boolean; governs content selection']
  version               integer     [not null, default: 0, note: 'optimistic concurrency counter; incremented on each PUT']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  Indexes {
    (device_id) [unique, name: 'idx_parent_controls_device_id_unique']
    (household_id) [name: 'idx_parent_controls_household_id']
    (quiet_hours_enabled, timezone) [name: 'idx_parent_controls_quiet_hours_tz', note: 'hot query: docs/sequences/07-parent/dst-rebuild.sequence.mmd — SELECT DISTINCT timezone WHERE quiet_hours_enabled=true']
  }
}

// Ref: parent_controls.device_id > devices.id        // cross-domain ref → DeviceService
// Ref: parent_controls.household_id > households.id  // cross-domain ref → IdentityService

// --- docs/erd/07-parent/parent_notifications_outbox.dbml ---
// parent_notifications_outbox — outbound notification events from sys-07 (ControlsService / SummaryWorker).
// DISTINCT from notification_dispatches (sys-10, Lane F) — this is the sys-07 producer outbox;
// sys-10 NotificationService reads from tbot-notifications SQS, not this table directly.
// COPPA: may contain child references → retention required.
// Source: docs/sequences/07-parent/daily-summary-generation.sequence.mmd
// Source: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd

enum parent_notification_status {
  pending
  enqueued
  failed
}

enum parent_notification_event_type {
  summary_daily_generated
  summary_weekly_generated
  cap_reached
  quiet_hours_enforced
}

Table parent_notifications_outbox {
  id              uuid                          [pk]
  device_id       uuid                          [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id uuid                         [note: 'cross-domain ref → IdentityService (children.id); nullable for device-level events']
  event_type      parent_notification_event_type [not null]
  payload         jsonb                         [not null, note: 'event-specific payload; e.g. {target_date, summaries_created}']
  status          parent_notification_status    [not null, default: 'pending']
  enqueued_at     timestamptz                   [note: 'set when SQS tbot-notifications enqueue succeeded']
  failed_reason   text                          [note: 'set on permanent failure']
  created_at      timestamptz                   [not null, default: `now()`]
  updated_at      timestamptz                   [not null, default: `now()`]
  deleted_at      timestamptz                   [note: 'soft-delete; COPPA retention when child_profile_id set']

  Indexes {
    (status, created_at) [name: 'idx_parent_notifications_outbox_status_created', note: 'hot query: docs/sequences/07-parent/daily-summary-generation.sequence.mmd — pending outbox sweep']
    (device_id, event_type, created_at) [name: 'idx_parent_notifications_outbox_device_event', note: 'hot query: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd — recent events by device']
  }
}

// Ref: parent_notifications_outbox.device_id > devices.id          // cross-domain ref → DeviceService
// Ref: parent_notifications_outbox.child_profile_id > children.id  // cross-domain ref → IdentityService

// --- docs/erd/07-parent/usage_caps.dbml ---
// usage_caps — per-child per-day runtime enforcement records.
// Tracks consumed minutes against parent_controls limits for real-time enforcement.
// COPPA: links to children → retention required.
// Source: docs/sequences/07-parent/controls-update.sequence.mmd

Table usage_caps {
  id                uuid        [pk]
  device_id         uuid        [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id  uuid        [not null, note: 'cross-domain ref → IdentityService (children.id)']
  cap_date          date        [not null, note: 'local calendar date of enforcement; UTC stored']
  consumed_minutes  integer     [not null, default: 0, note: 'minutes consumed so far this day']
  capped_at         timestamptz [note: 'set when daily limit reached; NULL while under cap']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  deleted_at        timestamptz [note: 'soft-delete; COPPA retention']

  Indexes {
    (device_id, child_profile_id, cap_date) [unique, name: 'idx_usage_caps_device_child_date_unique']
    (child_profile_id, cap_date) [name: 'idx_usage_caps_child_date', note: 'hot query: docs/sequences/07-parent/controls-update.sequence.mmd — check cap status at session start']
  }
}

// Ref: usage_caps.device_id > devices.id           // cross-domain ref → DeviceService
// Ref: usage_caps.child_profile_id > children.id   // cross-domain ref → IdentityService

// --- docs/erd/07-parent/weekly_summaries.dbml ---
// weekly_summaries — derived weekly engagement aggregate per (device, child).
// Derived from daily_summaries; rebuilt by SummaryWorker (sys-07 Monday cron).
// Upsert key: (device_id, child_profile_id, iso_week).
// COPPA: links to children → retention required.
// Source: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd

enum engagement_trend {
  increasing
  stable
  declining
}

Table weekly_summaries {
  id                  uuid             [pk]
  device_id           uuid             [not null, note: 'cross-domain ref → DeviceService (devices.id)']
  child_profile_id    uuid             [not null, note: 'cross-domain ref → IdentityService (children.id)']
  iso_week            varchar(8)       [not null, note: 'ISO 8601 week; format YYYY-Www e.g. 2026-W20']
  total_minutes       integer          [not null, default: 0, note: 'sum of daily_summaries.total_minutes for the week']
  activities_count    integer          [not null, default: 0]
  words_introduced    integer          [not null, default: 0]
  engagement_trend    engagement_trend [not null, default: 'stable', note: 'increasing if Δ ≥ +15%; declining if Δ ≤ -15%']
  topics_covered      jsonb            [note: 'array of topic slugs covered during the week']
  created_at          timestamptz      [not null, default: `now()`]
  updated_at          timestamptz      [not null, default: `now()`]
  deleted_at          timestamptz      [note: 'soft-delete; COPPA retention']

  Indexes {
    (device_id, child_profile_id, iso_week) [unique, name: 'idx_weekly_summaries_device_child_week_unique']
    (child_profile_id, iso_week) [name: 'idx_weekly_summaries_child_week', note: 'hot query: docs/sequences/07-parent/weekly-summary-generation.sequence.mmd — SELECT prev-week for trend delta']
  }
}

// Ref: weekly_summaries.device_id > devices.id           // cross-domain ref → DeviceService
// Ref: weekly_summaries.child_profile_id > children.id   // cross-domain ref → IdentityService

// === 08-config ===
// --- docs/erd/08-config/config_assignments.dbml ---
// config_assignments — device-to-cohort membership rows (the M:N junction).
// Spec calls these `fleet_cohort_memberships`. Required for "explicit membership"
// resolution path (first match wins, before criteria/default).
// Source: docs/site/software/systems/08-config-fleet-management.md §Fleet Cohort Resolution.

Table config_assignments {
  id                    uuid          [pk]
  cohort_id             uuid          [not null]
  device_id             uuid          [not null, note: 'cross-domain ref → DeviceService']
  config_version_id     uuid          [note: 'most recently issued version under this assignment; null until first assembly']
  assigned_at           timestamptz   [not null, default: `now()`]
  assigned_by           varchar(120)  [not null, note: 'admin email or system actor id']
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]

  Indexes {
    (cohort_id, device_id) [unique, name: 'idx_config_assignments_cohort_device_unique']
    (device_id, assigned_at) [name: 'idx_config_assignments_device_assigned', note: 'hot query: docs/sequences/08-config/assembly-and-signing.sequence.mmd — CohortResolver explicit-membership lookup']
  }
}

Ref: config_assignments.cohort_id > config_cohorts.id
Ref: config_assignments.config_version_id > config_versions.id

// --- docs/erd/08-config/config_cohorts.dbml ---
// config_cohorts — named device groups for targeting config templates.
// Spec calls these `fleet_cohorts`; ERD-level name `config_cohorts` per plan §3.
// Source: docs/site/software/systems/08-config-fleet-management.md §Fleet Cohort Resolution.

Table config_cohorts {
  id                  uuid          [pk]
  name                varchar(120)  [not null]
  description         text
  selection_criteria  jsonb         [not null, default: `'{}'::jsonb`, note: 'AND-joined keys per spec §Selection Criteria: hw_revision, fw_version_gte, fw_version_lt, household_country']
  template_id         uuid          [note: 'config template applied to members; null = inherits default template']
  is_default          boolean       [not null, default: false, note: 'exactly one default cohort must exist — partial unique index enforces']
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (name) [unique, name: 'idx_config_cohorts_name_unique']
    (is_default) [unique, name: 'idx_config_cohorts_single_default_unique', note: 'partial: WHERE is_default = true — at most one default cohort']
  }
}

// template_id is a forward ref to a sys-08 internal table `config_templates`;
// templates live in the same lane but are not part of plan §3 explicit manifest
// — they emerge from selection_criteria → template binding.
// Phase 3 may promote templates to their own entity file; for now this is a free
// FK kept as a comment (no Ref: line because no target table declared in this lane).

// --- docs/erd/08-config/config_documents.dbml ---
// config_documents — logical handle for the per-device runtime config blob.
// Spec calls the current row `device_configs` (1:1 with device); ERD-level name is
// `config_documents` per plan §3 manifest. `config_versions` carries the immutable
// version history (spec's `device_config_history`).
// Source: docs/site/software/systems/08-config-fleet-management.md §Data Model.

Table config_documents {
  id                  uuid          [pk]
  device_id           uuid          [not null, note: 'cross-domain ref → DeviceService']
  current_version_id  uuid          [note: 'points at active config_versions row; null only between assemble + first commit']
  schema_version      varchar(16)   [not null, default: '1.0', note: 'major.minor — device rejects unknown major']
  applied_at          timestamptz   [note: 'set by POST /v1/config/applied; null = not yet acked by device']
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (device_id) [unique, name: 'idx_config_documents_device_id_unique']
    (schema_version, updated_at) [name: 'idx_config_documents_schema_updated', note: 'hot query: docs/sequences/08-config/mqtt-push-and-fetch.sequence.mmd — fleet schema audit']
  }
}

// device_id FK is declared on the consuming side here (DeviceService owns devices).
// current_version_id FK is internal to 08-config so kept here.
Ref: config_documents.current_version_id > config_versions.id

// --- docs/erd/08-config/config_push_events.dbml ---
// config_push_events — MQTT push notification + HTTPS pull telemetry, per device.
// Each row records a single notify→fetch→apply lifecycle attempt. Used to drive
// `config_propagation_stale_count` reconciliation and the propagation-status admin view.
// Source: docs/site/software/systems/08-config-fleet-management.md §MQTT Integration
//         + Failure Modes (stale_count).

enum config_push_event_kind {
  notify_published
  notify_skipped_offline
  device_fetched
  device_applied
  device_rejected_signature
  reconciliation_repaired
}

Table config_push_events {
  id                uuid                       [pk]
  device_id         uuid                       [not null, note: 'cross-domain ref → DeviceService']
  document_id       uuid                       [not null]
  version_id        uuid                       [not null]
  event_kind        config_push_event_kind     [not null]
  mqtt_message_id   varchar(120)               [note: 'AWS IoT broker message id when event_kind=notify_published']
  fetch_correlation_id uuid                    [note: 'X-Request-Id from GET /v1/config/fetch — links notify→fetch']
  error_code        varchar(64)                [note: 'one of: mqtt_push_failure, signature_failure, transform_missing, etc.']
  error_detail      jsonb                      [not null, default: `'{}'::jsonb`]
  emitted_at        timestamptz                [not null, default: `now()`]
  created_at        timestamptz                [not null, default: `now()`]
  updated_at        timestamptz                [not null, default: `now()`]

  Indexes {
    (device_id, emitted_at) [name: 'idx_config_push_events_device_emitted', note: 'hot query: docs/sequences/08-config/mqtt-push-and-fetch.sequence.mmd — reconciliation job stale-device scan']
    (event_kind, emitted_at) [name: 'idx_config_push_events_kind_emitted', note: 'hot query: docs/sequences/08-config/mqtt-push-and-fetch.sequence.mmd — fleet-wide failure rate metric']
  }
}

Ref: config_push_events.document_id > config_documents.id
Ref: config_push_events.version_id > config_versions.id

// --- docs/erd/08-config/config_signing_keys.dbml ---
// config_signing_keys — metadata for KMS-backed ECDSA P-256 keys used to sign config
// blobs. The private material lives in AWS KMS; this table tracks the key's
// public-key bytes (for audit), KMS key ARN, lifecycle status, and rotation history.
// Source: docs/site/software/systems/08-config-fleet-management.md §KMS Key Rotation
//         + docs/sequences/08-config/kms-key-rotation-ceremony.sequence.mmd.

enum config_signing_key_status {
  active
  next
  decommissioning
  retired
}

Table config_signing_keys {
  id                  uuid                        [pk]
  kms_key_id          varchar(2048)               [not null, note: 'AWS KMS key ARN — cross-domain ref → SecurityService (sys-13 kms_keys)']
  public_key_pem      text                        [not null, note: 'ECDSA P-256 public key in PEM — embedded in firmware current_key / next_key slot']
  key_purpose         varchar(64)                 [not null, default: 'config_signing', note: 'separates from OTA signing key + per-device mTLS CA']
  status              config_signing_key_status   [not null, default: 'next']
  promoted_to_active_at  timestamptz              [note: 'set when Stage 3 of rotation flips CONFIG_SIGNING_KMS_KEY_ID to this row']
  retired_at          timestamptz                 [note: 'set when ScheduleKeyDeletion is queued in KMS']
  rotation_ceremony_ref text                      [note: 'free-form pointer at the ceremony audit row (sys-13)']
  created_at          timestamptz                 [not null, default: `now()`]
  updated_at          timestamptz                 [not null, default: `now()`]

  Indexes {
    (status, promoted_to_active_at) [name: 'idx_config_signing_keys_status_promoted', note: 'hot query: docs/sequences/08-config/kms-key-rotation-ceremony.sequence.mmd — find current active and next pending keys']
    (kms_key_id) [unique, name: 'idx_config_signing_keys_kms_key_id_unique']
  }
}

// --- docs/erd/08-config/config_versions.dbml ---
// config_versions — immutable, append-only audit trail of every config ever issued
// to every device. Spec calls this `device_config_history`. Append-only: no UPDATE,
// no DELETE except via sys-14 retention sweep when scoped device is deleted.
// Source: docs/site/software/systems/08-config-fleet-management.md §Data Model.

Table config_versions {
  id                uuid          [pk]
  document_id       uuid          [not null]
  device_id         uuid          [not null, note: 'cross-domain ref → DeviceService; denormalised for fast per-device history scan']
  config_version    integer       [not null, note: 'monotonic per device — UNIQUE(device_id, config_version)']
  schema_version    varchar(16)   [not null, note: 'major.minor at time of assembly']
  config_blob       jsonb         [not null, note: 'canonical-JSON serialisation max 8KB per ESP32 NVS constraint']
  config_signature  text          [not null, note: 'base64 ECDSA P-256 DER signature from ConfigSigner']
  signing_key_id    uuid          [not null]
  source_template_id uuid         [note: 'config_templates row used as base; nullable for emergency_override']
  cohort_id         uuid          [note: 'resolved cohort at assembly time; null if override path skipped cohort resolution']
  change_source     varchar(32)   [not null, default: 'template_update', note: 'initial_provision|parent_controls_changed|template_updated|cohort_membership_changed|admin_push|emergency_override|rollback']
  changed_fields    jsonb         [not null, default: `'[]'::jsonb`, note: 'array of dotted JSON paths mutated vs prior version']
  issued_at         timestamptz   [not null, default: `now()`]
  applied_at        timestamptz   [note: 'mirror of config_documents.applied_at at the time it was current']
  superseded_at     timestamptz   [note: 'set when newer config_versions row becomes current']
  created_at        timestamptz   [not null, default: `now()`]
  updated_at        timestamptz   [not null, default: `now()`]

  Indexes {
    (device_id, config_version) [unique, name: 'idx_config_versions_device_version_unique']
    (device_id, issued_at) [name: 'idx_config_versions_device_issued', note: 'hot query: docs/sequences/08-config/assembly-and-signing.sequence.mmd — per-device history scan']
    (signing_key_id, issued_at) [name: 'idx_config_versions_signing_key_issued', note: 'hot query: docs/sequences/08-config/kms-key-rotation-ceremony.sequence.mmd — find configs signed by a key being rotated']
  }
}

Ref: config_versions.document_id > config_documents.id
Ref: config_versions.signing_key_id > config_signing_keys.id

// === 09-ota ===
// --- docs/erd/09-ota/firmware_releases.dbml ---
// firmware_releases — canonical record of each firmware release artifact for TBot devices.
// Per sys-09 sequences: upload-and-signing, device-check-and-download, crash-rate-auto-pause.
// Note: ota_releases.dbml models the rollout-management side (cohort, rollout percentage,
// crash-rate pausing); firmware_releases models the artifact and signing provenance side.
// Both tables coexist; ota_releases.id optionally references firmware_releases for artifact lookup.
// Note: @timescaledb-hypertable is NOT applied here — firmware_releases is low-cardinality (O(100s) rows);
// hypertable is reserved for high-volume append-only tables (e.g. audit_logs, session_turns).

enum firmware_channel {
  stable
  beta
  canary
  factory
}

enum firmware_release_state {
  draft
  signed
  published
  paused
  rolled_back
  retired
}

Table firmware_releases {
  id                      uuid                    [pk, note: 'service-generated; never serial']
  version                 varchar(32)             [not null, note: 'SemVer string — e.g. "1.4.2"; unique per hardware_revision+channel']
  channel                 firmware_channel        [not null]
  hardware_revision       varchar(32)             [not null, note: 'target HW revision — e.g. "rev-c"; release is incompatible with other revisions']
  state                   firmware_release_state  [not null, default: 'draft']
  state_version           int                     [not null, default: 0, note: 'incremented on every state transition for optimistic concurrency']
  artifact_s3_uri         varchar(2048)           [not null, note: 'S3 URI of the signed firmware binary — immutable after state=signed']
  artifact_size_bytes     bigint                  [not null, note: 'byte count of artifact; validated by OtaService on download']
  signature_kms_key_arn   varchar(2048)           [not null, note: 'ARN of the KMS key used to sign the artifact']
  signature               bytea                   [not null, note: 'ECDSA P-256 DER signature over artifact SHA-256; device verifies before flash']
  release_notes_url       varchar(2048)           [note: 'URL to Markdown release notes for this version; NULL for factory/canary releases']
  rollout_percentage      int                     [not null, default: 0, note: 'monotonic 0→100; OtaService enforces staged-rollout steps 0/5/25/50/100']
  crash_threshold_ppm     int                     [not null, default: 5000, note: 'parts-per-million crash rate; CrashMonitorWorker sets state=paused when exceeded']
  auto_paused_at          timestamptz             [note: 'set by CrashMonitorWorker when crash_threshold_ppm exceeded']
  paused_reason           text                    [note: 'human-readable pause reason; set alongside auto_paused_at or by admin']
  published_at            timestamptz             [note: 'wall clock when state first entered published']
  created_at              timestamptz             [not null, default: `now()`]
  updated_at              timestamptz             [not null, default: `now()`]

  Indexes {
    (version, hardware_revision, channel) [unique, name: 'idx_firmware_releases_version_hw_channel_unique']
    (channel, state) [name: 'idx_firmware_releases_channel_published', note: 'hot query: docs/sequences/09-ota/device-check-and-download.sequence.mmd — find published release for channel+hw_rev WHERE state = published']
    (state, rollout_percentage) [name: 'idx_firmware_releases_state_rollout', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — active releases for crash monitor']
  }
}

// No cross-domain FKs — firmware_releases is self-contained within OtaService.
// KMS key ARN and S3 URI are string references to AWS resources, not DB FKs.

// --- docs/erd/09-ota/ota_assignments.dbml ---
// ota_assignments — per-device OTA attempt rows.
// Spec calls these `ota_attempts`; ERD-level name `ota_assignments` per plan §3.
// Captures every status transition from offered → success/failed/rollback/skipped,
// plus the eligibility-time snapshot of device telemetry that drove pre-flight checks.
// Source: docs/site/software/systems/09-ota-release-management.md §Data Model
//         + §OTA Attempt Status Transitions.

enum ota_assignment_status {
  offered
  downloading
  downloaded
  flashing
  verifying
  success
  failed
  rollback
  skipped
}

Table ota_assignments {
  id                          uuid                    [pk]
  device_id                   uuid                    [not null, note: 'cross-domain ref → DeviceService']
  release_id                  uuid                    [not null]
  from_version                varchar(64)             [not null]
  to_version                  varchar(64)             [not null]
  status                      ota_assignment_status   [not null, default: 'offered']
  failure_code                varchar(64)             [note: 'one of E-OTA-401..E-SAFE-901..902 etc.']
  failure_detail              jsonb                   [not null, default: `'{}'::jsonb`]
  ota_cohort_id               uuid                    [note: 'if release targeted an OTA-specific cohort, captured here at offer time']
  battery_percent_at_start    integer                 [note: 'snapshot at offer time — informs pre-flight gating']
  rssi_at_start               integer                 [note: 'snapshot dBm at offer time']
  download_duration_ms        integer                 [note: 'reported by device on POST /v1/ota/result']
  flash_duration_ms           integer                 [note: 'reported by device on POST /v1/ota/result']
  signed_url_expires_at       timestamptz             [note: 'CloudFront URL 1h expiry — surfaces signed_url_expired retry path']
  started_at                  timestamptz             [not null, default: `now()`]
  completed_at                timestamptz
  created_at                  timestamptz             [not null, default: `now()`]
  updated_at                  timestamptz             [not null, default: `now()`]

  Indexes {
    (release_id, status) [name: 'idx_ota_assignments_release_status', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — crash-rate trailing-hour query']
    (device_id, started_at) [name: 'idx_ota_assignments_device_started', note: 'hot query: docs/sequences/09-ota/device-check-and-download.sequence.mmd — stuck-device 7-day failure count']
    (release_id, completed_at) [name: 'idx_ota_assignments_release_completed', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — partial filter completed_at > NOW()-1h']
  }
}

Ref: ota_assignments.release_id > ota_releases.id
Ref: ota_assignments.ota_cohort_id > ota_cohorts.id

// --- docs/erd/09-ota/ota_cohorts.dbml ---
// ota_cohorts — OTA-specific cohort overlays.
// sys-08 `config_cohorts` is the cross-system primary cohort table; sys-09 may also
// stand up an OTA-only cohort (e.g. "canary devices for next firmware") that is
// not desirable to expose to config assembly. This entity captures that subset.
// Source: docs/site/software/systems/09-ota-release-management.md
//         §Deterministic Device Eligibility + cohort filtering on /v1/ota/check.

Table ota_cohorts {
  id                  uuid           [pk]
  name                varchar(120)   [not null]
  description         text
  base_cohort_id      uuid           [note: 'optional ref to sys-08 config_cohorts (cross-domain) — if set this OTA cohort is a subset of that fleet cohort']
  selection_criteria  jsonb          [not null, default: `'{}'::jsonb`, note: 'AND-joined keys hw_revision / fw_version_gte / fw_version_lt']
  canary_only         boolean        [not null, default: false, note: 'when true rollout cannot move beyond 25% without admin override']
  created_at          timestamptz    [not null, default: `now()`]
  updated_at          timestamptz    [not null, default: `now()`]

  Indexes {
    (name) [unique, name: 'idx_ota_cohorts_name_unique']
  }
}

// Ref: ota_cohorts.base_cohort_id > config_cohorts.id    // cross-domain ref → ConfigService (sys-08); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// --- docs/erd/09-ota/ota_crash_reports.dbml ---
// ota_crash_reports — device-emitted crash detail for the crash-rate auto-pause logic.
// Each row backs an `ota_assignments` row with `status IN ('failed','rollback')` and
// `failure_code IN ('E-SAFE-901','E-SAFE-902')`. CrashMonitorWorker uses this for
// per-incident triage; the trailing-hour aggregate is computed from ota_assignments.
// Source: docs/site/software/systems/09-ota-release-management.md §Crash Rate Monitoring.

Table ota_crash_reports {
  id                  uuid          [pk]
  assignment_id       uuid          [not null, note: 'one row per crash; back-reference to the ota_assignments row that recorded it']
  device_id           uuid          [not null, note: 'cross-domain ref → DeviceService — denormalised for crash-rate queries']
  release_id          uuid          [not null]
  failure_code        varchar(64)   [not null]
  stack_trace         text          [note: 'firmware panic trace if collected']
  heap_free_at_crash  integer
  uptime_seconds      integer
  reset_reason        varchar(64)   [note: 'esp_reset_reason() value']
  battery_percent     integer
  reported_at         timestamptz   [not null, default: `now()`]
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (release_id, reported_at) [name: 'idx_ota_crash_reports_release_reported', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — trailing-hour crash listing']
    (failure_code, reported_at) [name: 'idx_ota_crash_reports_code_reported', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — code-distribution for triage']
  }
}

Ref: ota_crash_reports.assignment_id > ota_assignments.id
Ref: ota_crash_reports.release_id > ota_releases.id

// --- docs/erd/09-ota/ota_pause_decisions.dbml ---
// ota_pause_decisions — append-only audit log of every rollout-lifecycle event.
// Spec calls these `ota_rollout_events`; ERD-level name `ota_pause_decisions` per
// plan §3 manifest (broader: covers all 9 event_type values, with pause decisions
// being the legally + operationally critical subset).
// Source: docs/site/software/systems/09-ota-release-management.md §Data Model.

enum ota_pause_decision_kind {
  created
  staged
  started
  percentage_increased
  paused_manual
  paused_auto
  resumed
  completed
  recalled
}

Table ota_pause_decisions {
  id                  uuid                       [pk]
  release_id          uuid                       [not null]
  decision_kind       ota_pause_decision_kind    [not null]
  details             jsonb                      [not null, default: `'{}'::jsonb`, note: 'crash_count, total_attempts, crash_rate, prior_percentage, new_percentage, etc.']
  decided_by          varchar(254)               [not null, note: 'admin email for manual events; system actor slug for auto events']
  admin_user_id       uuid                       [note: 'cross-domain ref → AdminAuthService (sys-12 admin_users) — set only when decision_kind in (paused_manual, resumed, recalled)']
  sns_message_id      varchar(120)               [note: 'SNS publish id for SEV-2/SEV-1 alerts']
  sns_severity        varchar(16)                [note: 'SEV-1 | SEV-2']
  created_at          timestamptz                [not null, default: `now()`]
  updated_at          timestamptz                [not null, default: `now()`]

  Indexes {
    (release_id, created_at) [name: 'idx_ota_pause_decisions_release_created', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — release lifecycle audit timeline']
    (decision_kind, created_at) [name: 'idx_ota_pause_decisions_kind_created', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — count paused_auto for SLA tracking']
  }
}

Ref: ota_pause_decisions.release_id > ota_releases.id
// admin_user_id cross-domain FK → AdminAuthService.admin_users (sys-12, Lane B) — declared on producer side (sys-12); no Ref: line here.

// --- docs/erd/09-ota/ota_releases.dbml ---
// ota_releases — canonical record of every firmware release uploaded by an admin.
// Spec calls this `firmware_releases`; ERD-level name `ota_releases` per plan §3.
// Carries the rich state machine: drafted → cohort_assigned → rolling_out → paused
//   → completed (terminal) | recalled (terminal).
// Source: docs/site/software/systems/09-ota-release-management.md §Data Model.

enum ota_release_status {
  drafted
  cohort_assigned
  rolling_out
  paused
  completed
  rolled_back
}

Table ota_releases {
  id                        uuid                  [pk]
  version                   varchar(64)           [not null, note: 'strict semver — unique fleet-wide']
  hw_revisions_supported    jsonb                 [not null, default: `'[]'::jsonb`, note: 'array of hw_revision strings the binary targets']
  binary_s3_key             varchar(2048)         [not null]
  binary_sha256             varchar(64)           [not null, note: 'hex of uncompressed binary; device verifies after download']
  binary_size_bytes         bigint                [not null, note: 'MAX_BINARY_SIZE = 32MB per ESP32 flash partition']
  manifest_json             jsonb                 [not null, note: 'signed manifest payload — keys sorted, no whitespace']
  manifest_signature        text                  [not null, note: 'base64 ECDSA P-256 DER over canonical manifest']
  release_notes             text
  status                    ota_release_status    [not null, default: 'drafted']
  rollout_percentage        integer               [not null, default: 0, note: 'monotonic — 0/5/25/50/100 per spec staged-rollout steps']
  rollout_cohort_id         uuid                  [note: 'cross-domain ref → ConfigService (sys-08 config_cohorts) — optional cohort filter on top of percentage gate']
  max_rollout_crash_rate    integer               [not null, default: 50, note: 'parts per thousand — default 50‰ = 5% per spec; integer avoids numeric/decimal/float ban']
  created_by                varchar(254)          [not null, note: 'admin email (sys-12)']
  released_at               timestamptz           [note: 'first time status entered rolling_out']
  paused_at                 timestamptz           [note: 'most recent paused_auto or paused_manual transition']
  completed_at              timestamptz           [note: 'set when status=completed at 100%']
  recalled_at               timestamptz           [note: 'set when status=rolled_back (SEV-1 path)']
  signing_key_id            uuid                  [note: 'OTA manifest signing key — separate from config_signing_keys (sys-08)']
  created_at                timestamptz           [not null, default: `now()`]
  updated_at                timestamptz           [not null, default: `now()`]

  Indexes {
    (version) [unique, name: 'idx_ota_releases_version_unique']
    (status, rollout_percentage) [name: 'idx_ota_releases_status_rollout', note: 'hot query: docs/sequences/09-ota/device-check-and-download.sequence.mmd — find active release for hw_rev']
    (rollout_cohort_id, status) [name: 'idx_ota_releases_cohort_status', note: 'hot query: docs/sequences/09-ota/crash-rate-auto-pause.sequence.mmd — cohort-filtered active releases']
  }
}

// Ref: ota_releases.rollout_cohort_id > config_cohorts.id    // cross-domain ref → ConfigService (sys-08); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// === 10-notifications ===
// --- docs/erd/10-notifications/email_sends.dbml ---
// email_sends — SES-channel detail rows.
// Spec keeps everything in notification_log; ERD-level decomposes to capture the
// SES-only fields (configuration set, region, list-unsubscribe URL, raw recipient
// fan-out) that don't fit cleanly on `notification_dispatches` and are useful for
// CAN-SPAM compliance + SES bounce-correlation independent of dispatch row lifecycle.
// Source: docs/site/software/systems/10-notification-delivery.md §Email Implementation.

Table email_sends {
  id                          uuid              [pk]
  dispatch_id                 uuid              [not null]
  from_address                varchar(254)      [not null, default: 'noreply@mail.tbot.com']
  reply_to_address            varchar(254)      [not null, default: 'support@tbot.com']
  to_address                  varchar(254)      [not null]
  subject_rendered            varchar(998)      [not null, note: 'rendered Handlebars subject (RFC 5322 max line length)']
  list_unsubscribe_url        varchar(2048)     [not null, note: 'CAN-SPAM one-click unsubscribe URL']
  ses_configuration_set       varchar(120)      [not null, default: 'tbot-notifications']
  ses_message_id              varchar(254)      [note: 'SES MessageId — null when send was suppressed pre-flight']
  ses_region                  varchar(32)       [not null, default: 'us-east-1']
  ses_send_attempt_count      integer           [not null, default: 0, note: 'incremented on each retry — ses_throttled / ses_rate_limit retryable errors']
  rendered_body_html_sha256   varchar(64)       [note: 'sha256 of final HTML body — supports legal audit of "what did parent actually receive"']
  rendered_body_text_sha256   varchar(64)       [note: 'sha256 of plaintext body']
  created_at                  timestamptz       [not null, default: `now()`]
  updated_at                  timestamptz       [not null, default: `now()`]

  Indexes {
    (dispatch_id) [unique, name: 'idx_email_sends_dispatch_id_unique']
    (ses_message_id) [name: 'idx_email_sends_ses_message_id', note: 'hot query: docs/sequences/10-notifications/ses-bounce-complaint-handling.sequence.mmd — webhook lookup']
  }
}

Ref: email_sends.dispatch_id > notification_dispatches.id

// --- docs/erd/10-notifications/notification_dispatches.dbml ---
// notification_dispatches — one row per (parent, channel, type) delivery attempt.
// Spec calls this `notification_log`. ERD-level name `notification_dispatches` per
// plan §3 + §13 anti-pattern note: avoids collision with sys-07 parent_notifications_outbox
// (Lane E) — see plan §13 "Naming improvements".
// Source: docs/site/software/systems/10-notification-delivery.md §Data Model.

enum notification_dispatch_status {
  queued
  sent
  delivered
  failed
  bounced
  suppressed
}

Table notification_dispatches {
  id                  uuid                              [pk]
  parent_account_id   uuid                              [not null, note: 'cross-domain ref → IdentityService (sys-01 users)']
  device_id           uuid                              [note: 'cross-domain ref → DeviceService — nullable for parent-scoped types']
  notification_type   varchar(64)                       [not null]
  channel             notification_channel              [not null]
  status              notification_dispatch_status      [not null, default: 'queued']
  idempotency_key     varchar(120)                      [note: 'caller-supplied — Redis 24h SET NX + DB unique index — drops duplicate SQS redeliveries']
  external_id         varchar(254)                      [note: 'FCM message_id or SES MessageId — populated on success']
  failure_reason      varchar(254)                      [note: 'short reason: token_invalid, ses_rejected, quiet_hours, throttle, email_disabled, etc.']
  suppression_reason  varchar(64)                       [note: 'when status=suppressed: throttle | preference | suppression_cooldown | email_disabled | quiet_hours']
  template_data_hash  varchar(64)                       [note: 'sha256 of rendered template input — for dedup of identical sends']
  scheduled_for       timestamptz                       [note: 'set when a send is deferred by timezone-aware scheduling (weekly_summary)']
  sent_at             timestamptz
  delivered_at        timestamptz                       [note: 'set by SES delivery webhook or FCM ack']
  created_at          timestamptz                       [not null, default: `now()`]
  updated_at          timestamptz                       [not null, default: `now()`]

  Indexes {
    (parent_account_id, created_at) [name: 'idx_notification_dispatches_parent_created', note: 'hot query: docs/sequences/10-notifications/sqs-worker-pipeline.sequence.mmd — per-parent timeline + dashboard']
    (idempotency_key) [unique, name: 'idx_notification_dispatches_idempotency_key_unique']
    (status, scheduled_for) [name: 'idx_notification_dispatches_status_scheduled', note: 'hot query: docs/sequences/10-notifications/sqs-worker-pipeline.sequence.mmd — find dispatches awaiting deferred send']
    (external_id) [name: 'idx_notification_dispatches_external_id', note: 'hot query: docs/sequences/10-notifications/ses-bounce-complaint-handling.sequence.mmd — webhook lookup by SES MessageId']
  }
}

// --- docs/erd/10-notifications/notification_receipts.dbml ---
// notification_receipts — inbound provider events (FCM ack, SES delivery, bounce, complaint).
// Tied 1:N to notification_dispatches; allows multiple status events per dispatch
// (e.g. sent → delivered → bounced when provider eventually rejects).
// Source: docs/site/software/systems/10-notification-delivery.md
//         §Bounce and Complaint Handling + §Push Implementation.

enum notification_receipt_kind {
  fcm_ack
  fcm_token_invalid
  fcm_failure
  ses_delivery
  ses_hard_bounce
  ses_soft_bounce
  ses_complaint
  ses_reject
}

Table notification_receipts {
  id                          uuid                          [pk]
  dispatch_id                 uuid                          [not null]
  receipt_kind                notification_receipt_kind     [not null]
  provider_event_id           varchar(254)                  [not null, note: 'SES MessageId or FCM correlation id — used for webhook idempotency dedup']
  provider_payload            jsonb                         [not null, default: `'{}'::jsonb`, note: 'raw provider event for forensic audit']
  bounce_subtype              varchar(64)                   [note: 'Permanent | Transient | Suppressed — only when receipt_kind=ses_hard_bounce/soft_bounce']
  received_at                 timestamptz                   [not null, default: `now()`]
  created_at                  timestamptz                   [not null, default: `now()`]
  updated_at                  timestamptz                   [not null, default: `now()`]

  Indexes {
    (provider_event_id) [unique, name: 'idx_notification_receipts_provider_event_id_unique']
    (dispatch_id, received_at) [name: 'idx_notification_receipts_dispatch_received', note: 'hot query: docs/sequences/10-notifications/ses-bounce-complaint-handling.sequence.mmd — chronological event audit per dispatch']
    (receipt_kind, received_at) [name: 'idx_notification_receipts_kind_received', note: 'hot query: docs/sequences/10-notifications/ses-bounce-complaint-handling.sequence.mmd — bounce-rate dashboards']
  }
}

Ref: notification_receipts.dispatch_id > notification_dispatches.id

// --- docs/erd/10-notifications/notification_templates.dbml ---
// notification_templates — Handlebars templates + per-type delivery configuration.
// One row per (notification_type, channel) — e.g. (safety_alert, push), (safety_alert, email).
// Carries throttle window, scope, suppression cooldown, and force-send flags.
// Source: docs/site/software/systems/10-notification-delivery.md
//         §Notification Type Configuration + §Push Templates / §Email Subjects.

enum notification_channel {
  push
  email
}

enum notification_scope {
  parent
  device
  household
}

Table notification_templates {
  id                          uuid                     [pk]
  notification_type           varchar(64)              [not null, note: 'one of welcome|password_reset|low_battery|device_offline|device_online|ota_available|ota_complete|safety_alert|weekly_summary|account_deletion_scheduled']
  channel                     notification_channel     [not null]
  scope                       notification_scope       [not null, default: 'parent']
  template_body               text                     [not null, note: 'Handlebars source — HTML for email channel + plaintext for push channel']
  template_subject            varchar(254)             [note: 'email subject Handlebars source; null for push']
  push_priority               varchar(16)              [note: 'fcm priority — high | normal — only when channel=push']
  android_channel             varchar(64)              [note: 'fcm android_channel — only when channel=push']
  throttle_window_seconds     integer                  [not null, default: 86400, note: '86400=24h; per spec §Notification Type Configuration table']
  throttle_limit              integer                  [not null, default: 1]
  suppression_cooldown_seconds integer                 [not null, default: 0, note: '4h=14400 for device alerts; 24h=86400 for safety_alert']
  force_send                  boolean                  [not null, default: false, note: 'transactional types: welcome, password_reset, account_deletion_scheduled; safety_alert is forced+undisableable']
  cannot_be_disabled          boolean                  [not null, default: false, note: 'true only for safety_alert — overrides per-parent preferences']
  active                      boolean                  [not null, default: true]
  created_at                  timestamptz              [not null, default: `now()`]
  updated_at                  timestamptz              [not null, default: `now()`]

  Indexes {
    (notification_type, channel) [unique, name: 'idx_notification_templates_type_channel_unique']
    (notification_type, active) [name: 'idx_notification_templates_type_active', note: 'hot query: docs/sequences/10-notifications/sqs-worker-pipeline.sequence.mmd — load type config']
  }
}

// --- docs/erd/10-notifications/push_tokens.dbml ---
// push_tokens — FCM (Android) / APNs (iOS) device tokens per user.
// One user may have many tokens (phone + tablet, app reinstalls); invalidated tokens
// remain rows but never receive sends. Spec stores a single token in
// notification_preferences.push_token; ERD-level decomposes into its own table for
// multi-device support and per-token lifecycle.
// Source: docs/site/software/systems/10-notification-delivery.md §Push Implementation (FCM)
//         + §Data Model preferences.push_token.

enum push_token_status {
  active
  invalidated
  revoked
}

enum push_token_platform {
  ios
  android
}

Table push_tokens {
  id              uuid                  [pk]
  user_id         uuid                  [not null, note: 'cross-domain ref → IdentityService (sys-01 users)']
  token           text                  [not null, note: 'opaque token from FCM HTTP v1 / APNs — never logged; treat as secret']
  platform        push_token_platform   [not null]
  app_version     varchar(64)
  device_label    varchar(120)          [note: 'iPhone 14, Pixel 8 etc. — for parent-facing device list']
  status          push_token_status     [not null, default: 'active']
  invalidated_at  timestamptz           [note: 'set when FCM returned token_invalid']
  last_used_at    timestamptz
  created_at      timestamptz           [not null, default: `now()`]
  updated_at      timestamptz           [not null, default: `now()`]

  Indexes {
    (user_id, status) [name: 'idx_push_tokens_user_status', note: 'hot query: docs/sequences/10-notifications/sqs-worker-pipeline.sequence.mmd — load active tokens for parent']
    (token) [unique, name: 'idx_push_tokens_token_unique']
  }
}

// === 11-telemetry ===
// --- docs/erd/11-telemetry/audit_events.dbml ---
// audit_events — append-only compliance audit log.
// Spec calls this `audit_log`. ERD-level name `audit_events` per plan §3.
// Polymorphic target reference: target_table varchar + target_id uuid — NO FK by
// design because audit_events points at rows in every lane, and a single FK can
// only target one table. Use case validates this: parent-deletion audit row needs
// to point at users (sys-01) on Monday and at children (sys-01) on Tuesday.
// Source: docs/site/software/systems/11-telemetry-audit-cost.md §Audit Log.

enum audit_actor_kind {
  parent
  admin
  system
  device
}

Table audit_events {
  id                uuid                 [pk]
  actor_kind        audit_actor_kind     [not null]
  actor_id          varchar(254)         [not null, note: 'free-form — user_id, admin_user_id, service-slug, device_id; not FK-constrained because polymorphic']
  action            varchar(120)         [not null, note: 'verb_noun — create_child_profile, update_controls, force_disconnect, etc.']
  target_table      varchar(64)          [not null, note: 'polymorphic — no FK by design; this column names the row''s domain entity']
  target_id         uuid                 [not null, note: 'polymorphic — no FK by design; pairs with target_table']
  details           jsonb                [not null, default: `'{}'::jsonb`, note: 'before/after diff, reason, request_id, etc.']
  ip_address        varchar(45)          [note: 'IPv4/IPv6 textual (varchar — not inet — for DBML portability)']
  user_agent        text
  request_id        varchar(64)          [note: 'gateway-issued request id for end-to-end tracing']
  created_at        timestamptz          [not null, default: `now()`]
  updated_at        timestamptz          [not null, default: `now()`]

  Indexes {
    (actor_kind, actor_id, created_at) [name: 'idx_audit_events_actor_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — per-actor audit drill-down']
    (target_table, target_id, created_at) [name: 'idx_audit_events_target_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — per-resource audit timeline']
    (action, created_at) [name: 'idx_audit_events_action_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — admin investigation by action verb']
  }
}

// --- docs/erd/11-telemetry/cost_attributions.dbml ---
// cost_attributions — per-session unit-economics breakdown.
// Spec calls this `cost_attribution`; ERD-level name `cost_attributions` for
// pluralisation consistency with neighbours.
// Polymorphic source: source_kind + source_id allow this row to attribute cost to a
// session OR to a non-session event (e.g. provider failover overhead, content prebuild).
// Source: docs/site/software/systems/11-telemetry-audit-cost.md §Cost Attribution.

enum cost_attribution_source_kind {
  session
  telemetry_event
  ota_assignment
  daily_aggregate
}

Table cost_attributions {
  id                  uuid                            [pk]
  source_kind         cost_attribution_source_kind    [not null, default: 'session']
  source_id           uuid                            [not null, note: 'polymorphic — no FK by design; pairs with source_kind. For session: sessions.id (sys-04); for telemetry_event: telemetry_events.id; for ota_assignment: ota_assignments.id']
  session_id          uuid                            [note: 'denormalised back-reference when source_kind=session — eases hot query path']
  device_id           uuid                            [not null, note: 'cross-domain ref → DeviceService']
  household_id        uuid                            [not null, note: 'cross-domain ref → IdentityService']
  attribution_date    timestamptz                     [not null, note: 'date for daily-aggregate join (UTC midnight start of day)']
  turn_count          integer                         [not null, default: 0]
  stt_cost_cents      bigint                          [not null, default: 0, note: 'money: bigint cents — per CONVENTIONS §5 (avoid numeric/decimal/float for money)']
  llm_cost_cents      bigint                          [not null, default: 0]
  tts_cost_cents      bigint                          [not null, default: 0]
  infra_cost_cents    bigint                          [not null, default: 0]
  total_cost_cents    bigint                          [not null, default: 0]
  rate_card_id        uuid                            [not null, note: 'pointer at the cost_rate_card row in effect at compute time — sys-11 internal table']
  computed_at         timestamptz                     [not null, default: `now()`]
  created_at          timestamptz                     [not null, default: `now()`]
  updated_at          timestamptz                     [not null, default: `now()`]

  Indexes {
    (source_kind, source_id) [unique, name: 'idx_cost_attributions_source_unique', note: 'spec §Cost Attribution Tables: UNIQUE(session_id) — generalised here to polymorphic source key']
    (device_id, attribution_date) [name: 'idx_cost_attributions_device_date', note: 'hot query: docs/sequences/11-telemetry/session-cost-attribution.sequence.mmd — daily aggregation']
    (household_id, attribution_date) [name: 'idx_cost_attributions_household_date', note: 'hot query: docs/sequences/11-telemetry/session-cost-attribution.sequence.mmd — top-N households dashboard']
  }
}

// --- docs/erd/11-telemetry/mutation_log.dbml ---
// mutation_log — append-only record of every backend mutation observed by the
// AuditBuffer middleware, BEFORE the buffered batch flushes to audit_events.
// Provides a recoverable journal in case audit_events INSERT path fails (the
// stdout JSON fallback in spec §Audit Log writes here too if Postgres is reachable
// but `audit_writer` role is denied).
// Source: docs/site/software/systems/11-telemetry-audit-cost.md §Audit Log §Write Path.

Table mutation_log {
  id              uuid          [pk]
  buffer_batch_id uuid          [not null, note: 'groups rows that were buffered together; correlates with the audit_events flush window']
  endpoint        varchar(254)  [not null, note: 'HTTP method + path — e.g. "POST /v1/households/:id/controls"']
  http_status_code integer      [not null, note: 'response status code returned to client']
  duration_ms     integer
  actor_id        varchar(254)  [not null]
  request_payload jsonb         [not null, default: `'{}'::jsonb`, note: 'sanitised — secrets / passwords scrubbed']
  response_summary jsonb        [not null, default: `'{}'::jsonb`]
  promoted_to_audit_event_id uuid [note: 'set when this mutation was successfully written to audit_events; null = not yet flushed or fallback path taken']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  Indexes {
    (buffer_batch_id, created_at) [name: 'idx_mutation_log_batch_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — group by buffer flush window']
    (actor_id, created_at) [name: 'idx_mutation_log_actor_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — per-actor mutation timeline']
    (promoted_to_audit_event_id) [name: 'idx_mutation_log_promoted', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — find unflushed mutations after recovery']
  }
}

// --- docs/erd/11-telemetry/telemetry_events.dbml ---
// telemetry_events — hot device telemetry pipeline.
// Hypertable: time-series store partitioned by created_at. Spec routes raw events
// through Firehose → S3 + Athena, but Postgres also carries a hypertable of the
// same shape for low-latency ops queries (health dashboards, support drill-down,
// alert evaluation). Source: spec §Telemetry Event Types + §Ingestion Pipeline.
// Hypertable: declared in Note — TimescaleDB extension materializes the partition
// scheme; retention frontmatter is 90d to match spec §Data Retention.

Table telemetry_events {
  id                  uuid          [pk, note: 'event_id from device payload — UUIDv4']
  device_id           uuid          [not null, note: 'cross-domain ref → DeviceService']
  child_id            uuid          [note: 'cross-domain ref → IdentityService — set only for child-scoped events (session.start/end/turn.latency); null for device.boot/health/error']
  session_id          uuid          [note: 'cross-domain ref → RealtimeService (sys-04 sessions) — set only for session-scoped events']
  event_type          varchar(64)   [not null, note: 'device.boot|device.wake|device.session.start|device.session.end|device.turn.latency|device.error|device.ota.result|device.health']
  payload             jsonb         [not null, default: `'{}'::jsonb`, note: 'event-type-specific keys — see spec §Telemetry Event Types']
  batch_id            uuid          [not null, note: 'idempotency key from POST /v1/telemetry/batch — Redis 24h SET NX dedupes across redelivery']
  client_timestamp_ms bigint        [not null, note: 'device-supplied epoch ms; server uses created_at for analytics to bypass clock skew']
  server_received_at  timestamptz   [not null, default: `now()`, note: 'server stamp at ingest — primary time partition column']
  sampling_rate       integer       [not null, default: 100, note: 'percentage — 10 for verbose turn.latency, 100 for everything else']
  pii_scan_passed     boolean       [not null, default: true, note: 'false rows never reach this table — kept as defensive marker']
  created_at          timestamptz   [not null, default: `now()`, note: '@timescaledb-hypertable column=created_at interval=1d']
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (device_id, created_at) [name: 'idx_telemetry_events_device_created', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — device health drill-down by support']
    (event_type, created_at) [name: 'idx_telemetry_events_type_created', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — error-rate dashboard']
    (session_id, created_at) [name: 'idx_telemetry_events_session_created', note: 'hot query: docs/sequences/11-telemetry/session-cost-attribution.sequence.mmd — per-session turn timing']
    (batch_id) [name: 'idx_telemetry_events_batch_id', note: 'hot query: docs/sequences/11-telemetry/device-batch-ingest.sequence.mmd — idempotency replay verification']
  }

  Note: '@timescaledb-hypertable column=created_at interval=1d'
}

// === 12-admin ===
// --- docs/erd/12-admin/admin_commands.dbml ---
// admin_commands — immutable audit log of every admin action.
// Source: docs/site/software/systems/12-support-admin-operations.md §3.1 admin_audit_log
// (ERD-level name is `admin_commands` per plan §3 manifest).
// Note: INSERT-only. Deletes only via retention worker after legal retention window.

Table admin_commands {
  id              uuid          [pk]
  admin_user_id   uuid          [not null]
  action          varchar(64)   [not null, note: 'enum-like at app layer: device.transfer, user.disable, safety.investigate, etc.']
  target_type     varchar(64)   [not null]
  target_id       varchar(120)  [not null]
  reason          text
  metadata        jsonb         [not null, default: `'{}'::jsonb`]
  ip_address      varchar(45)   [not null]
  occurred_at     timestamptz   [not null, default: `now()`]
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`, note: 'equal to created_at; row is immutable']

  Indexes {
    (admin_user_id) [name: 'idx_admin_commands_admin_user_id']
    (action) [name: 'idx_admin_commands_action']
    (target_type, target_id) [name: 'idx_admin_commands_target', note: 'hot query: docs/sequences/12-admin/safety-investigation-w2.sequence.mmd — list all admin actions against a device/household/user']
    (occurred_at) [name: 'idx_admin_commands_occurred_at_desc', note: 'hot query: docs/sequences/12-admin/mqtt-remote-command.sequence.mmd — recent-actions tail']
  }
}

Ref: admin_commands.admin_user_id > admin_users.id

// --- docs/erd/12-admin/admin_role_assignments.dbml ---
// admin_role_assignments — historical RBAC mapping for admin_users.
// Plan §3 manifest names this separately so role moves are auditable
// (spec embeds `role` column inline on admin_users; we lift it to a history table
//  while keeping `admin_users.current_role` resolvable via app-layer join on status=active).

enum admin_role_name {
  super_admin
  support_agent
  viewer
}

enum admin_role_assignment_status {
  active
  revoked
}

Table admin_role_assignments {
  id              uuid                            [pk]
  admin_user_id   uuid                            [not null]
  role            admin_role_name                 [not null]
  status          admin_role_assignment_status    [not null, default: 'active']
  granted_by_admin_id uuid                        [not null, note: 'self-ref into admin_users']
  granted_at      timestamptz                     [not null, default: `now()`]
  revoked_at      timestamptz
  reason          varchar(240)
  created_at      timestamptz                     [not null, default: `now()`]
  updated_at      timestamptz                     [not null, default: `now()`]

  Indexes {
    (admin_user_id, status) [name: 'idx_admin_role_assignments_user_status', note: 'hot query: docs/sequences/12-admin/login-and-mfa.sequence.mmd — admin auth middleware resolves current role on every request']
    (admin_user_id, role) [unique, name: 'idx_admin_role_assignments_user_role_unique', note: 'enforced when status=active via partial index in DDL emitter']
  }
}

Ref: admin_role_assignments.admin_user_id > admin_users.id
Ref: admin_role_assignments.granted_by_admin_id > admin_users.id

// --- docs/erd/12-admin/admin_sessions.dbml ---
// admin_sessions — admin session-token tracking (MFA-bound).
// Source: docs/site/software/systems/12-support-admin-operations.md §3.1 admin_sessions.

enum admin_session_status {
  active
  revoked
  expired
}

Table admin_sessions {
  id              uuid                    [pk]
  admin_user_id   uuid                    [not null]
  token_hash      varchar(128)            [not null]
  status          admin_session_status    [not null, default: 'active']
  ip_address      varchar(45)             [not null]
  user_agent      varchar(512)
  expires_at      timestamptz             [not null, note: 'admin sessions cap at 12h per spec §3 Session Rules']
  revoked_at      timestamptz
  revoke_reason   varchar(80)
  created_at      timestamptz             [not null, default: `now()`]
  updated_at      timestamptz             [not null, default: `now()`]

  Indexes {
    (token_hash) [unique, name: 'idx_admin_sessions_token_hash_unique']
    (admin_user_id, status) [name: 'idx_admin_sessions_admin_user_status', note: 'hot query: docs/sequences/12-admin/login-and-mfa.sequence.mmd — list active sessions for forced logout']
    (expires_at) [name: 'idx_admin_sessions_expires_at']
  }
}

Ref: admin_sessions.admin_user_id > admin_users.id

// --- docs/erd/12-admin/admin_users.dbml ---
// admin_users — internal admin identity (distinct from end-user `users` per plan Q-1).
// Source: docs/site/software/systems/12-support-admin-operations.md §3.1 admin_users.

enum admin_user_status {
  active
  disabled
}

Table admin_users {
  id              uuid                [pk]
  email           varchar(254)        [not null, note: 'corporate email; case-insensitive at app layer']
  password_hash   text                [not null]
  mfa_secret      varchar(256)        [note: 'encrypted via sys-13 KMS envelope; required when mfa_enabled=true']
  mfa_enabled     boolean             [not null, default: false]
  status          admin_user_status   [not null, default: 'active']
  last_login_at   timestamptz
  created_at      timestamptz         [not null, default: `now()`]
  updated_at      timestamptz         [not null, default: `now()`]

  Indexes {
    (email) [unique, name: 'idx_admin_users_email_unique']
    (status) [name: 'idx_admin_users_status']
  }
}

// --- docs/erd/12-admin/safety_investigations.dbml ---
// safety_investigations — admin-side case file for safety-filter misses.
// Source: docs/site/software/systems/12-support-admin-operations.md §3.1 safety_incidents.
// Plan §3 manifest names this `safety_investigations`.

enum safety_investigation_severity {
  low
  medium
  high
  critical
}

enum safety_investigation_status {
  open
  investigating
  resolved
  escalated
}

Table safety_investigations {
  id                       uuid                              [pk]
  device_id                uuid                              [not null, note: 'cross-domain ref → DeviceService (sys-02). Lane C owns devices.id']
  session_id               uuid                              [not null, note: 'cross-domain ref → RealtimeService (sys-04). Lane D owns sessions.id']
  turn_id                  uuid                              [note: 'cross-domain ref → RealtimeService (sys-04). Lane D owns session_turns.id']
  reported_by_admin_id     uuid                              [not null]
  severity                 safety_investigation_severity     [not null]
  status                   safety_investigation_status       [not null, default: 'open']
  description              text                              [not null]
  resolution               text
  escalated_to             varchar(120)
  metadata                 jsonb                             [not null, default: `'{}'::jsonb`]
  resolved_at              timestamptz
  created_at               timestamptz                       [not null, default: `now()`]
  updated_at               timestamptz                       [not null, default: `now()`]

  Indexes {
    (device_id) [name: 'idx_safety_investigations_device_id']
    (status) [name: 'idx_safety_investigations_status']
    (severity, created_at) [name: 'idx_safety_investigations_severity_created_at', note: 'hot query: docs/sequences/12-admin/safety-investigation-w2.sequence.mmd — open-critical triage queue']
  }
}

Ref: safety_investigations.reported_by_admin_id > admin_users.id
// Phase 3 adds cross-folder Refs:
//   safety_investigations.device_id   > devices.id          (Lane C)
//   safety_investigations.session_id  > sessions.id         (Lane D)
//   safety_investigations.turn_id     > session_turns.id    (Lane D)

// === 13-security ===
// --- docs/erd/13-security/brute_force_lockouts.dbml ---
// brute_force_lockouts — IP-level lockout records driven by BruteForceDetector.
// Source: docs/site/software/systems/13-security-secrets-management.md §3.1 ip_block_list.
// Plan §3 manifest names this `brute_force_lockouts`.

enum brute_force_lockout_status {
  active
  expired
  released_early
}

Table brute_force_lockouts {
  id                   uuid                          [pk]
  ip_address           varchar(45)                   [not null, note: 'string repr of INET; v6-capable']
  reason               varchar(120)                  [not null]
  status               brute_force_lockout_status    [not null, default: 'active']
  blocked_at           timestamptz                   [not null, default: `now()`]
  expires_at           timestamptz                   [not null]
  released_at          timestamptz
  released_by          varchar(120)                  [note: 'admin email or system identity']
  security_event_id    uuid                          [note: 'optional pointer to a security_events row when the lockout was triggered by an event']
  created_at           timestamptz                   [not null, default: `now()`]
  updated_at           timestamptz                   [not null, default: `now()`]

  Indexes {
    (ip_address, expires_at) [name: 'idx_brute_force_lockouts_ip_expires_at', note: 'hot query: docs/sequences/13-security/brute-force-detection-and-block.sequence.mmd — check if requesting IP is currently blocked']
    (expires_at) [name: 'idx_brute_force_lockouts_expires_at', note: 'partial-index condition: status=active (cron sweep)']
  }
}

// --- docs/erd/13-security/key_rotations.dbml ---
// key_rotations — immutable audit trail for every key / secret rotation ceremony.
// Source: docs/site/software/systems/13-security-secrets-management.md §3.1 key_rotation_log.

enum key_rotation_method {
  automated
  manual
  emergency
}

enum key_rotation_status {
  completed
  failed
  rolled_back
}

Table key_rotations {
  id                   uuid                  [pk]
  secret_name          varchar(120)          [not null]
  kms_key_id           uuid                  [note: 'when the rotation targets a kms_keys row; null for secret_versions-only rotations']
  rotation_method      key_rotation_method   [not null]
  status               key_rotation_status   [not null]
  rotated_by           varchar(120)          [not null, note: 'admin email or system identity']
  rotated_at           timestamptz           [not null]
  old_key_expiry       timestamptz
  new_key_active_at    timestamptz           [not null]
  notes                text
  created_at           timestamptz           [not null, default: `now()`]
  updated_at           timestamptz           [not null, default: `now()`, note: 'equal to created_at; row is immutable after insert']

  Indexes {
    (secret_name, rotated_at) [name: 'idx_key_rotations_secret_rotated_at', note: 'hot query: docs/sequences/13-security/ota-key-rotation-ceremony.sequence.mmd — latest rotation per secret']
    (status) [name: 'idx_key_rotations_status', note: 'partial-index condition: status != completed (open / failed monitor)']
  }
}

Ref: key_rotations.kms_key_id > kms_keys.id

// --- docs/erd/13-security/kms_keys.dbml ---
// kms_keys — metadata for KMS-backed keys used by the platform (envelope encryption,
// config signing, OTA signing, mTLS root). Key material lives in KMS / YubiHSM, never here.
// Source: docs/site/software/systems/13-security-secrets-management.md §3 / §6 rotation procedures.

enum kms_key_purpose {
  envelope
  config_signing
  ota_signing
  mtls_root
  jwt_signing
  webhook_signing
}

enum kms_key_status {
  active
  rotating
  retired
  compromised
}

Table kms_keys {
  id              uuid              [pk]
  alias           varchar(120)      [not null, note: 'human-readable identifier, e.g. "config-signing-2026-q2"']
  purpose         kms_key_purpose   [not null]
  status          kms_key_status    [not null, default: 'active']
  external_arn    varchar(512)      [not null, note: 'KMS / YubiHSM URI; opaque to app']
  algorithm       varchar(40)       [not null, note: 'e.g. AES_256_GCM, ECDSA_P384, ED25519']
  rotated_from_id uuid              [note: 'self-ref to previous version of same alias']
  activated_at    timestamptz       [not null]
  retired_at      timestamptz
  created_at      timestamptz       [not null, default: `now()`]
  updated_at      timestamptz       [not null, default: `now()`]

  Indexes {
    (alias) [unique, name: 'idx_kms_keys_alias_unique']
    (purpose, status) [name: 'idx_kms_keys_purpose_status', note: 'hot query: docs/sequences/13-security/secrets-cache-fetch.sequence.mmd — find active key by purpose']
  }
}

Ref: kms_keys.rotated_from_id > kms_keys.id

// --- docs/erd/13-security/mtls_certificates.dbml ---
// mtls_certificates — device mTLS certificate registry (fingerprint + lifecycle).
// Source: docs/site/software/systems/13-security-secrets-management.md §3.1 device_certificates + §7 cert lifecycle.
// Plan §3 manifest names this `mtls_certificates`.

enum mtls_certificate_status {
  provisioned
  active
  revoked
  expired
}

Table mtls_certificates {
  id                          uuid                       [pk]
  device_id                   uuid                       [not null, note: 'cross-domain ref → DeviceService (sys-02). Lane C owns devices.id']
  certificate_fingerprint     varchar(128)               [not null]
  status                      mtls_certificate_status    [not null, default: 'provisioned']
  issued_at                   timestamptz                [not null]
  expires_at                  timestamptz                [not null]
  first_seen_at               timestamptz                [note: 'set on first successful mTLS handshake — pinpoints provisioning → activation']
  revoked_at                  timestamptz
  revoke_reason               varchar(120)
  created_at                  timestamptz                [not null, default: `now()`]
  updated_at                  timestamptz                [not null, default: `now()`]

  Indexes {
    (certificate_fingerprint) [unique, name: 'idx_mtls_certificates_fingerprint_unique']
    (device_id, status) [name: 'idx_mtls_certificates_device_status', note: 'hot query: docs/sequences/13-security/cert-verification-and-revocation.sequence.mmd — list active certs per device']
    (expires_at) [name: 'idx_mtls_certificates_expires_at', note: 'partial-index condition: status=active (expiry sweeper)']
  }
}

// Phase 3 cross-folder ref: mtls_certificates.device_id > devices.id (Lane C)

// --- docs/erd/13-security/secret_versions.dbml ---
// secret_versions — version history for application-layer secrets (DB creds, API keys, webhook signing secrets, etc.).
// Distinct from kms_keys: kms_keys is hardware-managed material; secret_versions are
// envelope-encrypted blobs we store + cache for application bootstrap.

enum secret_version_status {
  pending
  active
  retired
  compromised
}

Table secret_versions {
  id              uuid                    [pk]
  secret_name     varchar(120)            [not null, note: 'logical name, e.g. "stripe.webhook.signing", "db.realtime.password"']
  version         integer                 [not null, note: 'monotonic per secret_name']
  status          secret_version_status   [not null, default: 'pending']
  envelope_kms_key_id uuid                [not null, note: 'kms_keys.id used to envelope-encrypt the ciphertext blob']
  ciphertext      text                    [not null, note: 'envelope-encrypted base64 blob; cleartext never persists']
  activated_at    timestamptz
  retired_at      timestamptz
  created_at      timestamptz             [not null, default: `now()`]
  updated_at      timestamptz             [not null, default: `now()`]

  Indexes {
    (secret_name, version) [unique, name: 'idx_secret_versions_name_version_unique']
    (secret_name, status) [name: 'idx_secret_versions_name_status', note: 'hot query: docs/sequences/13-security/secrets-cache-fetch.sequence.mmd — fetch active version on cache miss']
  }
}

Ref: secret_versions.envelope_kms_key_id > kms_keys.id

// === 14-retention ===
// --- docs/erd/14-retention/backup_snapshots.dbml ---
// backup_snapshots — registry of RDS automated snapshots + cross-region copies +
// data-export packages produced by COPPA right-of-access requests.
// Snapshots themselves live in AWS (RDS snapshot store + S3 export bucket);
// this table is the auditable manifest of what exists and when it expires.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Backup Strategy + §S3 (data export 7d).

enum backup_snapshot_kind {
  rds_automated
  rds_cross_region
  rds_manual
  s3_data_export
}

enum backup_snapshot_status {
  creating
  available
  expired
  deleted
}

Table backup_snapshots {
  id                  uuid                       [pk]
  kind                backup_snapshot_kind       [not null]
  rds_snapshot_id     varchar(254)               [note: 'AWS RDS snapshot ARN — null when kind=s3_data_export']
  s3_bucket           varchar(254)               [note: 'tbot-exports for kind=s3_data_export; null otherwise']
  s3_key              varchar(2048)              [note: 'object key inside s3_bucket']
  region              varchar(32)                [not null, default: 'us-east-1', note: 'us-east-1 primary; us-west-2 for cross-region copies']
  status              backup_snapshot_status     [not null, default: 'creating']
  size_bytes          bigint
  encryption_key_id   uuid                       [note: 'cross-domain ref → SecurityService (sys-13 kms_keys) — every snapshot encrypted at rest']
  scope_household_id  uuid                       [note: 'cross-domain ref → IdentityService — set only for COPPA right-of-access data export packages']
  data_export_request_id uuid                    [note: 'cross-domain ref → AccountDeletionService companion (DataExportService — sys-14 internal); set only for kind=s3_data_export']
  expires_at          timestamptz                [not null, note: '35d for rds_automated; 7d for rds_cross_region; 7d for s3_data_export']
  taken_at            timestamptz                [not null, default: `now()`]
  created_at          timestamptz                [not null, default: `now()`]
  updated_at          timestamptz                [not null, default: `now()`]

  Indexes {
    (kind, status, expires_at) [name: 'idx_backup_snapshots_kind_status_expires', note: 'hot query: docs/sequences/14-retention/cron-job-base-execution.sequence.mmd — sweep expired snapshots']
    (scope_household_id, taken_at) [name: 'idx_backup_snapshots_household_taken', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — data export delivery: find latest export per household']
  }
}

// --- docs/erd/14-retention/deletion_jobs.dbml ---
// deletion_jobs — per-household execution tracker for an active deletion request.
// One deletion_request may produce many deletion_jobs (one per owned household).
// Captures the explicit per-row execution log spec §Account Deletion Pipeline calls
// `execution_log JSONB` — promoted here to its own table for queryability.
// COPPA P0: legal record of HOW deletion executed. Status enum: requested →
// grace_period → executing → completed | failed.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Account Deletion Pipeline §Deletion Execution.

enum deletion_job_status {
  requested
  grace_period
  executing
  completed
  failed
}

Table deletion_jobs {
  id                  uuid                    [pk]
  deletion_request_id uuid                    [not null]
  household_id        uuid                    [note: 'cross-domain ref → IdentityService (sys-01 households) — set when scope_kind=parent_account; null for child_profile-scoped jobs']
  child_id            uuid                    [note: 'cross-domain ref → IdentityService (sys-01 children) — set when this job is the child-profile cascade']
  status              deletion_job_status     [not null, default: 'requested']
  execution_log       jsonb                   [not null, default: `'[]'::jsonb`, note: 'append-only array of {step, table, rows_affected, completed_at} per spec §Deletion Execution table']
  started_at          timestamptz
  completed_at        timestamptz
  error_message       text                    [note: 'set when status=failed; cleared on retry']
  retry_count         integer                 [not null, default: 0]
  created_at          timestamptz             [not null, default: `now()`]
  updated_at          timestamptz             [not null, default: `now()`]

  Indexes {
    (deletion_request_id, status) [name: 'idx_deletion_jobs_request_status', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — track per-household progress']
    (status, started_at) [name: 'idx_deletion_jobs_status_started', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — executor picks pending jobs']
  }
}

Ref: deletion_jobs.deletion_request_id > deletion_requests.id

// --- docs/erd/14-retention/deletion_requests.dbml ---
// deletion_requests — parent-initiated account-deletion lifecycle row.
// Spec calls this `account_deletion_requests`; ERD-level name `deletion_requests`
// per plan §3. COPPA P0: retains the legal proof that the right of deletion was
// exercised — MUST NEVER be hard-deleted (spec §"Never Delete Deletion Requests").
// Scope-anchor: a single deletion request may target a parent (user) OR an
// individual child profile. The scope is recorded in `scope_kind` + foreign refs.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Account Deletion Pipeline.

enum deletion_request_status {
  pending
  grace_period
  cancelled
  executing
  completed
  failed
}

enum deletion_request_scope {
  parent_account
  child_profile
}

Table deletion_requests {
  id                          uuid                       [pk]
  parent_account_id           uuid                       [not null, note: 'cross-domain ref → IdentityService (sys-01 users) — the requesting parent']
  child_id                    uuid                       [note: 'cross-domain ref → IdentityService (sys-01 children) — set only when scope_kind=child_profile']
  scope_kind                  deletion_request_scope     [not null, default: 'parent_account']
  requested_at                timestamptz                [not null]
  grace_period_ends_at        timestamptz                [not null, note: 'requested_at + 30 days per COPPA §312.10 "verifiable parental consent" tracked + GDPR §17 erasure window']
  cancelled_at                timestamptz
  executed_at                 timestamptz
  status                      deletion_request_status    [not null, default: 'pending']
  cancel_token_hash           varchar(120)               [note: 'sha256 of one-time cancel link signed token']
  original_email              varchar(254)               [note: 'preserved at request time for sending the completion confirmation post-anonymisation']
  request_ip                  varchar(45)
  request_user_agent          text
  created_at                  timestamptz                [not null, default: `now()`]
  updated_at                  timestamptz                [not null, default: `now()`]

  Indexes {
    (parent_account_id, status) [name: 'idx_deletion_requests_parent_status', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — check for existing active request per parent']
    (status, grace_period_ends_at) [name: 'idx_deletion_requests_status_grace', note: 'hot query: docs/sequences/14-retention/account-deletion-pipeline.sequence.mmd — executor finds eligible requests']
  }
}

// --- docs/erd/14-retention/retention_policies.dbml ---
// retention_policies — configuration-as-data row per entity that has a retention rule.
// Each row binds a target entity (table name) to its retention window + sweep cron
// + legal basis. RetentionWorker reads this table at startup; sys-11 retention_job_runs
// captures each execution.
// Source: docs/site/software/systems/14-data-retention-deletion-backup.md
//         §Retention Rules.

enum retention_method {
  hard_delete
  soft_delete
  redact_in_place
  s3_lifecycle
  hypertable_drop_chunks
}

Table retention_policies {
  id                    uuid                  [pk]
  target_table          varchar(64)           [not null, note: 'entity table name — references the ERD entity name; not FK-constrained because polymorphic across all lanes']
  retention_seconds     bigint                [not null, note: 'window in seconds; use bigint to fit 10-year windows comfortably']
  method                retention_method      [not null, default: 'hard_delete']
  cron_expression       varchar(120)          [not null, note: 'cron(MM 4 * * ? *) per spec §Cron Schedule Summary']
  batch_size            integer               [not null, default: 5000]
  max_iterations        integer               [not null, default: 100]
  yield_ms              integer               [not null, default: 100]
  legal_basis           varchar(254)          [note: 'free-form citation — e.g. "COPPA §312.10", "GDPR §17", "business need", "best practice"']
  active                boolean               [not null, default: true]
  created_at            timestamptz           [not null, default: `now()`]
  updated_at            timestamptz           [not null, default: `now()`]

  Indexes {
    (target_table) [unique, name: 'idx_retention_policies_target_table_unique']
    (active, cron_expression) [name: 'idx_retention_policies_active_cron', note: 'hot query: docs/sequences/14-retention/cron-job-base-execution.sequence.mmd — RetentionWorker startup load']
  }
}

// === 15-manufacturing ===
// --- docs/erd/15-manufacturing/factory_records.dbml ---
enum factory_record_result {
  pass
  fail
  quarantine
}

Table factory_records {
  id                uuid                  [pk, note: 'service-generated; never serial']
  device_id         uuid                  [note: 'ref → devices.id; null if backend registration failed (device still recorded)']
  serial_number     varchar(64)           [not null, note: 'format: TBT-YYYY-{6digits}; set from AT+SERIAL before backend registration']
  factory_batch_id  varchar(64)           [not null, note: 'batch identifier from tbot-provision CLI (e.g. B2026-042)']
  operator_id       varchar(64)           [not null, note: 'operator login or workstation credential used by FactoryCLI']
  workstation_id    varchar(64)           [not null, note: 'physical workstation or test jig identifier']
  hardware_revision varchar(32)           [not null]
  firmware_version  varchar(32)           [not null]
  overall_result    factory_record_result [not null]
  test_duration_ms  integer               [not null, note: 'total time for all test phases in ms']
  notes             text                  [note: 'operator free-text note on failure or quarantine; null on pass']
  created_at        timestamptz           [not null, default: `now()`]
  updated_at        timestamptz           [not null, default: `now()`]

  Indexes {
    (serial_number) [unique, name: 'uq_factory_records_serial_number', note: 'one factory record per serial; re-runs replace this record']
    (factory_batch_id) [name: 'idx_factory_records_factory_batch_id', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — batch summary report']
    (overall_result, created_at) [name: 'idx_factory_records_result_created_at', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — yield / failure rate']
    (device_id) [name: 'idx_factory_records_device_id']
  }
}

// device_id is nullable (backend register may fail post-test); ref only declared when non-null in practice
// Ref: factory_records.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// --- docs/erd/15-manufacturing/factory_serial_assignments.dbml ---
Table factory_serial_assignments {
  id                uuid        [pk, note: 'service-generated; never serial']
  serial_number     varchar(64) [not null, note: 'format: TBT-YYYY-{6digits}; globally unique across all batches']
  factory_batch_id  varchar(64) [not null, note: 'batch this serial was allocated to (e.g. B2026-042)']
  device_id         uuid        [note: 'ref → devices.id; set after backend registration succeeds; null until then']
  allocated_at      timestamptz [not null, default: `now()`, note: 'when FactoryCLI assigned this serial to a physical unit']
  registered_at     timestamptz [note: 'when backend registration (POST /v1/devices/register) succeeded; null until then']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]

  Indexes {
    (serial_number) [unique, name: 'uq_factory_serial_assignments_serial_number', note: 'globally unique serial registry — single source of truth for serial allocation']
    (factory_batch_id) [name: 'idx_factory_serial_assignments_factory_batch_id', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — batch inventory audit']
    (device_id) [name: 'idx_factory_serial_assignments_device_id']
  }
}

// Ref: factory_serial_assignments.device_id > devices.id   // cross-domain ref → DeviceService (sys-02); documented in _shared/cross-domain-data-flow.md per Phase 3 decision

// --- docs/erd/15-manufacturing/factory_test_results.dbml ---
enum test_result_value {
  pass
  fail
  skip
}

Table factory_test_results {
  id                uuid              [pk, note: 'service-generated; never serial']
  factory_record_id uuid              [not null, note: 'ref → factory_records.id']
  serial_number     varchar(64)       [not null, note: 'denormalized from factory_records for query convenience; format: TBT-YYYY-{6digits}']
  test_name         varchar(64)       [not null, note: 'e.g. mic_snr, speaker_spl, servo, display, wifi, ble, battery, nvs, flash, heap, thermal']
  result            test_result_value [not null]
  measured_value    text              [note: 'raw measured value string (numeric or enum) from AT+TEST_{name} response']
  pass_threshold    text              [note: 'pass criteria string applied at test time; stored for auditability']
  is_critical       boolean           [not null, default: true, note: 'critical=true — single failure halts batch; false — warn only']
  duration_ms       integer           [note: 'time to execute this test in ms']
  created_at        timestamptz       [not null, default: `now()`]
  updated_at        timestamptz       [not null, default: `now()`]

  Indexes {
    (factory_record_id) [name: 'idx_factory_test_results_factory_record_id', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — fetch all tests for a run']
    (serial_number, test_name) [name: 'idx_factory_test_results_serial_name', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — per-test yield analysis']
    (test_name, result) [name: 'idx_factory_test_results_test_name_result', note: 'hot query: docs/sequences/15-manufacturing/factory-provision-and-test.sequence.mmd — failure rate by test type']
  }
}

Ref: factory_test_results.factory_record_id > factory_records.id

// === 17-gateway ===
// --- docs/erd/17-gateway/api_keys.dbml ---
// api_keys.dbml — device-bearer or admin-bearer API keys for machine-to-machine auth

enum api_key_type {
  device_bearer
  admin_bearer
}

Table api_keys {
  id              uuid          [pk, note: 'service-generated; never serial']
  key_hash        varchar(64)   [not null, unique, note: 'SHA-256 of the raw API key; raw key never stored']
  key_prefix      varchar(8)    [not null, note: 'first 8 chars of raw key for identification in logs (non-secret)']
  type            api_key_type  [not null]
  owner_id        uuid          [not null, note: 'UUID of owning entity — device UUID if type=device_bearer, admin_user UUID if type=admin_bearer']
  description     varchar(255)
  last_used_at    timestamptz
  expires_at      timestamptz   [note: 'null = no expiry; device keys typically long-lived']
  revoked_at      timestamptz
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  Indexes {
    (key_hash) [unique, name: 'idx_api_keys_key_hash_unique']
    (owner_id, type) [name: 'idx_api_keys_owner_id_type', note: 'hot query: docs/sequences/19-billing/entitlement-check-session-start.sequence.mmd — list keys by owner for rotation']
    (type, revoked_at) [name: 'idx_api_keys_type_revoked_at', note: 'hot query: docs/sequences/19-billing/entitlement-check-session-start.sequence.mmd — filter active keys by type for auth resolution']
  }
}
// cross-domain ref: owner_id → devices.id when type = device_bearer (DeviceService)
//                  owner_id → admin_users.id when type = admin_bearer (AdminAuthService)

// --- docs/erd/17-gateway/rate_limit_buckets.dbml ---
// rate_limit_buckets.dbml — time-windowed counter for gateway rate limiting

enum rate_limit_subject_kind {
  user
  device
  ip_address
  api_key
}

Table rate_limit_buckets {
  id            uuid                      [pk, note: 'service-generated; never serial']
  subject_kind  rate_limit_subject_kind   [not null]
  subject_id    varchar(128)              [not null, note: 'user UUID, device UUID, hashed IP, or api_key UUID — must match subject_kind']
  window_start  timestamptz               [not null, note: 'start of the time window (e.g. floor(now() to 1min)']
  window_size_s int                       [not null, default: 60, note: 'window duration in seconds']
  request_count int                       [not null, default: 0]
  limit_value   int                       [not null, note: 'maximum requests allowed in this window']
  created_at    timestamptz               [not null, default: `now()`]
  updated_at    timestamptz               [not null, default: `now()`]

  Indexes {
    (subject_kind, subject_id, window_start) [unique, name: 'idx_rate_limit_buckets_subject_window_unique', note: 'hot query: docs/sequences/17-gateway/rate-limiting.sequence.mmd — one row per subject per window']
    (window_start) [name: 'idx_rate_limit_buckets_window_start', note: 'hot query: docs/sequences/17-gateway/rate-limiting.sequence.mmd']
  }

  Note: '@timescaledb-hypertable(column=window_start, interval=\'1h\') — high write volume; row count: requests_per_second * unique_subjects. Rows expire after retention window (default 24h).'
}

// === 18-wire-protocol ===
// --- docs/erd/18-wire-protocol/wire-protocol-domain-types.dbml ---
// wire-protocol-domain-types.dbml — shared enum/type declarations for the TBOT wire protocol.
// NO Table blocks. These types are referenced by name across multiple domain DBML files.
// See docs/erd/18-wire-protocol/README.md for usage rules.

// Connection and session transport

enum ws_close_code {
  normal_closure          // 4000 — clean session end
  entitlement_required    // 4002 — subscription expired or inactive
  auth_invalid            // 4003 — JWT invalid or expired
  rate_limited            // 4004 — too many active sessions
  server_error            // 4005 — internal error
  protocol_error          // 4006 — client sent unexpected frame
}

// Session lifecycle shared types

enum session_turn_role {
  child
  assistant
}

enum transcript_segment_kind {
  speech
  intent
  safety_event
  system_annotation
}

// Safety and content classification

enum safety_severity {
  low
  medium
  high
  critical
}

enum safety_action {
  allow
  redact
  block
  escalate
}

// OTA and config delivery

enum delivery_channel {
  push_ota
  pull_config
  mqtt_command
  webhook
}

// Billing and entitlement wire types

enum billing_tier {
  free
  plus
  enterprise
}

enum entitlement_source {
  stripe_subscription
  promotional
  trial
  admin_override
}

// Device capability flags (shared across device and wire protocol)

enum device_capability {
  voice_input
  servo_face
  led_ring
  proximity_sensor
  touch_sensor
  wifi_only
  wifi_plus_ble
}

// Notification channels (shared across sys-07 and sys-10)

enum notification_channel {
  push_apns
  push_fcm
  email_ses
  sms_sns
}

// === 19-billing ===
// --- docs/erd/19-billing/entitlements.dbml ---
// entitlements.dbml — per-child content access derived from household subscription

Table entitlements {
  id              uuid        [pk, note: 'service-generated; never serial']
  child_id        uuid        [not null, note: 'cross-domain ref → IdentityService (children table)']
  subscription_id uuid        [not null, note: 'FK → subscriptions.id']
  tier            varchar(64) [not null, note: 'plan tier slug e.g. "plus", "free"']
  features        jsonb       [note: 'feature flags granted to this child; subset of subscription_plans.features']
  valid_from      timestamptz [not null]
  valid_until     timestamptz [not null, note: 'mirrors subscriptions.current_period_end; refreshed on renewal']
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  Indexes {
    (child_id, valid_until) [name: 'idx_entitlements_child_id_valid_until', note: 'hot query: docs/sequences/19-billing/entitlement-check-session-start.sequence.mmd']
    (subscription_id) [name: 'idx_entitlements_subscription_id']
  }
}

Ref: entitlements.subscription_id > subscriptions.id
// Ref: entitlements.child_id > children.id    // cross-domain ref → IdentityService

// --- docs/erd/19-billing/invoices.dbml ---
// invoices.dbml — immutable billing record per billing period

enum invoice_status {
  draft
  open
  paid
  void
  uncollectible
}

Table invoices {
  id                  uuid            [pk, note: 'service-generated; never serial']
  stripe_invoice_id   varchar(255)    [not null, unique, note: 'Stripe Invoice object ID (in_...)']
  stripe_customer_id  uuid            [not null, note: 'FK → stripe_customers.id']
  subscription_id     uuid            [not null, note: 'FK → subscriptions.id']
  amount_due_cents    bigint          [not null, note: 'money: bigint cents only']
  amount_paid_cents   bigint          [not null, default: 0, note: 'money: bigint cents only']
  currency            varchar(3)      [not null, default: 'usd']
  status              invoice_status  [not null, default: 'draft']
  period_start        timestamptz     [not null]
  period_end          timestamptz     [not null]
  paid_at             timestamptz
  created_at          timestamptz     [not null, default: `now()`]
  updated_at          timestamptz     [not null, default: `now()`]

  Indexes {
    (stripe_invoice_id) [unique, name: 'idx_invoices_stripe_invoice_id_unique']
    (stripe_customer_id, status) [name: 'idx_invoices_stripe_customer_id_status', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd']
    (subscription_id) [name: 'idx_invoices_subscription_id']
  }
}

Ref: invoices.stripe_customer_id > stripe_customers.id
Ref: invoices.subscription_id > subscriptions.id

// --- docs/erd/19-billing/order_items.dbml ---
// order_items.dbml — line items within a one-time order

Table order_items {
  id                uuid        [pk, note: 'service-generated; never serial']
  order_id          uuid        [not null, note: 'FK → orders.id']
  product_sku       varchar(64) [not null, note: 'internal SKU or Stripe Price ID for the item']
  description       varchar(255) [not null]
  quantity          int         [not null, default: 1]
  unit_price_cents  bigint      [not null, note: 'money: bigint cents only; price at time of purchase — immutable after order placed']
  currency          varchar(3)  [not null, default: 'usd']
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]

  Indexes {
    (order_id) [name: 'idx_order_items_order_id']
  }
}

Ref: order_items.order_id > orders.id

// --- docs/erd/19-billing/orders.dbml ---
// orders — one-time purchase orders for hardware or digital add-ons.
// Per P3.C billing work. Distinct from recurring subscriptions.
// Lifecycle: created → paid → fulfilling → shipped → arrived → activated (terminal)
//            ↘ cancelled (terminal) | refunded (terminal)

enum order_state {
  created
  paid
  fulfilling
  shipped
  arrived
  activated
  cancelled
  refunded
}

Table orders {
  id                            uuid         [pk, note: 'service-generated; never serial']
  user_id                       uuid         [not null, note: 'cross-domain ref → IdentityService — parent placing the order']
  sku_id                        varchar(64)  [not null, note: 'product SKU identifier; resolved against product catalog at order time']
  quantity                      int          [not null, default: 1, note: 'must be ≥ 1; validated at app layer']
  amount_cents                  bigint       [not null, note: 'money: bigint cents; total charged to card = sku_unit_price_cents × quantity']
  currency                      varchar(3)   [not null, default: 'USD', note: 'ISO 4217 — uppercase; BillingService validates against supported list']
  state                         order_state  [not null, default: 'created']
  state_version                 int          [not null, default: 0, note: 'incremented on every state transition for optimistic concurrency']
  stripe_checkout_session_id    varchar(255) [note: 'Stripe Checkout Session id (cs_...) — set at order creation; NULL for orders created outside Checkout flow']
  stripe_payment_intent_id      varchar(255) [note: 'Stripe PaymentIntent id (pi_...); set on payment confirmation']
  shipping_address              jsonb        [note: 'snapshot of shipping address at order time — shape: {line1,line2?,city,state,postal_code,country}; NULL for digital-only orders']
  tracking_number               varchar(64)  [note: 'carrier tracking number; set when state=shipped']
  paid_at                       timestamptz  [note: 'set when state transitions to paid']
  shipped_at                    timestamptz  [note: 'set when state transitions to shipped']
  cancelled_at                  timestamptz  [note: 'set when state transitions to cancelled']
  created_at                    timestamptz  [not null, default: `now()`]
  updated_at                    timestamptz  [not null, default: `now()`]

  Indexes {
    (user_id, created_at) [name: 'idx_orders_user_created', note: 'hot query: docs/sequences/19-billing/checkout-initiate-mobile.sequence.mmd — order history for parent']
    (state, created_at) [name: 'idx_orders_state_active', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd — active orders sweep WHERE state IN (created,paid,fulfilling,shipped); partial index in migration, DBML cannot express partial predicate natively']
    (stripe_payment_intent_id) [unique, name: 'idx_orders_stripe_payment_intent_id_unique']
    (stripe_checkout_session_id) [name: 'idx_orders_stripe_checkout_session_id', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd — checkout.session.completed webhook lookup']
  }
}

Ref: orders.user_id > users.id    // cross-domain ref → IdentityService

// --- docs/erd/19-billing/stripe_customers.dbml ---
// stripe_customers.dbml — Stripe customer record bridging users to Stripe

Table stripe_customers {
  id                  uuid          [pk, note: 'service-generated; never serial']
  user_id             uuid          [not null, unique, note: 'cross-domain ref → IdentityService; one user → one stripe_customer']
  stripe_customer_id  varchar(255)  [not null, unique, note: 'Stripe Customer object ID (cus_...)']
  email               varchar(254)  [not null, note: 'email at time of Stripe customer creation; may drift from users.email']
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (user_id) [unique, name: 'idx_stripe_customers_user_id_unique']
    (stripe_customer_id) [unique, name: 'idx_stripe_customers_stripe_customer_id_unique']
  }
}

// cross-domain ref — BillingService owns this; consuming side (IdentityService) carries user_id column only
// Ref: stripe_customers.user_id > users.id    // cross-domain ref → IdentityService

// --- docs/erd/19-billing/stripe_webhook_events.dbml ---
// stripe_webhook_events.dbml — idempotency log for Stripe webhook ingestion

enum stripe_webhook_event_status {
  received
  processed
  failed
}

Table stripe_webhook_events {
  id                  uuid                          [pk, note: 'service-generated; never serial']
  stripe_event_id     varchar(255)                  [not null, unique, note: 'Stripe Event ID (evt_...) — idempotency key per Stripe spec']
  event_type          varchar(128)                  [not null, note: 'e.g. customer.subscription.updated, invoice.payment_failed']
  processing_status   stripe_webhook_event_status   [not null, default: 'received']
  payload_hash        varchar(64)                   [note: 'SHA-256 of raw payload — for integrity audit']
  attempts            int                           [not null, default: 0]
  processed_at        timestamptz
  failed_reason       text
  created_at          timestamptz                   [not null, default: `now()`]
  updated_at          timestamptz                   [not null, default: `now()`]

  Indexes {
    (stripe_event_id) [unique, name: 'idx_stripe_webhook_events_stripe_event_id_unique']
    (processing_status, created_at) [name: 'idx_stripe_webhook_events_status_created_at', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd']
  }

  Note: 'retention: 1 year minimum for financial audit. Stripe retries events up to 3x — stripe_event_id PK conflict signals duplicate; return 200 without reprocessing.'
}

// --- docs/erd/19-billing/subscription_plans.dbml ---
// subscription_plans.dbml — billing tier catalog

enum subscription_plan_interval {
  monthly
  annual
}

Table subscription_plans {
  id                    uuid          [pk, note: 'service-generated; never serial']
  stripe_price_id       varchar(255)  [not null, unique, note: 'Stripe Price object ID — used for checkout and upgrade']
  stripe_product_id     varchar(255)  [not null, note: 'Stripe Product object ID']
  name                  varchar(128)  [not null, note: 'e.g. TBOT Plus Monthly']
  interval              subscription_plan_interval [not null]
  amount_cents          bigint        [not null, note: 'money: bigint cents only']
  currency              varchar(3)    [not null, default: 'usd', note: 'ISO 4217 three-letter code']
  max_child_profiles    int           [not null, default: 1]
  daily_turn_limit      int           [not null, default: -1, note: '-1 means unlimited']
  daily_session_limit   int           [not null, default: -1, note: '-1 means unlimited']
  features              jsonb         [note: 'feature flags included in this plan; shape: {key: boolean}']
  active                boolean       [not null, default: true, note: 'false = hidden from new signups; existing subs continue']
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]

  Indexes {
    (stripe_price_id) [unique, name: 'idx_subscription_plans_stripe_price_id_unique']
    (active) [name: 'idx_subscription_plans_active']
  }
}

// --- docs/erd/19-billing/subscriptions.dbml ---
// subscriptions.dbml — recurring access entitlement per household

enum subscription_status {
  trialing
  active
  past_due
  canceled
  expired
}

Table subscriptions {
  id                    uuid                [pk, note: 'service-generated; never serial']
  household_id          uuid                [not null, note: 'cross-domain ref → IdentityService']
  stripe_customer_id    uuid                [not null, note: 'FK → stripe_customers.id']
  plan_id               uuid                [not null, note: 'FK → subscription_plans.id']
  stripe_subscription_id varchar(255)       [unique, note: 'Stripe Subscription object ID (sub_...) — null before first payment']
  status                subscription_status [not null, default: 'trialing']
  trial_ends_at         timestamptz
  current_period_start  timestamptz         [not null]
  current_period_end    timestamptz         [not null]
  canceled_at           timestamptz
  cancel_at_period_end  boolean             [not null, default: false]
  created_at            timestamptz         [not null, default: `now()`]
  updated_at            timestamptz         [not null, default: `now()`]

  Indexes {
    (household_id, status) [name: 'idx_subscriptions_household_id_status', note: 'hot query: docs/sequences/19-billing/entitlement-check-session-start.sequence.mmd']
    (stripe_subscription_id) [unique, name: 'idx_subscriptions_stripe_subscription_id_unique']
    (stripe_customer_id) [name: 'idx_subscriptions_stripe_customer_id']
  }
}

Ref: subscriptions.stripe_customer_id > stripe_customers.id
Ref: subscriptions.plan_id > subscription_plans.id
// Ref: subscriptions.household_id > households.id    // cross-domain ref → IdentityService

// === 20-authoring ===
// --- docs/erd/20-authoring/content_drafts.dbml ---
// content_drafts — working draft for a content template in the authoring workflow.
// Append-only versioning via content_revisions. Draft is the parent record.
// Source: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd

enum content_draft_status {
  draft
  safety_screening
  in_review
  changes_requested
  approved
  published
  archived
}

Table content_drafts {
  id              uuid                [pk]
  author_id       uuid                [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id)']
  title           varchar(254)        [not null]
  template_text   text                [not null, note: 'main template text; 10-500 chars enforced in app']
  variation_instruction text          [note: 'optional LLM variation hint; 10-300 chars enforced in app']
  age_bands       jsonb               [not null, note: 'array of age band identifiers; ≥1 required']
  category        varchar(64)         [not null]
  locale          varchar(16)         [not null, note: 'BCP-47']
  tags            jsonb               [note: 'array of topic slugs; ≤10 tags enforced in app']
  status          content_draft_status [not null, default: 'draft']
  current_version smallint            [not null, default: 1, note: 'points to latest content_revisions.version_no']
  created_at      timestamptz         [not null, default: `now()`]
  updated_at      timestamptz         [not null, default: `now()`]

  Indexes {
    (author_id, status) [name: 'idx_content_drafts_author_status', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — author dashboard listing']
    (status, created_at) [name: 'idx_content_drafts_status_created', note: 'hot query: docs/sequences/20-authoring/publish-to-system06.sequence.mmd — SELECT WHERE status=approved for pack assembly']
  }
}

// Ref: content_drafts.author_id > admin_users.id  // cross-domain ref → AdminAuthService

// --- docs/erd/20-authoring/content_revisions.dbml ---
// content_revisions — append-only immutable version history for content_drafts.
// Each submit-for-review creates a new revision row. No UPDATE on payload.
// Source: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd

Table content_revisions {
  id                    uuid        [pk]
  draft_id              uuid        [not null, note: 'FK → content_drafts.id']
  version_no            smallint    [not null, note: 'monotonically increasing per draft; 1-based']
  author_id             uuid        [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id)']
  template_text         text        [not null, note: 'immutable snapshot of content_drafts.template_text at submission']
  variation_instruction text        [note: 'immutable snapshot at submission']
  age_bands             jsonb       [not null, note: 'immutable snapshot at submission']
  category              varchar(64) [not null]
  locale                varchar(16) [not null, note: 'BCP-47']
  tags                  jsonb       [note: 'immutable snapshot at submission']
  created_at            timestamptz [not null, default: `now()`]
  updated_at            timestamptz [not null, default: `now()`]

  Indexes {
    (draft_id, version_no) [unique, name: 'idx_content_revisions_draft_version_unique']
    (draft_id) [name: 'idx_content_revisions_draft_id', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — load revisions by draft']
  }
}

Ref: content_revisions.draft_id > content_drafts.id
// Ref: content_revisions.author_id > admin_users.id  // cross-domain ref → AdminAuthService

// --- docs/erd/20-authoring/publication_records.dbml ---
// publication_records — immutable record of a content pack publication event.
// FK to content_revisions (the specific version published) + admin_users (publisher).
// Source: docs/sequences/20-authoring/publish-to-system06.sequence.mmd

enum publication_status {
  pending
  published
  failed
  cancelled
  rolled_back
}

Table publication_records {
  id                uuid               [pk]
  draft_id          uuid               [not null, note: 'FK → content_drafts.id; denormalized for query convenience']
  revision_no       smallint           [not null, note: 'content_revisions.version_no that was published']
  publisher_id      uuid               [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id); requires content_admin role']
  pack_id           varchar(64)        [not null, note: 'content-addressable pack hash assembled by PublishOrchestrator']
  s3_url            varchar(2048)      [note: 'S3 URI of uploaded content pack; set on successful upload']
  schedule_id       uuid               [note: 'FK → ca_publish_schedules.id; null for immediate publish']
  status            publication_status [not null, default: 'pending']
  published_at      timestamptz        [note: 'set when ContentService (sys-06) accepts the pack']
  failed_reason     text               [note: 'set on failure']
  created_at        timestamptz        [not null, default: `now()`]
  updated_at        timestamptz        [not null, default: `now()`]

  Indexes {
    (pack_id) [unique, name: 'idx_publication_records_pack_id_unique']
    (draft_id, revision_no) [name: 'idx_publication_records_draft_revision', note: 'hot query: docs/sequences/20-authoring/publish-to-system06.sequence.mmd — load publication history for a specific revision']
    (status, created_at) [name: 'idx_publication_records_status_created', note: 'hot query: docs/sequences/20-authoring/publish-to-system06.sequence.mmd — pending publication sweep']
  }
}

Ref: publication_records.draft_id > content_drafts.id
// Ref: publication_records.publisher_id > admin_users.id  // cross-domain ref → AdminAuthService
// publication_records.schedule_id ref deferred to Phase 3 — ca_publish_schedules defined in same folder

// --- docs/erd/20-authoring/review_assignments.dbml ---
// review_assignments — assignment of a content draft revision to a human reviewer.
// reviewer_id is a cross-domain FK to admin_users (Lane B, AdminAuthService).
// Source: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd

enum review_assignment_status {
  pending
  in_progress
  completed
  reassigned
}

Table review_assignments {
  id             uuid                    [pk]
  draft_id       uuid                    [not null, note: 'FK → content_drafts.id']
  revision_no    smallint                [not null, note: 'revision version being reviewed; matches content_revisions.version_no']
  reviewer_id    uuid                    [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id)']
  status         review_assignment_status [not null, default: 'pending']
  assigned_at    timestamptz             [not null, default: `now()`]
  completed_at   timestamptz             [note: 'set when reviewer submits decision']
  created_at     timestamptz             [not null, default: `now()`]
  updated_at     timestamptz             [not null, default: `now()`]

  Indexes {
    (reviewer_id, status) [name: 'idx_review_assignments_reviewer_status', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — reviewer queue listing']
    (draft_id, revision_no) [name: 'idx_review_assignments_draft_revision', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — load assignment for a specific draft revision']
  }
}

Ref: review_assignments.draft_id > content_drafts.id
// Ref: review_assignments.reviewer_id > admin_users.id  // cross-domain ref → AdminAuthService

// --- docs/erd/20-authoring/review_decisions.dbml ---
// review_decisions — immutable record of a reviewer's decision on a revision.
// Append-only: one row per (assignment_id) — no UPDATE after creation.
// Source: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd

enum review_decision_outcome {
  approved
  changes_requested
}

Table review_decisions {
  id                uuid                  [pk]
  assignment_id     uuid                  [not null, note: 'FK → review_assignments.id']
  reviewer_id       uuid                  [not null, note: 'cross-domain ref → AdminAuthService (admin_users.id); denormalized for audit']
  draft_id          uuid                  [not null, note: 'FK → content_drafts.id; denormalized for query convenience']
  revision_no       smallint              [not null]
  outcome           review_decision_outcome [not null]
  feedback          text                  [note: 'required when outcome=changes_requested']
  quality_score     smallint              [note: 'advisory score from ca-quality-score job; NULL if timed out']
  decided_at        timestamptz           [not null, default: `now()`]
  created_at        timestamptz           [not null, default: `now()`]
  updated_at        timestamptz           [not null, default: `now()`]

  Indexes {
    (assignment_id) [unique, name: 'idx_review_decisions_assignment_id_unique']
    (draft_id, decided_at) [name: 'idx_review_decisions_draft_decided', note: 'hot query: docs/sequences/20-authoring/template-safety-screen-to-publish.sequence.mmd — decision history for draft']
  }
}

Ref: review_decisions.assignment_id > review_assignments.id
Ref: review_decisions.draft_id > content_drafts.id
// Ref: review_decisions.reviewer_id > admin_users.id  // cross-domain ref → AdminAuthService

// === 22-demo ===
// --- docs/erd/22-demo/demo_devices.dbml ---
// demo_devices.dbml — scratch device records for retail demo mode; no PII

Table demo_devices {
  id              uuid          [pk, note: 'service-generated; never serial']
  serial_number   varchar(64)   [not null, unique, note: 'physical device serial; no PII']
  device_id       uuid          [note: 'nullable cross-domain ref → DeviceService (devices table); null if demo device not yet paired to a production device row']
  demo_enabled    boolean       [not null, default: true, note: 'false = demo mode disabled on this unit']
  retail_location varchar(128)  [note: 'store or display location description; no PII']
  demo_content_version varchar(64) [note: 'content manifest version flashed to this device']
  last_seen_at    timestamptz
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  Indexes {
    (serial_number) [unique, name: 'idx_demo_devices_serial_number_unique']
    (demo_enabled) [name: 'idx_demo_devices_demo_enabled']
  }
}

// Ref: demo_devices.device_id > devices.id    // cross-domain ref → DeviceService (nullable)

// --- docs/erd/22-demo/demo_session_overrides.dbml ---
// demo_session_overrides.dbml — short-lived per-session config overrides for retail demo; 24h retention

Table demo_session_overrides {
  id              uuid          [pk, note: 'service-generated; never serial']
  demo_device_id  uuid          [not null, note: 'FK → demo_devices.id']
  interaction_id  varchar(64)   [not null, note: 'interaction slot identifier from demo content manifest']
  override_data   jsonb         [not null, note: 'shape: {script?: [...], persona?: string, language?: string}']
  expires_at      timestamptz   [not null, note: 'max 24h from creation; session-scoped']
  created_at      timestamptz   [not null, default: `now()`]
  updated_at      timestamptz   [not null, default: `now()`]

  Indexes {
    (demo_device_id, expires_at) [name: 'idx_demo_session_overrides_device_id_expires_at', note: 'hot query: docs/sequences/22-demo/retail-loop-attract-to-conversation.sequence.mmd']
  }

  Note: 'retention: 24h or session-scoped. DemoCLI sweeps rows where expires_at < now() on next boot.'
}

Ref: demo_session_overrides.demo_device_id > demo_devices.id

// === _shared ===
// --- docs/erd/_shared/audit_log.dbml ---
// audit_log — platform-wide mutation + admin-action audit ledger.
// Distinct from admin_commands (sys-12 admin-only) and audit_events (sys-11 telemetry-side).
// audit_log captures actor + target + action for every privileged write across all services.
//
// Polymorphic target: target_table + target_id intentionally NOT FK-constrained —
// FKs to 95+ tables across the platform are infeasible. App-layer convention validates
// target_table against the known table allow-list at write time.

enum audit_log_result {
  success
  failure
  partial
}

Table audit_log {
  id              uuid              [pk]
  actor_type      varchar(40)       [not null, note: 'user | admin_user | service | system | device']
  actor_id        varchar(120)      [note: 'uuid string for user/admin; service name for service; null for system']
  action          varchar(80)       [not null, note: 'verb.noun convention, e.g. user.disable, device.transfer, content.publish']
  target_table    varchar(80)       [not null, note: 'destination table name; validated against allow-list at app layer']
  target_id       varchar(120)      [not null, note: 'string repr of pk (uuid or composite); polymorphic — no FK']
  result          audit_log_result  [not null]
  reason          text
  before_state    jsonb             [note: 'snapshot of mutated row pre-write; redacted PII per sys-11 §retention rules']
  after_state     jsonb             [note: 'snapshot post-write']
  metadata        jsonb             [not null, default: `'{}'::jsonb`]
  ip_address      varchar(45)
  user_agent      varchar(512)
  occurred_at     timestamptz       [not null, default: `now()`]
  created_at      timestamptz       [not null, default: `now()`]
  updated_at      timestamptz       [not null, default: `now()`, note: 'equal to created_at; row is immutable after insert']

  Indexes {
    (actor_type, actor_id, occurred_at) [name: 'idx_audit_log_actor_occurred_at', note: 'hot query: docs/sequences/12-admin/safety-investigation-w2.sequence.mmd — actor activity audit']
    (target_table, target_id) [name: 'idx_audit_log_target', note: 'hot query: docs/sequences/12-admin/safety-investigation-w2.sequence.mmd — per-record audit trail lookup across all services']
    (action, occurred_at) [name: 'idx_audit_log_action_occurred_at', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — recent privileged actions feed']
    (occurred_at) [name: 'idx_audit_log_occurred_at_desc', note: 'partial-index condition: occurred_at < now() - retention window (sweep)']
  }
}

// No Ref: lines — actor_id and target_id are polymorphic. Cross-domain integrity is
// validated at write time by the audit logger middleware (see sys-11 spec §audit logger).

// --- docs/erd/_shared/audit_logs.dbml ---
// audit_logs — cross-cutting structured event log for privileged domain actions.
// Note on @timescaledb-hypertable: this table is high-volume append-only (O(millions) rows/day);
// TimescaleDB hypertable partitioned by created_at, 7-day chunks.
// Note: @timescaledb-hypertable(column=created_at, interval='7d')
//
// Distinct from audit_log (_shared/audit_log.dbml):
//   audit_log — platform-wide mutation ledger (actor+target+action, polymorphic target, sys-11/sys-12)
//   audit_logs — structured domain-event log (typed actor, event_type vocab, subject polymorphic,
//                request context — designed for parent-gate, sub mutations, entitlement grants,
//                account-delete compliance audit per sys-11 telemetry-audit-cost).
//
// Rows are immutable after insert — updated_at is always equal to created_at.
// No FK on actor_user_id: audit rows MUST survive user hard-delete (compliance retention mode).

enum audit_actor_type {
  parent
  system
  cron
  admin
  support
}

Table audit_logs {
  id                uuid             [pk, note: 'service-generated; never serial']
  actor_user_id     uuid             [note: 'NULL for system/cron actors; UUID of parent, admin, or support user otherwise. NOT FK-constrained — audit row must survive user deletion']
  actor_session_jti uuid             [note: 'JWT JTI of the auth session that generated this event; NULL for system/cron']
  actor_type        audit_actor_type [not null]
  event_type        varchar(64)      [not null, note: 'dot-delimited verb.noun — e.g. parent.auth.success, subscription.canceled, account.deletion.requested']
  subject_type      varchar(64)      [note: 'optional — target entity table name — e.g. users, subscriptions, children']
  subject_id        uuid             [note: 'optional — PK of the subject entity; polymorphic; NOT FK-constrained']
  payload           jsonb            [note: 'event-specific structured payload; shape documented per event_type in sys-11 spec']
  ip                inet             [note: 'client IP; NULL for system/cron actors']
  user_agent        text             [note: 'raw User-Agent; NULL for system/cron actors']
  request_id        varchar(64)      [note: 'upstream request correlation ID (X-Request-Id header); NULL for async/cron events']
  created_at        timestamptz      [not null, default: `now()`]
  updated_at        timestamptz      [not null, default: `now()`, note: 'always equal to created_at — rows are immutable after insert']

  Indexes {
    (actor_user_id, created_at) [name: 'idx_audit_logs_actor_user_created', note: 'hot query: docs/sequences/07-parent/parent-gate-validate.sequence.mmd — actor activity lookup; WHERE actor_user_id IS NOT NULL enforced at app layer']
    (event_type, created_at) [name: 'idx_audit_logs_event_type_created', note: 'hot query: docs/sequences/11-telemetry/audit-log-write-path.sequence.mmd — compliance export by event type + time range']
    (subject_type, subject_id) [name: 'idx_audit_logs_subject', note: 'hot query: docs/sequences/01-identity/account-delete.sequence.mmd — all events for a subject during deletion audit; WHERE subject_id IS NOT NULL enforced in migration partial index']
  }
}

// No Ref: lines — actor_user_id and subject_id are intentionally not FK-constrained.
// Rationale: audit rows must outlive the user and subject rows in compliance-retention mode.
// Cross-domain integrity is validated at write time by the audit middleware (event_type allow-list).

// --- docs/erd/_shared/feature_flags.dbml ---
// feature_flags — platform-wide config gates.
// Distinct from sys-08 config_documents: config_documents are versioned cohort-scoped
// device configs; feature_flags are simple key→value toggles consumed by every service.

enum feature_flag_scope {
  global
  household
  user
  device
  cohort
}

enum feature_flag_value_kind {
  bool
  string
  number
  json
}

Table feature_flags {
  id              uuid                          [pk]
  key             varchar(120)                  [not null, note: 'dotted-namespace identifier, e.g. mobile.summary.weekly.enabled']
  scope           feature_flag_scope            [not null, default: 'global']
  scope_target_id varchar(120)                  [note: 'when scope != global: household_id / user_id / device_id / cohort slug']
  value_kind      feature_flag_value_kind       [not null]
  value           jsonb                         [not null, note: 'jsonb-wrapped to support all kinds; bool/string/number stored as the JSON primitive']
  description     text
  enabled_at      timestamptz
  disabled_at     timestamptz
  created_at      timestamptz                   [not null, default: `now()`]
  updated_at      timestamptz                   [not null, default: `now()`]

  Indexes {
    (key, scope, scope_target_id) [unique, name: 'idx_feature_flags_key_scope_target_unique', note: 'hot query: every flag read does point-lookup by (key, scope, target)']
    (key, scope) [name: 'idx_feature_flags_key_scope', note: 'hot query: docs/sequences/_cross/config-propagation-controls-to-device.sequence.mmd — admin list overrides for a flag across all targets']
  }
}

// No Ref: lines — scope_target_id is polymorphic (household / user / device / cohort).

// --- docs/erd/_shared/i18n_strings.dbml ---
// i18n_strings — backend-served translation table (per plan §3 Q-8 default: backend-served).
// Bundled string assets on mobile/device are separate; this table covers strings the backend
// emits (email templates, notification bodies, fallback voice phrases, etc.).

Table i18n_strings {
  id              uuid              [pk]
  key             varchar(160)      [not null, note: 'dotted-namespace, e.g. email.password_reset.subject']
  locale          varchar(16)       [not null, note: 'BCP-47 tag, e.g. en-US, vi-VN, ja-JP']
  value           text              [not null]
  context         varchar(240)      [note: 'translator-facing description / variable substitutions']
  source          varchar(40)       [not null, default: 'manual', note: 'manual | machine | crowdsource']
  reviewed        boolean           [not null, default: false]
  reviewed_by     varchar(120)
  reviewed_at     timestamptz
  created_at      timestamptz       [not null, default: `now()`]
  updated_at      timestamptz       [not null, default: `now()`]

  Indexes {
    (key, locale) [unique, name: 'idx_i18n_strings_key_locale_unique', note: 'hot query: per-locale lookup at render time']
    (locale, reviewed) [name: 'idx_i18n_strings_locale_reviewed', note: 'hot query: docs/sequences/10-notifications/sqs-worker-pipeline.sequence.mmd — admin review queue + render-time fallback chain']
  }
}

// --- docs/erd/_shared/idempotency_keys.dbml ---
// idempotency_keys — platform-wide request idempotency dedup.
// Per plan §3 Q-5: promoted to _shared/ (was originally listed under 17-gateway).
// Every service that accepts client-supplied X-Request-Id reads + writes here.

enum idempotency_key_status {
  in_flight
  succeeded
  failed
}

Table idempotency_keys {
  id              uuid                       [pk]
  request_key     varchar(120)               [not null, note: 'client-supplied X-Request-Id; scoped by service for collision avoidance']
  service_name    varchar(64)                [not null, note: 'owning service writing this row, e.g. IdentityService, BillingService']
  endpoint        varchar(160)               [not null, note: 'logical endpoint slug, e.g. POST_/v1/auth/signup']
  actor_type      varchar(40)
  actor_id        varchar(120)
  status          idempotency_key_status     [not null, default: 'in_flight']
  response_status integer                    [note: 'HTTP status of stored response (only set when status = succeeded | failed)']
  response_body   jsonb                      [note: 'cached response body for replay; redacted per service convention']
  expires_at      timestamptz                [not null, note: 'cleanup boundary — typically created_at + 24h']
  completed_at    timestamptz
  created_at      timestamptz                [not null, default: `now()`]
  updated_at      timestamptz                [not null, default: `now()`]

  Indexes {
    (service_name, request_key) [unique, name: 'idx_idempotency_keys_service_request_unique', note: 'hot query: every idempotent endpoint reads by (service, key) on entry']
    (expires_at) [name: 'idx_idempotency_keys_expires_at', note: 'partial-index condition: status != in_flight (sweep)']
  }
}

// No Ref: lines — actor_id is polymorphic (user / admin / device / service).

// --- docs/erd/_shared/media_assets.dbml ---
// media_assets — hybrid DB row + S3 URI for every binary asset surfaced by the platform.
// Per plan §3 Q-10 default: DB row + S3 URI (needed for moderation + cache invalidation).
// Consumed by sys-06 content (courses/lessons/activities media), sys-20 authoring (drafts),
// sys-09 OTA (release artefacts cross-reference for telemetry), sys-22 demo.

enum media_asset_kind {
  audio
  image
  video
  pdf
  json
  ota_image
  voice_phrase
  thumbnail
  cover_art
}

enum media_asset_status {
  uploading
  active
  archived
  deleted
}

Table media_assets {
  id              uuid                  [pk]
  kind            media_asset_kind      [not null]
  status          media_asset_status    [not null, default: 'uploading']
  s3_uri          varchar(2048)         [not null, note: 's3://bucket/key — bucket policy declares lifecycle']
  cdn_url         varchar(2048)         [note: 'CloudFront URL when served publicly']
  content_type    varchar(120)          [not null, note: 'MIME, e.g. audio/mp4, image/png']
  size_bytes      bigint                [not null]
  checksum_sha256 varchar(64)           [not null, note: 'hex-encoded; verified at upload and read']
  duration_ms     integer               [note: 'audio/video only']
  width_px        integer               [note: 'image/video only']
  height_px       integer               [note: 'image/video only']
  owner_service   varchar(64)           [not null, note: 'service that created the asset; rules vary by kind']
  metadata        jsonb                 [not null, default: `'{}'::jsonb`]
  moderation_state varchar(32)          [note: 'pending | approved | rejected — populated by sys-05 ModerationWorker for user-supplied media']
  expires_at      timestamptz           [note: 'TTL for ephemeral assets (e.g. phrase cache)']
  created_at      timestamptz           [not null, default: `now()`]
  updated_at      timestamptz           [not null, default: `now()`]
  archived_at     timestamptz
  deleted_at      timestamptz

  Indexes {
    (checksum_sha256) [name: 'idx_media_assets_checksum', note: 'hot query: content-addressed dedup at upload time']
    (kind, status) [name: 'idx_media_assets_kind_status', note: 'hot query: docs/sequences/06-content/content-pack-publish.sequence.mmd — per-kind admin listing of active assets']
    (owner_service, created_at) [name: 'idx_media_assets_owner_service_created_at', note: 'hot query: docs/sequences/14-retention/cron-job-base-execution.sequence.mmd — per-service inventory + retention sweep']
  }
}

// --- docs/erd/_shared/outbox_events.dbml ---
// outbox_events — transactional outbox for eventually-consistent cross-service fanout.
// Used by sys-04 (session events), sys-05 (safety_event_fanout), sys-07 (parent notifications),
// sys-10 (notification dispatches), sys-14 (deletion job triggers), sys-19 (billing webhooks).

enum outbox_event_status {
  pending
  delivering
  delivered
  failed
  dead_lettered
}

Table outbox_events {
  id                  uuid                    [pk]
  topic               varchar(80)             [not null, note: 'logical event topic, e.g. safety.event.published, billing.subscription.changed']
  payload             jsonb                   [not null, note: 'event body — schema documented per topic in producing service spec']
  source_service      varchar(64)             [not null, note: 'service that wrote the row']
  source_table        varchar(80)             [note: 'optional: row that motivated the event (target_table semantics, polymorphic)']
  source_id           varchar(120)            [note: 'optional pk of the source row']
  aggregate_id        varchar(120)            [note: 'used for partitioned/ordered delivery, e.g. session_id, household_id']
  status              outbox_event_status     [not null, default: 'pending']
  attempt_count       integer                 [not null, default: 0]
  next_attempt_at     timestamptz             [not null, default: `now()`]
  last_error          text
  delivered_at        timestamptz
  created_at          timestamptz             [not null, default: `now()`]
  updated_at          timestamptz             [not null, default: `now()`]

  Indexes {
    (status, next_attempt_at) [name: 'idx_outbox_events_status_next_attempt_at', note: 'hot query: docs/sequences/_cross/safety-event-fanout.sequence.mmd — relay worker poll']
    (topic, created_at) [name: 'idx_outbox_events_topic_created_at', note: 'hot query: docs/sequences/_cross/safety-event-fanout.sequence.mmd — per-topic backlog / observability dashboards']
    (aggregate_id, created_at) [name: 'idx_outbox_events_aggregate_created_at', note: 'hot query: docs/sequences/_cross/billing-entitlement-session-start.sequence.mmd — per-aggregate ordering audit (subscription_id, session_id)']
  }
}

