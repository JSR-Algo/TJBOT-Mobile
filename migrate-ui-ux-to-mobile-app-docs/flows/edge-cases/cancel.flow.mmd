%% HAND-CURATED.
%% Edge-case template: multi-step flow cancellation.
%% Used by: lesson-session (exit_confirm), purchase (pr_checkout cancel),
%% device (dv_pair_* cancel). Pattern: cancel → confirm sheet → restore caller.
flowchart TD
  classDef edge fill:#fee2e2,stroke:#991b1b

  in_flight(["caller_state (mid-multi-step flow)"])
  in_flight -->|user taps Cancel / X / back| confirm(["confirm_cancel sheet"]):::edge
  confirm -->|"Yes, exit"| restored["caller_entry_state (restored)"]
  confirm -->|"Keep going"| in_flight
