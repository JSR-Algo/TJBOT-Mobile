actors: [ParentApp, Gateway, IdentityService, PostgreSQL]
apis:
  - POST /v1/identity/coppa-consent
  - POST /v1/identity/children
externals: []
queues: []
failure_paths:
  - parent_jwt_stale
  - missing_coppa_consent
  - nickname_collision_in_household
  - age_band_invalid
  - hard_cap_reached
idempotency: X-Request-Id 24h dedup; (household_id, nickname) unique check server-side
retry: single retry on 5xx; never retry on 4xx (validation is deterministic)
