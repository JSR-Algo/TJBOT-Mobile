actors: [Device, RealtimeService, ConfigService]
apis:
  - GET /v1/realtime/connect
  - POST /v1/devices/heartbeat
externals: []
queues: []
failure_paths:
  - ws_connect_failure
  - heartbeat_failure_persistent
  - offline_manifest_expired
  - no_valid_manifest
