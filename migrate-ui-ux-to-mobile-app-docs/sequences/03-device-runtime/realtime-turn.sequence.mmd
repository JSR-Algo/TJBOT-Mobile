actors: [Device, RealtimeService]
apis:
  - GET /v1/realtime/connect
externals: []
queues: []
failure_paths:
  - listening_timeout
  - session_first_chunk_timeout
  - barge_in_triggered
  - chunkSeq_out_of_order
  - duplicate_chunk
idempotency: per-session sessionId; chunkSeq strictly increasing per session; duplicate tts.chunk ignored if checksum seen
