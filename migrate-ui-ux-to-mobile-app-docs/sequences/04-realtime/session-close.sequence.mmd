%% HAND-CURATED — sys-04 §11 state machine timeouts + §6 SESSION_CLOSE semantics.
sequenceDiagram
    autonumber
    participant Device
    participant Orchestrator
    participant Redis
    participant PostgreSQL

    alt idle_timeout
        Note over Orchestrator: OPEN idle 60s — close with timeout
        Orchestrator-->>Device: SESSION_CLOSE (0x70) end_reason=timeout
    else turn_limit_reached
        Note over Orchestrator: turn_count >= 60 — close with complete
        Orchestrator-->>Device: SESSION_CLOSE (0x70) end_reason=complete
    else cost_limit_reached
        Note over Orchestrator: cost >= $0.12 — close with cost_limit
        Orchestrator-->>Device: SESSION_CLOSE (0x70) end_reason=cost_limit
    else duration_limit_reached
        Note over Orchestrator: total duration >= 30 min — close with timeout
        Orchestrator-->>Device: SESSION_CLOSE (0x70) end_reason=timeout
    else admin_terminate
        Note over Orchestrator: POST /v1/admin/sessions/:sessionId/terminate
        Orchestrator-->>Device: SESSION_CLOSE (0x70) end_reason=error
    else device_initiated
        Device->>Orchestrator: SESSION_CLOSE (0x70)
    end
    Orchestrator->>Orchestrator: cancel in-flight LLM and TTS calls
    Orchestrator->>PostgreSQL: UPDATE sessions SET end_reason, ended_at
    Orchestrator->>Redis: DEL device_session:{deviceId}
    Orchestrator-)Orchestrator: emit tbot-session-completed SessionCompletedEvent
    Orchestrator-->>Device: SESSION_CLOSE_ACK (0x71)
    Note over Device,Orchestrator: WS close — CLOSING force-closes after 5s — telemetry flushed before ack
