surface: internal-RPC
spec_anchor: /software/systems/05-conversation-intelligence-and-safety#output-safety-filter
actors: [SafetyService, BlocklistCache, FallbackTemplateStore]
apis: []
externals: []
queues:
  - tjbot-safety-event
failure_paths:
  - hard_block_blocklist_or_pii_or_fear
  - rewrite_attempt_still_unsafe
  - response_too_long_after_truncate
  - final_gate_invalid_schema
idempotency: idempotent per (turnId, attempt_index) — re-running yields the same decision
