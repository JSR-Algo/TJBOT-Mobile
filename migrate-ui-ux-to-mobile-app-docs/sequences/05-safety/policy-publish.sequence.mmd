actors: [AdminConsole, SafetyService, PostgreSQL, Redis, RedTeamRunner]
apis:
  - POST /internal/v1/admin/safety-policies
  - POST /internal/v1/admin/blocklists
  - POST /internal/v1/admin/prompts
  - POST /internal/v1/admin/fallback-templates
externals: [Redis]
queues:
  - conv-policy-publish
failure_paths:
  - rbac_denied
  - regex_compile_failed
  - regex_catastrophic_backtracking
  - safe_word_false_positive
  - red_team_regression
idempotency: version-monotonic — duplicate publish for same version rejected; admin publish events emit conv-policy-publish exactly once
