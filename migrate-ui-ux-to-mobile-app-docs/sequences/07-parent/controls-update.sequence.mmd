actors: [ParentApp, Gateway, ControlsService, PostgreSQL, ConfigService]
apis:
  - PUT /v1/controls/:deviceId
  - GET /v1/controls/:deviceId
externals: []
queues: []
failure_paths:
  - unauthorized
  - insufficient_role
  - device_not_found
  - invalid_daily_limit
  - invalid_per_session_limit
  - invalid_quiet_hours
  - version_conflict
  - rate_limited
  - config_service_failure
