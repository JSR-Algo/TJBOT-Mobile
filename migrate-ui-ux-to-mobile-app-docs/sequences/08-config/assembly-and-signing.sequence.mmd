actors: [TriggerSource, ConfigAssembler, CohortResolver, SchemaTransformer, ConfigSigner, KMS, PostgreSQL]
apis: []
externals: [KMS]
queues: []
failure_paths:
  - config_size_exceeds_8kb
  - cohort_resolution_failure
  - kms_signing_failure
  - schema_transform_missing
  - validation_failed
idempotency: device_configs PK on device_id (1:1) — overwrite with version bump; immutable history append
retry: 3 retries with exponential backoff on KMS transient errors
