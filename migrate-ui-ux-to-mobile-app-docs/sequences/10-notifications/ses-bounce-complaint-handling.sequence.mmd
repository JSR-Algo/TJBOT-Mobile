%% HAND-CURATED. SES bounce/complaint webhook fan-in path.
sequenceDiagram
    autonumber
    participant SES
    participant SNS
    participant NotificationService
    participant PostgreSQL

    SES-)SNS: publish bounce / complaint / delivery event
    SNS->>NotificationService: POST /webhooks/ses-events (signed)
    NotificationService->>NotificationService: verify SNS signature
    alt invalid_sns_signature
        NotificationService-->>SNS: 401 invalid_signature
    else valid
        NotificationService->>PostgreSQL: SELECT notification by ses_message_id
        alt unknown_notification_id
            PostgreSQL-->>NotificationService: 0 rows
            NotificationService-->>SNS: 200 OK (logged, dropped)
        else duplicate_event
            PostgreSQL-->>NotificationService: event_id already recorded
            NotificationService-->>SNS: 200 OK (idempotent)
        else hard_bounce
            NotificationService->>PostgreSQL: UPDATE parents SET email_disabled_reason,hard_bounce
            NotificationService->>PostgreSQL: UPDATE notifications SET status,bounced
            NotificationService-->>SNS: 200 OK
        else complaint
            NotificationService->>PostgreSQL: UPDATE parents SET email_disabled_reason,complaint
            NotificationService-->>SNS: 200 OK
            Note over NotificationService,PostgreSQL: transactional_email_override — password_reset still permitted post-flag (security-critical)
        else delivery
            NotificationService->>PostgreSQL: UPDATE notifications SET status,delivered
            NotificationService-->>SNS: 200 OK
        end
    end
