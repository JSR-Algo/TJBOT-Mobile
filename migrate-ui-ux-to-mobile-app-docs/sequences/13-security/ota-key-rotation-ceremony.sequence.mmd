actors: [SecurityEngineerOne, SecurityEngineerTwo, AirGappedWorkstation, YubiHSM, KMS, OtaService, FleetDevices, PostgreSQL]
apis: []
externals: [KMS, YubiHSM]
queues: []
failure_paths:
  - backup_key_missing
  - hsm_seal_check_failed
  - kms_import_failed
  - fleet_adoption_below_threshold
  - rotation_failed_rollback
idempotency: key_rotation_log is immutable append; ceremony status enforces explicit start_at + co-sign
