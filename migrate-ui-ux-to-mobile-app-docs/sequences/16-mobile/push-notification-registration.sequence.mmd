system: sys-16-parent-mobile-application
flow_id: push-notification-registration
surface: mobile
spec_anchor: /software/systems/16-parent-mobile-application#push-notification-handling
actors: [ParentApp, OS, FCM, Gateway, NotificationService]
apis:
  - POST /v1/notifications/push-token
externals: [FCM]
queues: []
failure_paths:
  - os_permission_denied
  - fcm_token_unavailable
  - push_token_rate_limited
  - register_token_failed
idempotency: server-side dedup by (parent_id, fcm_token, platform) — re-registration is upsert; rate-limited at 10 per hour per parent
retry: caller-side single retry on 5xx with 30s backoff — onTokenRefresh re-runs registration whenever FCM rotates the token
timeout: 10s p99
status: final
