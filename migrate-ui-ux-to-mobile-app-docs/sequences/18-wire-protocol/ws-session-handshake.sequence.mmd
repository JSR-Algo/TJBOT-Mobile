system: sys-18-wire-protocol-domain-types
flow_id: ws-session-handshake
surface: device
spec_anchor: /software/systems/18-wire-protocol-domain-types#5-4-connection-handshake
actors: [Device, RealtimeService]
apis:
  - GET /v1/realtime/connect
externals: []
queues: []
failure_paths:
  - invalid_session_token
  - device_inactive
  - concurrent_session_exists
  - service_at_capacity
  - rate_limit_exceeded
  - protocol_version_unsupported
idempotency: device_session_id supplied by device on SESSION_OPEN — sequence_id monotonic per connection — reconnection within 10s with same device_session_id resumes from OPEN
retry: device backs off on 503/429 — no server-side replay
timeout: handshake budget 5s
status: final
