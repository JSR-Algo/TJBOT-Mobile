%% HAND-CURATED. Entitlement read on the session-start critical path. Service-token JWT (audience tbot:service). When turnsRemaining/sessionsRemaining == 0, sys-04 refuses session.start.
sequenceDiagram
    autonumber
    participant RealtimeService
    participant Gateway
    participant BillingService
    participant Redis

    RealtimeService->>Gateway: GET /internal/v1/entitlements/:householdId and service-token Bearer
    Gateway->>Gateway: auth-resolver — JWT audience: tbot:service (sys-17)
    alt service_token_invalid
        Gateway-->>RealtimeService: 401 invalid_token
    else authenticated
        Gateway->>BillingService: forward
        BillingService->>Redis: GET entitlements:{householdId}
        alt cache hit
            Redis-->>BillingService: {tier, dailyTurnLimit, dailySessionLimit, maxChildProfiles, features, ...}
        else cache miss
            Redis-->>BillingService: nil
            BillingService->>BillingService: resolve from billing.entitlements and households.subscription_status (see Entitlement Resolution Logic)
            alt household_not_found
                BillingService-->>Gateway: 404 household_not_found
                Gateway-->>RealtimeService: 404
            else entitlement_cache_miss_db_unavailable
                BillingService-->>Gateway: 503 entitlement_resolution_unavailable
                Gateway-->>RealtimeService: 503
            else resolved
                BillingService->>Redis: SETEX entitlements:{householdId} (cache for TTL)
            end
        end
        BillingService->>Redis: GET usage:{householdId}:{today}:turns and :sessions
        Redis-->>BillingService: {turnCount, sessionCount}
        BillingService->>BillingService: compute turnsRemaining = dailyTurnLimit == -1 ? -1 : max(0, dailyTurnLimit - turnCount)
        alt daily_session_limit_reached
            Note over BillingService: sessionsRemaining == 0 — sys-04 will refuse session.start
            BillingService-->>Gateway: 200 {tier, turnsRemaining, sessionsRemaining: 0, ...}
            Gateway-->>RealtimeService: 200 — caller blocks session
        else daily_turn_limit_reached
            Note over BillingService: turnsRemaining == 0 — sys-04 will refuse session.start
            BillingService-->>Gateway: 200 {tier, turnsRemaining: 0, sessionsRemaining, ...}
            Gateway-->>RealtimeService: 200 — caller blocks session
        else within limits
            BillingService-->>Gateway: 200 {tier, turnsRemaining, sessionsRemaining, features, ...}
            Gateway-->>RealtimeService: 200 — caller proceeds to session.start
        end
    end

    Note over RealtimeService,Redis: p99 <10ms — Redis warm path <2ms — entitlement re-checked mid-turn on cache invalidation broadcast from webhook worker
