flow_id: entitlement-check-session-start
surface: internal-RPC
spec_anchor: /software/systems/19-billing-subscription#internal-entitlement-endpoint
actors: [RealtimeService, Gateway, BillingService, Redis]
apis:
  - GET /internal/v1/entitlements/:householdId
externals: []
queues: []
failure_paths:
  - household_not_found
  - entitlement_cache_miss_db_unavailable
  - daily_turn_limit_reached
  - daily_session_limit_reached
  - service_token_invalid
idempotency: read-only endpoint — safe to call repeatedly; Redis cache key entitlements:{householdId} authoritative within TTL
retry: caller-side single retry on 5xx with 100ms backoff — must NOT block session-start beyond 50ms total (p99 budget 10ms cold, <2ms warm cache)
timeout: p99 <10ms (critical path — sys-04 calls before every session.start)
status: final
