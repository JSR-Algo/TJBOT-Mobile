actors: [Device, DemoStateMachine, FlashPartition, NVS, AudioPlayer]
apis: []
externals: []
queues: []
failure_paths:
  - demo_content_missing
  - demo_content_corrupt
  - demo_audio_missing
  - demo_servo_stall
  - proximity_false_trigger
  - battery_critical
idempotency: state machine drives retail loop deterministically; analytics ring buffer wraps at 64 events
retry: cooldown returns to ATTRACT after script complete or timeout; max consecutive interactions 10 before forced reset
