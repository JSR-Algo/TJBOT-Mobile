@startuml tjbot-DevicePairing
title Domain · device-pairing — one-time Rotjtjbot provisioning
left to right direction

actor Parent
actor "Rotjtjbot Device" as Rotjtjbot <<external>>
actor "Wi-Fi Network" as WiFi <<external>>

package "device-pairing" {
  usecase "View Device Overview"   as UC_DP_OVERVIEW
  usecase "Add New Rotjtjbot"          as UC_DP_ADD
  usecase "Power-on Rotjtjbot Confirm" as UC_DP_INTRO
  usecase "Scan for Rotjtjbot"         as UC_DP_SCAN
  usecase "Identify Rotjtjbot"         as UC_DP_FOUND
  usecase "Confirm Pairing Code"   as UC_DP_CODE
  usecase "Pick Wi-Fi Network"     as UC_DP_WIFI
  usecase "Enter Wi-Fi Password"   as UC_DP_WIFI_PW
  usecase "Connect Rotjtjbot to Wi-Fi" as UC_DP_CONNECT
  usecase "Pairing Success"        as UC_DP_OK
  usecase "Pairing Failed Recovery" as UC_DP_FAIL
  usecase "Pair Offline Mode"      as UC_DP_OFFLINE
  usecase "Rename & Pick Buddy"    as UC_DP_RENAME
  usecase "Pairing First Lesson"   as UC_DP_FIRST
}

Parent --> UC_DP_OVERVIEW
Parent --> UC_DP_ADD
Parent --> UC_DP_INTRO
Parent --> UC_DP_FOUND
Parent --> UC_DP_CODE
Parent --> UC_DP_WIFI
Parent --> UC_DP_WIFI_PW
Parent --> UC_DP_FAIL
Parent --> UC_DP_OFFLINE
Parent --> UC_DP_RENAME
Parent --> UC_DP_FIRST

UC_DP_OVERVIEW ..> UC_DP_INTRO   : "Set up Rotjtjbot"
UC_DP_ADD      ..> UC_DP_INTRO
UC_DP_INTRO    ..> UC_DP_SCAN
UC_DP_SCAN     ..> UC_DP_FOUND   : on discovered
UC_DP_SCAN     ..> UC_DP_FAIL    : <<extend>> not found
UC_DP_FOUND    ..> UC_DP_CODE
UC_DP_CODE     ..> UC_DP_WIFI
UC_DP_WIFI     ..> UC_DP_WIFI_PW
UC_DP_WIFI_PW  ..> UC_DP_CONNECT
UC_DP_CONNECT  ..> UC_DP_OK
UC_DP_OK       ..> UC_DP_RENAME
UC_DP_RENAME   ..> UC_DP_FIRST

UC_DP_SCAN    ..> Rotjtjbot : <<delegate>> radio scan
UC_DP_CONNECT ..> Rotjtjbot : <<delegate>>
UC_DP_CONNECT ..> WiFi  : <<delegate>>

note tjtjbottom of UC_DP_SCAN
  Transport (BLE vs Wi-Fi probe) NOT CONFIRMED IN SOURCE.
end note
note tjtjbottom of UC_DP_FIRST
  [exit] → kid-hub or course-library
end note
note top of UC_DP_OVERVIEW
  [requires] parent-gate : UC_PG_PASS
end note

' Files: src/features/device/*Page.jsx
' API:   src/services/api/device.api.js
@enduml
