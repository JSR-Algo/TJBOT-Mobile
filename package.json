{
  "name": "TJBot-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/runtime/mobile-run.mjs start",
    "start:reset": "node scripts/runtime/mobile-run.mjs start-reset",
    "android": "node scripts/runtime/mobile-run.mjs android",
    "ios": "node scripts/runtime/mobile-run.mjs ios",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ --max-warnings=0",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:integration:rewards:live": "jest --config tests/integration/rewards-live/jest.config.js --runInBand",
    "test:rewards-runner": "node --test --test-concurrency=1 tests/scripts/rewards-jest-process-lifecycle.test.mjs tests/scripts/rewards-live-cross-platform-lifecycle.test.mjs tests/scripts/rewards-live-process-lifecycle.test.mjs",
    "test:e2e:rewards:live": "node scripts/run-rewards-live-e2e.mjs",
    "test:state-machines": "jest --selectProjects unit --testPathPattern='tests/state/machines'",
    "test:navigation": "jest --selectProjects unit --testPathPattern='tests/navigation'",
    "test:screens": "jest --selectProjects unit --testPathPattern='tests/(screens|features)'",
    "api:contract-sync:check": "node scripts/check-api-contract-sync.mjs",
    "build:android": "node scripts/runtime/mobile-run.mjs build-android",
    "build:ios": "node scripts/runtime/mobile-run.mjs build-ios",
    "release:ios:testflight": "bundle exec fastlane ios beta_ios",
    "pods:ios": "node scripts/runtime/mobile-run.mjs pods",
    "runtime:doctor": "node scripts/runtime/mobile-run.mjs doctor",
    "e2e:mobile": "node scripts/e2e-mobile.js",
    "e2e:mobile:local": "TBOT_API_URL=http://localhost:3000 node scripts/e2e-mobile.js",
    "smoke:provisioning:ios": "node scripts/physical-provisioning-smoke.mjs --platform=ios",
    "smoke:provisioning:android": "node scripts/physical-provisioning-smoke.mjs --platform=android",
    "smoke:provisioning:both": "node scripts/physical-provisioning-smoke.mjs --platform=both",
    "detox:build:ios": "node scripts/runtime/mobile-run.mjs detox-build-ios",
    "detox:test:ios": "node scripts/runtime/mobile-run.mjs detox-test-ios",
    "detox:build:android": "node scripts/runtime/mobile-run.mjs detox-build-android",
    "detox:test:android": "node scripts/runtime/mobile-run.mjs detox-test-android",
    "postinstall": "patch-package",
    "i18n:scan": "node scripts/i18n/scan-hardcoded.mjs",
    "i18n:parity": "node scripts/i18n/check-key-parity.mjs",
    "i18n:bundle": "node scripts/i18n/build-locales-bundle.mjs",
    "i18n:bundle:check": "node scripts/i18n/check-bundle-freshness.mjs",
    "i18n:check": "npm run i18n:scan && npm run i18n:parity && npm run i18n:bundle:check",
    "flows:extract": "node scripts/flows/extract-go-calls.mjs",
    "flows:validate": "node scripts/flows/validate-go-calls.mjs",
    "flows:generate": "node scripts/flows/generate-domain-flows.mjs",
    "flows:render": "node scripts/flows/render-html.mjs",
    "flows:fast": "npm run flows:extract && npm run flows:generate && npm run flows:validate",
    "flows:all": "npm run flows:fast && npm run flows:render",
    "sequences:validate": "node scripts/sequences/validate-sequences.mjs",
    "sequences:validate-mermaid": "node scripts/sequences/validate-mermaid.mjs",
    "sequences:index": "node scripts/sequences/build-index.mjs",
    "sequences:fast": "npm run sequences:validate && npm run sequences:validate-mermaid && npm run sequences:index -- --check",
    "sequences:surface-check": "node scripts/sequences/lib/per-surface-count.mjs",
    "erd:fast": "node scripts/erd/validate-erd.mjs",
    "erd:full": "node scripts/erd/validate-erd.mjs && node scripts/erd/build-global-erd.mjs && node scripts/erd/dbml-to-mermaid.mjs",
    "erd:validate": "node scripts/erd/validate-erd.mjs",
    "usecases:check": "node scripts/usecases/check-uc-sections.mjs && node scripts/usecases/check-index-coverage.mjs && node scripts/usecases/check-lane-coverage.mjs && node scripts/usecases/check-edge-case-enum.mjs && node scripts/usecases/check-backend-sentinel.mjs",
    "check:route-coverage": "node scripts/check-route-coverage.mjs",
    "navigation:route-map": "node scripts/navigation/export-route-mapping.mjs",
    "navigation:tree": "node scripts/navigation/export-navigation-tree.mjs",
    "navigation:forward-edges": "node scripts/navigation/export-forward-edges.mjs",
    "check:screen-prop-types": "node scripts/check-screen-prop-types.mjs",
    "check:token-parity": "node scripts/check-token-parity.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@react-navigation/stack": "^7.8.9",
    "@tanstack/react-query": "^5.40.0",
    "@types/crypto-js": "^4.2.2",
    "@xstate/react": "^6.1.0",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "expo": "^55.0.11",
    "expo-audio": "~55.0.11",
    "expo-camera": "~55.0.0",
    "expo-crypto": "~55.0.16",
    "expo-device": "~55.0.12",
    "expo-haptics": "~55.0.11",
    "expo-notifications": "~55.0.16",
    "expo-secure-store": "~55.0.11",
    "i18next": "^23.11.5",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react-native": "^1.8.0",
    "patch-package": "8.0.1",
    "react": "19.2.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.83.4",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.7.2",
    "xstate": "^5.31.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@mermaid-js/parser": "^1.1.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.84.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "detox": "^20.29.3",
    "detox-cli": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^17.5.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.0",
    "mermaid": "^11.15.0",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "react-native",
        "setupFiles": [
          "<rootDir>/tests/setup.ts"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup-after-env.ts"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1",
          "expo-secure-store": "<rootDir>/tests/__mocks__/expo-secure-store.ts",
          "expo-av": "<rootDir>/tests/__mocks__/expo-av.ts",
          "expo-haptics": "<rootDir>/tests/__mocks__/expo-haptics.ts",
          "expo-audio": "<rootDir>/tests/__mocks__/expo-audio.ts",
          "expo-notifications": "<rootDir>/tests/__mocks__/expo-notifications.ts",
          "expo-device": "<rootDir>/tests/__mocks__/expo-device.ts",
          "expo-camera": "<rootDir>/tests/__mocks__/expo-camera.ts",
          "expo-crypto": "<rootDir>/tests/__mocks__/expo-crypto.ts",
          "react-native-get-random-values": "<rootDir>/tests/__mocks__/react-native-get-random-values.ts",
          "react-native-ble-plx": "<rootDir>/tests/__mocks__/react-native-ble-plx.ts"
        },
        "testMatch": [
          "<rootDir>/tests/**/*.test.{ts,tsx}"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/tests/integration/"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-screens|react-native-safe-area-context|react-native-gesture-handler|expo-secure-store|expo)/)"
        ]
      },
      {
        "displayName": "integration",
        "preset": "react-native",
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/tests/setup.ts"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup-after-env.ts"
        ],
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.{ts,tsx}"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/tests/integration/rewards-live/rewards-live-rendered.test.tsx"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/.worktrees/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-screens|react-native-safe-area-context|react-native-gesture-handler|expo-secure-store|expo)/)"
        ],
        "globalSetup": "<rootDir>/tests/integration/__setup__/global-setup.ts",
        "globalTeardown": "<rootDir>/tests/integration/__setup__/global-teardown.ts"
      }
    ],
    "collectCoverageFrom": [
      "src/**/*[Ll]esson*",
      "src/**/*[Cc]ourse*",
      "src/**/*[Pp]rogress*"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
