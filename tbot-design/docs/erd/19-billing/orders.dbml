// orders.dbml — one-time purchase or hardware bundle order (distinct from recurring subscriptions)

enum order_status {
  pending
  paid
  fulfilled
  canceled
  refunded
}

Table orders {
  id                  uuid          [pk, note: 'service-generated; never serial']
  household_id        uuid          [not null, note: 'cross-domain ref → IdentityService']
  stripe_customer_id  uuid          [not null, note: 'FK → stripe_customers.id']
  stripe_payment_intent_id varchar(255) [unique, note: 'Stripe PaymentIntent ID (pi_...)']
  status              order_status  [not null, default: 'pending']
  total_amount_cents  bigint        [not null, note: 'money: bigint cents only; sum of order_items']
  currency            varchar(3)    [not null, default: 'usd']
  fulfilled_at        timestamptz
  canceled_at         timestamptz
  refunded_at         timestamptz
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]

  Indexes {
    (household_id, status) [name: 'idx_orders_household_id_status', note: 'hot query: docs/sequences/19-billing/stripe-webhook-processing.sequence.mmd']
    (stripe_payment_intent_id) [unique, name: 'idx_orders_stripe_payment_intent_id_unique']
    (stripe_customer_id) [name: 'idx_orders_stripe_customer_id']
  }
}

Ref: orders.stripe_customer_id > stripe_customers.id
// Ref: orders.household_id > households.id    // cross-domain ref → IdentityService
