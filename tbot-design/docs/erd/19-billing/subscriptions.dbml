// subscriptions.dbml — recurring access entitlement per household

enum subscription_status {
  trialing
  active
  past_due
  canceled
  expired
}

Table subscriptions {
  id                    uuid                [pk, note: 'service-generated; never serial']
  household_id          uuid                [not null, note: 'cross-domain ref → IdentityService']
  stripe_customer_id    uuid                [not null, note: 'FK → stripe_customers.id']
  plan_id               uuid                [not null, note: 'FK → subscription_plans.id']
  stripe_subscription_id varchar(255)       [unique, note: 'Stripe Subscription object ID (sub_...) — null before first payment']
  status                subscription_status [not null, default: 'trialing']
  trial_ends_at         timestamptz
  current_period_start  timestamptz         [not null]
  current_period_end    timestamptz         [not null]
  canceled_at           timestamptz
  cancel_at_period_end  boolean             [not null, default: false]
  created_at            timestamptz         [not null, default: `now()`]
  updated_at            timestamptz         [not null, default: `now()`]

  Indexes {
    (household_id, status) [name: 'idx_subscriptions_household_id_status', note: 'hot query: docs/sequences/19-billing/entitlement-check-session-start.sequence.mmd']
    (stripe_subscription_id) [unique, name: 'idx_subscriptions_stripe_subscription_id_unique']
    (stripe_customer_id) [name: 'idx_subscriptions_stripe_customer_id']
  }
}

Ref: subscriptions.stripe_customer_id > stripe_customers.id
Ref: subscriptions.plan_id > subscription_plans.id
// Ref: subscriptions.household_id > households.id    // cross-domain ref → IdentityService
