flow_id: token-refresh
surface: mobile
spec_anchor: /software/systems/01-identity-household-access#4-4-post-v1authrefresh
actors: [ParentApp, Gateway, IdentityService]
apis:
  - POST /v1/auth/refresh
externals: []
queues: []
failure_paths:
  - invalid_refresh_token
  - refresh_replay_detected
  - auth_refresh_rate_limited
  - session_revoked
idempotency: refresh tokens are single-use — rotation is the idempotency boundary; old token stays valid 30s grace after rotation to absorb concurrent requests
