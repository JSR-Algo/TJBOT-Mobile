surface: internal-RPC
spec_anchor: /software/systems/06-content-and-personalization#post-internal-v1-content-select
actors: [SafetyService, ContentService, PostgreSQL, Redis]
apis:
  - POST /internal/v1/content/select
externals: [Redis]
queues:
  - cp-retrieval-analytics
failure_paths:
  - no_candidates_after_filter
  - exhaustion_recovery_required
  - parent_toggle_disabled_all
  - redis_unavailable_skip_cooldown
idempotency: per-turn selection — append-only delivery row prevents double-credit
retry: 0 — exhaustion recovery is in-band, not a retry
