%% DERIVED narrative — billing entitlement check at session.start across sys-04 and sys-19.
sequenceDiagram
    autonumber
    participant Device
    participant RealtimeService
    participant BillingService
    participant Redis
    participant Stripe

    Device->>RealtimeService: WS handshake — open session (sys-04 ws-handshake)
    RealtimeService->>BillingService: GET entitlement (household_id) — sys-19
    BillingService->>Redis: GET entitlement,household_id
    alt cache_hit_active
        Redis-->>BillingService: active + plan + expires_at
        BillingService-->>RealtimeService: 200 entitled
        RealtimeService-->>Device: WS open — session ready
    else cache_miss
        Redis-->>BillingService: nil
        BillingService->>Stripe: GET subscription (household_id)
        alt entitlement_cache_miss_stripe_unreachable
            Stripe--xBillingService: 5xx — fall back to last-known DB state
        else fetched
            Stripe-->>BillingService: subscription object
        end
        BillingService->>Redis: SETEX entitlement,household_id 60s
        alt subscription_expired
            BillingService-->>RealtimeService: 402 subscription_expired
            RealtimeService-->>Device: WS close 4002 entitlement_required
        else past_due_grace_period
            BillingService-->>RealtimeService: 200 entitled grace
            RealtimeService-->>Device: WS open + grace warning frame
        else active
            BillingService-->>RealtimeService: 200 entitled
            RealtimeService-->>Device: WS open
        end
    end

    Note over Device,Stripe: mid_turn_expiration — entitlement re-check on long sessions (>15 min) per sys-19 policy.
