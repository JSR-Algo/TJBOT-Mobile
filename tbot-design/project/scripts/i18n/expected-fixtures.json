{
  "note": "Per-screen jsdom fixtures. Each entry exercises a subtree the walker must translate. Lanes B/C/D add per-screen fixtures during Phase 2-7. Smoke fixtures below verify the runtime in isolation.",
  "fixtures": [
    {
      "name": "smoke-flat-string",
      "file": "smoke",
      "html": "<div data-persona='parent'><h1>Buy Robot</h1><p>Settings</p></div>",
      "expect": {
        "vi": ["Mua Robot", "Cài đặt"],
        "en": ["Buy Robot", "Settings"]
      }
    },
    {
      "name": "smoke-attribute-pass",
      "file": "smoke",
      "html": "<div data-persona='parent'><input id='ip' placeholder='Email' aria-label='Password' /></div>",
      "expect": { "vi": [], "en": [] },
      "expectAttrs": {
        "vi": [
          { "selector": "#ip", "attr": "placeholder", "value": "Email" },
          { "selector": "#ip", "attr": "aria-label", "value": "Mật khẩu" }
        ],
        "en": [
          { "selector": "#ip", "attr": "placeholder", "value": "Email" },
          { "selector": "#ip", "attr": "aria-label", "value": "Password" }
        ]
      }
    },
    {
      "name": "smoke-data-no-i18n",
      "file": "smoke",
      "html": "<div data-no-i18n><span>Settings</span></div><div data-persona='parent'><span>Settings</span></div>",
      "expect": {
        "vi": ["Cài đặt", "Settings"],
        "en": ["Settings"]
      }
    }
  ]
}
